<%
  const HERO = [
    { name: 'Bali', line: 'Kelingking Beach, Nusa Penida', photo: '/img/destinations/bali-kelingking-hero.jpg', focus: '96% 21%' },
    { name: 'Europe', line: 'Chapel Bridge, Lucerne', focus: '77% 16%' },
    { name: 'Dubai', line: 'Dubai by night', focus: '42% 39%' },
    { name: 'Vietnam', line: 'Ha Long Bay', focus: '59% 39%' },
    { name: 'Cambodia', line: 'Angkor Wat, Siem Reap', focus: '58% 22%' },
    { name: 'United Kingdom', line: 'Tower Bridge, London', photo: '/img/destinations/london-tower-bridge-hero.jpg', focus: '96% 18%' },
  ];
  const SVCS = [['hotels', 'Hotels'], ['flights', 'Airfares'], ['activities', 'Activities'], ['transfers', 'Transfers'], ['visas', 'Visas'], ['insurance', 'Travel insurance']];
  // Example trips for the margin calculator (illustrative net rates, 2 adults).
  const TRIPS = [
    { key: 'dubai', name: 'Dubai · 4 nights', lines: [['Delhi–Dubai return flights', 48000], ['Hotel, 4 nights', 24800], ['Desert safari + Burj Khalifa', 14600]] },
    { key: 'bali', name: 'Bali · 5 nights', lines: [['Mumbai–Bali return flights', 42000], ['Villa, 5 nights', 21500], ['Ubud day tour + Nusa Penida', 9800]] },
    { key: 'vietnam', name: 'Vietnam · 6 nights', lines: [['Delhi–Hanoi return flights', 38000], ['Hotels in Hanoi & Da Nang', 18400], ['Ha Long Bay cruise + Ba Na Hills', 12600]] },
  ];
  const inr = (n) => '₹' + Math.round(n).toLocaleString('en-IN');
  const t0 = TRIPS[0], net0 = t0.lines.reduce((s, l) => s + l[1], 0), m0 = 12;
  const home = user ? (user.role === 'admin' ? '/admin' : user.role === 'backend' ? '/backend' : '/agent') : null;
  const destLink = (name) => user && user.role !== 'agent' ? home : `/agent/find?svc=hotels&dest=${encodeURIComponent(name)}`;
  const D = Object.fromEntries(destinations.map((d) => [d.name, d]));
  const NOTE = {
    Dubai: 'Desert safaris, Burj Khalifa, Abu Dhabi day trips and city hotels.',
    Bali: 'Villas, Ubud and Nusa Penida tours, beach transfers.',
    Vietnam: 'Hanoi, Ha Long Bay cruises, Da Nang and Hoi An.',
    Cambodia: 'Angkor temples at Siem Reap and Phnom Penh.',
    'United Kingdom': 'London and Edinburgh, UK visitor visas.',
    Europe: 'Paris, the Swiss Alps, Italy, Amsterdam and Barcelona, Schengen visas.',
  };
  const order = ['Dubai', 'Bali', 'Vietnam', 'Europe', 'United Kingdom', 'Cambodia'].filter((n) => D[n]);
%>
<section class="v-hero" data-hero aria-labelledby="home-title">
  <div class="v-hero-frame">
    <div class="v-hero-backdrop" aria-hidden="true">
      <% HERO.forEach((h, i) => { const photo = h.photo || cover({ destination: h.name }); %>
        <img class="v-hero-slide<%= i === 0 ? ' on' : '' %>" style="--photo-focus: <%= h.focus %>" data-line="<%= h.line %>" data-dest="<%= h.name %>" alt="" <% if (i === 0) { %>src="<%= photo %>" fetchpriority="high"<% } else { %>data-src="<%= photo %>"<% } %> decoding="async">
      <% }) %>
    </div>
    <div class="v-wrap v-hero-grid">
      <div class="v-hero-copy">
        <p class="v-kicker">For travel agencies</p>
        <h1 id="home-title">Book travel<br>at agent rates.</h1>
        <p class="v-lead">Find hotels, airfares and experiences. Set your markup and sell under your agency’s name.</p>
        <div class="v-ctas">
          <% if (user) { %>
            <a class="v-btn v-btn-primary" href="<%= home %>">Open your portal</a>
          <% } else { %>
            <a class="v-btn v-btn-primary" href="/signup">Join VaayuTrip</a>
            <a class="v-btn v-btn-outline-light" href="/login">Log in</a>
          <% } %>
        </div>
      </div>
      <div class="v-hero-location">
        <p class="v-hero-cap"><%- icon('mapPin') %><span data-hero-line aria-live="polite"><%= HERO[0].line %></span></p>
        <div class="v-hero-choices" role="group" aria-label="Destination photos">
          <button type="button" data-photo-step="-1" aria-label="Previous destination photo"><%- icon('chevron') %></button>
          <button type="button" data-photo-step="1" aria-label="Next destination photo"><%- icon('chevron') %></button>
        </div>
      </div>
    </div>
  </div>

  <div class="v-wrap v-hero-booking">
    <form class="v-search" method="get" action="/agent/find" role="search" aria-label="Search net rates" <% if (!user) { %>aria-describedby="rates-access"<% } %>>
      <label class="v-search-f"><span>Destination</span>
        <select name="dest" data-hero-dest><% HERO.forEach(h => { %><option><%= h.name %></option><% }) %></select>
      </label>
      <label class="v-search-f"><span>Service</span>
        <select name="svc"><% SVCS.forEach(([v, l]) => { %><option value="<%= v %>"><%= l %></option><% }) %></select>
      </label>
      <button class="v-btn v-btn-teal" type="submit"><%- icon('search') %>Search net rates</button>
    </form>
    <% if (!user) { %><p class="v-search-note" id="rates-access"><%- icon('lock') %>Live rates are available to verified partners after login.</p><% } %>
  </div>
</section>

<section class="v-facts" aria-label="VaayuTrip at a glance">
  <div class="v-wrap v-facts-grid">
    <div><b><%= stats.hotels %></b><span>hotels at net rates</span></div>
    <div><b><%= stats.activities %></b><span>tours &amp; activities</span></div>
    <div><b><%= stats.cities %></b><span>cities in 6 destinations</span></div>
  </div>
</section>

<section class="v-sec" id="destinations">
  <div class="v-wrap">
    <div class="v-head v-head-split">
      <h2>Explore our destinations</h2>
      <p>Find hotels, flights, activities, transfers and visas at contracted net rates.</p>
    </div>
    <div class="v-dests">
      <% order.forEach(name => { const d = D[name]; %>
        <a class="v-dest" href="<%= destLink(name) %>">
          <img src="<%= cover({ destination: name }) %>" alt="" loading="lazy">
          <span class="v-dest-body">
            <span class="v-dest-top"><b><%= name %></b><small><%= d.items %> services</small></span>
            <span class="v-dest-note"><%= NOTE[name] %></span>
            <% if (d.cities.length && !(d.cities.length === 1 && d.cities[0] === name)) { %><span class="v-dest-cities"><% d.cities.slice(0, 4).forEach(c => { %><i><% if (cityThumbs[c]) { %><img src="<%= cityThumbs[c] %>" alt="" loading="lazy"><% } %><%= c %></i><% }) %><% if (d.cities.length > 4) { %><i>+<%= d.cities.length - 4 %></i><% } %></span><% } %>
          </span>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<% if (cityShots.length) { %>
<section class="v-cities" aria-labelledby="cities-h">
  <div class="v-wrap v-cities-head">
    <div>
      <h2 id="cities-h">City by city</h2>
      <p>Hotels, sightseeing and transfers in <%= cityShots.length %> cities across six destinations.</p>
    </div>
    <div class="v-rail-nav">
      <button type="button" class="v-rail-btn" data-rail-step="-1" aria-label="Previous cities"><%- icon('arrowLeft') %></button>
      <button type="button" class="v-rail-btn" data-rail-step="1" aria-label="Next cities"><%- icon('arrowRight') %></button>
    </div>
  </div>
  <div class="v-rail" data-rail tabindex="0" role="list" aria-label="Cities">
    <% cityShots.forEach((s) => { %>
      <a class="v-city" role="listitem" href="<%= user && user.role === 'agent' ? '/agent/hotels?city=' + encodeURIComponent(s.city) : '/signup' %>">
        <img src="<%= s.src %>" alt="<%= s.city %>" loading="lazy" width="640" height="480">
        <span><b><%= s.city %></b><small><%= s.dest === s.city ? 'Destination' : s.dest %><%= s.n ? ` · ${s.n} service${s.n === 1 ? '' : 's'}` : '' %></small></span>
      </a>
    <% }) %>
  </div>
</section>
<% } %>

<section class="v-portal" id="portal">
  <div class="v-wrap v-portal-grid">
    <div class="v-portal-copy">
      <h2>One portal for the whole agency</h2>
      <p>Search net rates, build a day-by-day package, send the quote on WhatsApp, book, and download the invoice, without switching between suppliers.</p>
      <ul class="v-ticks">
        <li><b>Search &amp; book</b> hotels, airfares, activities, transfers, visas and insurance</li>
        <li><b>Packages</b> ready-made by VaayuTrip, or your own day by day</li>
        <li><b>Quotes</b> with your markup, shared as a PDF or link</li>
        <li><b>Bookings &amp; trips</b> with vouchers and departure reminders</li>
        <li><b>Wallet, credit &amp; earnings</b> with a bank-style statement</li>
      </ul>
      <% if (!user) { %><a class="v-btn v-btn-light" href="/signup">Get your agency account</a><% } %>
    </div>
    <figure class="v-browser">
      <div class="v-browser-bar"><i></i><i></i><i></i><span>vaayu-agent.vercel.app/agent</span></div>
      <img src="/img/portal-dashboard.jpg?v=6" alt="The VaayuTrip agent portal: search, recent quotes, upcoming departures, account and earnings" loading="lazy" width="1440" height="900">
    </figure>
  </div>
</section>

<section class="v-sec" id="features">
  <div class="v-wrap">
    <div class="v-feature-lead">
      <div>
        <h2>Every building block of a trip, at net</h2>
        <p>Contracted by the VaayuTrip team for six destinations. Add your markup per service, or price each line yourself.</p>
      </div>
      <ul class="v-svc-list">
        <li><%- icon('plane') %><b>Airfares</b><span>Return and one-way fares from Indian cities</span></li>
        <li><%- icon('bed') %><b>Hotels</b><span>Hotels, resorts and villas with meal plans</span></li>
        <li><%- icon('ticket') %><b>Activities</b><span>Tours, attraction tickets and day trips</span></li>
        <li><%- icon('car') %><b>Transfers</b><span>Airport, intercity, rail and ferry</span></li>
        <li><%- icon('passport') %><b>Visas</b><span>e-Visas, sticker visas and assistance</span></li>
        <li><%- icon('shield') %><b>Travel insurance</b><span>Basic, Standard and Premium plans</span></li>
      </ul>
    </div>

    <div class="v-feature-row">
      <div class="v-feature-media">
        <div class="v-doc" aria-hidden="true">
          <div class="v-doc-head"><span class="v-doc-logo">Your logo</span><span><b>Tax invoice</b><small>Your agency name · your GSTIN</small></span></div>
          <div class="v-doc-meta"><span>Billed to<b>Your customer</b></span><span>Trip<b>Dubai, 4 nights</b></span></div>
          <div class="v-doc-line"><span>Return flights</span><i></i></div>
          <div class="v-doc-line"><span>Hotel, 4 nights</span><i></i></div>
          <div class="v-doc-line"><span>Desert safari + Burj Khalifa</span><i></i></div>
          <div class="v-doc-total"><span>Total</span><span>Your price</span></div>
        </div>
      </div>
      <div class="v-feature-copy">
        <h3>Your brand on every document</h3>
        <p>Quotes, invoices and vouchers go to your customer under your agency's name, logo and GSTIN. VaayuTrip sells only to agents and stays out of sight.</p>
        <p class="v-small">Each booking also gets a B2B invoice from VaayuTrip at net rates, for your accounts.</p>
      </div>
    </div>

    <div class="v-feature-grid">
      <div><span class="v-ico"><%- icon('briefcase') %></span><h3>Ready-made or your own packages</h3><p>Quote VaayuTrip's packages as they are, or lay out your own days with our services and yours. Your package, your price.</p></div>
      <div><span class="v-ico"><%- icon('globe') %></span><h3>Your own website</h3><p>We can build a site on your domain, connected to the portal, so your published packages and prices stay in sync.</p></div>
      <div><span class="v-ico"><%- icon('wallet') %></span><h3>Wallet &amp; credit</h3><p>Book from your wallet or a credit line, top up by UPI or bank transfer, and download a statement any time.</p></div>
      <div><span class="v-ico"><%- icon('lock') %></span><h3>Secure by default</h3><p>Two-step login, a record of every sign-in, team roles for sales and accounts, and trip reminders before customers fly.</p></div>
    </div>
  </div>
</section>

<section class="v-sec v-calc-sec" id="calc">
  <div class="v-wrap v-calc-grid">
    <div class="v-calc-intro">
      <h2>See what one trip earns you</h2>
      <p>Pick a sample trip and move the markup. You set your own markup on every booking; your customer sees only your price, on your invoice.</p>
      <p class="v-small">Example net rates for 2 adults, for illustration. Live rates are in the portal.</p>
    </div>
    <div class="v-calc" data-calc>
      <div class="v-calc-in">
        <div class="v-seg" role="radiogroup" aria-label="Sample trip">
          <% TRIPS.forEach((t, i) => { %>
            <label><input type="radio" name="calc-trip" value="<%= t.key %>" <%= i === 0 ? 'checked' : '' %> data-lines='<%= JSON.stringify(t.lines) %>'><span><%= t.name %></span></label>
          <% }) %>
        </div>
        <table class="v-calc-lines" data-calc-lines>
          <% t0.lines.forEach(l => { %><tr><td><%= l[0] %></td><td class="num"><%= inr(l[1]) %> <small class="muted">net</small></td></tr><% }) %>
        </table>
        <div class="v-slider">
          <label for="calc-m">Your markup <b data-calc-pct><%= m0 %>%</b></label>
          <input id="calc-m" type="range" min="0" max="30" step="1" value="<%= m0 %>" data-calc-m>
          <div class="v-slider-scale" aria-hidden="true"><span>0%</span><span>15%</span><span>30%</span></div>
        </div>
      </div>
      <div class="v-calc-out">
        <div><small>Net cost to you</small><b data-calc-net><%= inr(net0) %></b></div>
        <div><small>Customer pays</small><b data-calc-total><%= inr(net0 * (1 + m0 / 100)) %></b><small class="v-faint"><%= gstOn ? '+ GST ' : '' %>+ TCS</small></div>
        <div class="calc-profit v-profit"><small>You earn on this trip</small><b data-calc-profit><%= inr(net0 * m0 / 100) %></b></div>
      </div>
    </div>
  </div>
</section>

<section class="v-sec v-sand" id="how">
  <div class="v-wrap">
    <div class="v-head"><h2>From sign-up to first booking</h2><p>Most agencies are verified within one working day.</p></div>
    <ol class="v-steps">
      <li><span>01</span><h3>Sign up</h3><p>Create your agency account in about ten minutes.</p></li>
      <li><span>02</span><h3>Get verified</h3><p>We check your GSTIN or company tax ID, usually within a working day.</p></li>
      <li><span>03</span><h3>Build packages</h3><p>Pick flights, hotels and activities for each day and set your price.</p></li>
      <li><span>04</span><h3>Quote &amp; book</h3><p>Send branded quotes on WhatsApp and book from your wallet, credit or online.</p></li>
    </ol>
    <div class="v-apply" id="apply">
      <div>
        <h3>What you need to apply</h3>
        <p>We verify every agency before it can book, to keep the network trusted and invoices compliant.</p>
      </div>
      <div class="v-apply-cols">
        <div><h4><%- icon('building') %>Agencies in India</h4><ul><li>GSTIN of the agency</li><li>GST registration certificate (PDF or photo)</li><li>Work email and mobile number</li></ul></div>
        <div><h4><%- icon('globe') %>Agencies outside India</h4><ul><li>Company tax ID (VAT, TRN, EIN, ABN…)</li><li>Tax or company registration certificate</li><li>Work email and mobile number</li></ul></div>
      </div>
    </div>
  </div>
</section>

<section class="v-sec" id="trust">
  <div class="v-wrap v-trust">
    <h2>What you can count on</h2>
    <dl class="v-trust-list">
      <div><dt><%- icon('percent') %>Free to join</dt><dd>No joining fee and no monthly targets. You pay only for what you book, at net.</dd></div>
      <div><dt><%- icon('badgeCheck') %>Verified agencies only</dt><dd>Every partner is checked before booking opens, which keeps the network and its invoices clean.</dd></div>
      <div><dt><%- icon('file') %>White-label by design</dt><dd>Your customer never sees VaayuTrip on a quote, invoice or voucher.</dd></div>
      <div><dt><%- icon('lock') %>Secure login</dt><dd>Two-step verification and a sign-in record for every user on your team.</dd></div>
      <div><dt><%- icon('headset') %>A partner desk</dt><dd>Raise a ticket from the portal for a written record, or call<%= settings.phone ? ` ${settings.phone}` : '' %>. Monday to Saturday, 9:30 am to 7:30 pm IST.</dd></div>
    </dl>
  </div>
</section>

<section class="v-sec v-faq-sec" id="faq">
  <div class="v-wrap v-faq-grid">
    <div class="v-faq-intro">
      <h2>Common questions</h2>
      <p>Anything else? Write to <a href="mailto:<%= settings.email %>"><%= settings.email %></a><% if (waNumber) { %> or <a href="https://wa.me/<%= waNumber %>" target="_blank" rel="noopener">message us on WhatsApp</a><% } %>.</p>
    </div>
    <div class="v-faq">
      <details>
        <summary>Is there a joining fee or a minimum business commitment?</summary>
        <p>No. Joining is free and there are no monthly targets. You pay only for what you book, at net rates.</p>
      </details>
      <details>
        <summary>Does VaayuTrip give us ready-made packages?</summary>
        <p>Yes. Ready-made VaayuTrip packages for each destination, day by day, that you can quote as they are or copy and change. Or build your own from the building blocks we sell separately at net rates: airfares, hotels, activities, transfers, visas and travel insurance.</p>
      </details>
      <details>
        <summary>Which destinations do you cover?</summary>
        <p>Dubai, Bali, Vietnam, Cambodia, the United Kingdom and Europe (including France, Switzerland, Italy, the Netherlands and Spain). Our team keeps adding hotels, fares and activities in each.</p>
      </details>
      <details>
        <summary>How do I earn on each booking?</summary>
        <p>You add your markup to everything you book from us, as a percentage or a flat amount per booking, or price each line yourself, and charge your own price for anything you arrange yourself. Your Reports page tracks earnings month by month.</p>
      </details>
      <details>
        <summary>Can my customer see VaayuTrip on the invoice?</summary>
        <p>No. VaayuTrip sells only to agents. Quotes, invoices and vouchers go to your customers under your agency's name and logo, so add your logo and company details before your first booking.</p>
      </details>
      <details>
        <summary>How do I pay for bookings?</summary>
        <p>Top up your wallet by bank transfer or UPI and book instantly. Verified agencies can also get a credit line. Cancellation refunds go back to your wallet or credit.</p>
      </details>
      <details>
        <summary>We're a travel agency outside India. Can we join?</summary>
        <p>Yes. Sign up with your company's tax ID and registration certificate instead of a GSTIN. Your tax ID appears on the invoices we issue to you.</p>
      </details>
      <details>
        <summary>What if something goes wrong on a trip?</summary>
        <p>Raise a ticket from Help &amp; support in your portal for a written record, or call or WhatsApp our team for anything urgent.</p>
      </details>
    </div>
  </div>
</section>

<section class="v-final" style="--final-img:url('<%= cover({ destination: 'Europe' }) %>')">
  <div class="v-wrap v-final-in">
    <h2>Your travel business.<br>Your brand. Your growth.</h2>
    <p>Free to join, no monthly targets. Sign up in about ten minutes; we verify your agency within one working day.</p>
    <div class="v-ctas">
      <% if (user) { %><a class="v-btn v-btn-light" href="<%= home %>">Open your portal</a><% } else { %>
      <a class="v-btn v-btn-light" href="/signup">Become a VaayuTrip partner</a>
      <a class="v-btn v-btn-outline-light" href="/login">Partner log in</a><% } %>
    </div>
  </div>
</section>
