<div class="auth" style="min-height:calc(100vh - 70px)">
  <div class="art">
    <div>
      <h2>Sell more trips with less work.</h2>
      <ul>
        <li>Airfares, hotels and activities at net rates to build your own packages</li>
        <li>Your commission, your price</li>
        <li>Invoices with your own logo</li>
        <li>Ready-made VaayuTrip packages to sell</li>
      </ul>
    </div>
    <img src="/img/vaayutrip-logo-sm.png" alt="VaayuTrip DMC" class="footer-logo" width="189" height="64">
  </div>
  <div class="form">
    <div>
      <h1>Log in</h1>
      <p class="muted">Agents and VaayuTrip team members.</p>
      <% if (otpOn) { %>
      <nav class="login-tabs" aria-label="How to log in">
        <a href="/login<%= next ? `?next=${encodeURIComponent(next)}` : '' %>" class="<%= mode === 'password' ? 'on' : '' %>">Password</a>
        <a href="/login?mode=otp<%= next ? `&next=${encodeURIComponent(next)}` : '' %>" class="<%= mode === 'otp' ? 'on' : '' %>">Email code (OTP)</a>
      </nav>
      <% } %>
      <% if (mode === 'otp') { %>
      <form method="post" action="/login/otp">
        <input type="hidden" name="next" value="<%= next %>">
        <div class="field"><label for="email">Email</label><input id="email" type="email" name="email" value="<%= email %>" required autofocus autocomplete="username"></div>
        <button class="btn btn-primary btn-lg" style="width:100%">Email me a login code</button>
      </form>
      <p class="muted" style="margin:12px 0 0;font-size:13.5px">We'll email you a 6-digit code. No password needed.</p>
      <% } else { %>
      <form method="post" action="/login">
        <input type="hidden" name="next" value="<%= next %>">
        <div class="field"><label for="email">Email</label><input id="email" type="email" name="email" value="<%= email %>" required autofocus autocomplete="username"></div>
        <div class="field"><label for="password">Password</label><input id="password" type="password" name="password" required autocomplete="current-password"></div>
        <button class="btn btn-primary btn-lg" style="width:100%">Log in</button>
      </form>
      <p style="margin:12px 0 0;text-align:right;font-size:14px"><a href="/forgot-password">Forgot password?</a></p>
      <% } %>
      <p style="margin-top:18px" class="muted">New agent? <a href="/signup">Create a partner account</a></p>
      <% if (process.env.VERCEL_ENV !== 'production') { %>
      <details class="more" style="margin-top:24px">
        <summary>Demo accounts</summary>
        <table class="table" style="margin-top:8px;font-size:13px">
          <tr><td>VaayuTrip admin</td><td><code>admin@vaayutrip.com</code> / <code>admin123</code></td></tr>
          <tr><td>Backend team (inventory)</td><td><code>backend@vaayutrip.com</code> / <code>backend123</code></td></tr>
          <tr><td>Agent with own branding</td><td><code>agent@skyline.com</code> / <code>agent123</code></td></tr>
          <tr><td>Agent without branding</td><td><code>agent@ravitours.com</code> / <code>agent123</code></td></tr>
          <tr><td>Agent awaiting approval</td><td><code>agent@wanderlust.in</code> / <code>agent123</code></td></tr>
        </table>
      </details>
      <% } %>
    </div>
  </div>
</div>
