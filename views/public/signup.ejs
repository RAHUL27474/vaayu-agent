<% const india = (form.country || 'India') === 'India'; %>
<section class="section signup" style="max-width:760px">
  <span class="eyebrow" style="text-align:left">Partner application</span>
  <h1>Become a VaayuTrip partner</h1>
  <p class="muted">Free to join. Send us your agency's tax registration and your photo. Our team checks them and approves your agency, usually within one working day. You can book once you're approved.</p>
  <ol class="signup-steps">
    <li class="on"><b>1</b>Apply with your documents</li>
    <li><b>2</b>VaayuTrip verifies them</li>
    <li><b>3</b>Approved: start booking</li>
  </ol>

  <form method="post" action="/signup" class="card" enctype="multipart/form-data">
    <h3>1. Your agency</h3>
    <div class="row">
      <div class="field"><label for="agency">Agency name</label><input id="agency" name="agency" value="<%= form.agency || '' %>" required autocomplete="organization"></div>
      <div class="field"><label for="city">City</label><input id="city" name="city" value="<%= form.city || '' %>"></div>
    </div>
    <div class="row">
      <div class="field">
        <label for="country">Country of registration</label>
        <select id="country" name="country" data-tax-country>
          <% countries.forEach(c => { %><option <%= (form.country || 'India') === c ? 'selected' : '' %>><%= c %></option><% }) %>
        </select>
      </div>
      <div class="field" data-tax-india<%= india ? "" : " hidden" %>>
        <label for="gstin">GSTIN</label>
        <input id="gstin" name="gstin" value="<%= form.gstin || '' %>" maxlength="15" placeholder="27ABCDE1234F1Z5" style="text-transform:uppercase" autocomplete="off" autocapitalize="characters" spellcheck="false">
        <div class="hint">15-character GST number. Your PAN is read from it.</div>
      </div>
      <div class="field" data-tax-foreign<%= india ? " hidden" : "" %>>
        <label for="tax_id">Company tax ID</label>
        <input id="tax_id" name="tax_id" value="<%= form.tax_id || '' %>" maxlength="40" placeholder="e.g. VAT / TRN / EIN / ABN" autocomplete="off">
        <div class="hint">Your company's tax registration number in its country.</div>
      </div>
    </div>

    <h3 style="margin-top:8px">2. Verification documents</h3>
    <p class="muted" style="font-size:13px;margin-top:-4px">PDF, JPG or PNG, up to 5 MB each. Only VaayuTrip's verification team can see them.</p>
    <div class="doc-grid">
      <label class="doc-drop" for="tax_doc">
        <span class="d-ico"><%- icon('file') %></span>
        <b><span data-tax-india<%= india ? "" : " hidden" %>>GST registration certificate</span><span data-tax-foreign<%= india ? " hidden" : "" %>>Tax registration certificate</span></b>
        <small data-file-name>Choose file</small>
        <input id="tax_doc" type="file" name="tax_doc" accept="application/pdf,image/png,image/jpeg,image/webp" required>
      </label>
      <label class="doc-drop" for="pan_doc" data-tax-india<%= india ? "" : " hidden" %>>
        <span class="d-ico"><%- icon('passport') %></span>
        <b>PAN card</b>
        <small data-file-name>Choose file</small>
        <input id="pan_doc" type="file" name="pan_doc" accept="application/pdf,image/png,image/jpeg,image/webp"<%= india ? ' required' : '' %> data-required-india>
      </label>
      <label class="doc-drop photo-drop" for="photo">
        <span class="d-ico"><img data-photo-preview alt="" hidden><%- icon('user') %></span>
        <b>Your photo</b>
        <small data-file-name>Clear, front-facing photo</small>
        <input id="photo" type="file" name="photo" accept="image/png,image/jpeg,image/webp" capture="user" required>
      </label>
    </div>

    <h3 style="margin-top:8px">3. Your login</h3>
    <div class="row">
      <div class="field"><label for="name">Your name</label><input id="name" name="name" value="<%= form.name || '' %>" required autocomplete="name"></div>
      <div class="field"><label for="phone">Mobile</label><input id="phone" type="tel" name="phone" value="<%= form.phone || '' %>" autocomplete="tel"></div>
    </div>
    <div class="field"><label for="email">Work email</label><input id="email" type="email" name="email" value="<%= form.email || '' %>" required autocomplete="email"></div>
    <div class="field"><label for="password">Password</label><input id="password" type="password" name="password" minlength="8" required autocomplete="new-password"><div class="hint">At least 8 characters.</div></div>
    <p class="muted" style="font-size:13px;margin:0 0 12px">By submitting you agree to our <a href="/terms" target="_blank">terms of use</a> and <a href="/privacy" target="_blank">privacy policy</a>.</p>
    <button class="btn btn-accent btn-lg" style="width:100%">Submit application</button>
    <p class="muted" style="margin:14px 0 0;text-align:center">Already a partner? <a href="/login">Log in</a></p>
  </form>
</section>
