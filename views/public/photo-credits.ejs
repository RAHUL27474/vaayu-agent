<%# Credits for the destination photos (CC licences). Locals: photos, cities %>
<section class="section" style="max-width:820px">
  <h1>Photo credits</h1>
  <p class="muted">Destination and city photos come from Wikimedia Commons and are used under the licences shown. Each links to its original.</p>
  <div class="card flush"><table class="table">
    <thead><tr><th>Place</th><th>Photo</th><th>By</th><th>Licence</th></tr></thead>
    <% Object.entries({ ...photos, ...cities }).forEach(([name, p]) => { %>
      <tr><td><div style="display:flex;align-items:center;gap:10px"><img src="<%= p.file %>" alt="" loading="lazy" style="width:64px;height:42px;object-fit:cover;border-radius:6px;flex:none"><b><%= name %></b></div></td><td><a href="<%= p.source %>" rel="noopener" target="_blank"><%= p.title %></a></td><td><%= p.artist %></td>
        <td class="nowrap"><a href="<%= /^CC0/.test(p.license) ? 'https://creativecommons.org/publicdomain/zero/1.0/' : 'https://creativecommons.org/licenses/' + p.license.replace(/^CC /, '').split(' ')[0].toLowerCase() + '/' + p.license.split(' ').pop() + '/' %>" rel="noopener" target="_blank"><%= p.license %></a></td></tr>
    <% }) %>
  </table></div>
  <p class="muted" style="font-size:13px;margin-top:12px">Photos were resized for this site; otherwise unchanged.</p>
</section>
