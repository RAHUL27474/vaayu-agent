<%- include('../partials/site-nav', { site }) %>
<section class="agent-site-hero" style="background:linear-gradient(135deg, <%= site.brand_color %>, #0f172a)">
  <div class="inner">
    <h1><%= site.website_tagline || `Holidays by ${site.name}` %></h1>
    <p><%= site.website_about || 'Handpicked holidays with personal service from planning to return.' %></p>
    <a class="btn btn-accent btn-lg" href="#enquire">Plan my trip</a>
  </div>
</section>

<% flash.forEach(f => { %><div class="section" style="padding-bottom:0"><div class="alert <%= f.type %>"><%= f.message %></div></div><% }) %>

<section class="section">
  <h2 class="big">Popular holidays</h2>
  <p class="center">Prices per person for two adults sharing a room, taxes extra.</p>
  <% if (!packages.length) { %><p class="center muted">New holidays are coming soon. Tell us where you would like to go below and we will plan it for you.</p><% } %>
  <div class="pkg-grid">
    <% packages.forEach(p => { %>
      <a class="pkg" href="/site/<%= site.slug %>/p/<%= p.slug %>" style="color:inherit;text-decoration:none">
        <img src="<%= cover(p) %>" alt="<%= p.title %>" loading="lazy">
        <div class="body">
          <div class="meta"><%= p.nights %> nights · <%= p.destination %></div>
          <h3><%= p.title %></h3>
          <p class="muted" style="font-size:13px"><%= p.summary %></p>
          <div class="price"><span class="muted">from</span><b><%= inr(p.price) %></b></div>
        </div>
      </a>
    <% }) %>
  </div>
</section>

<section class="section" id="enquire" style="max-width:720px">
  <%- include('../partials/site-enquiry', { site, pkg: null }) %>
</section>
<%- include('../partials/site-footer', { site }) %>
