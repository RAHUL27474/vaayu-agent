<%- include('../partials/site-nav', { site }) %>
<% flash.forEach(f => { %><div class="section" style="padding-bottom:0"><div class="alert <%= f.type %>"><%= f.message %></div></div><% }) %>
<section class="section">
  <a href="/site/<%= site.slug %>">← All holidays</a>
  <div class="split" style="margin-top:16px">
    <div>
      <img src="<%= cover(pkg) %>" alt="<%= pkg.title %>" style="width:100%;max-height:380px;object-fit:cover;border-radius:14px">
      <h1 style="margin-top:20px"><%= pkg.title %></h1>
      <p class="muted"><%= pkg.nights %> nights · <%= pkg.destination %><%= pkg.theme ? ` · ${pkg.theme}` : '' %></p>
      <p style="font-size:16px"><%= pkg.summary %></p>
      <%- include('../partials/package-full', { p: view }) %>
    </div>
    <div>
      <div class="card" style="position:sticky;top:20px">
        <div class="muted">From, per person (two adults sharing)</div>
        <div style="font-size:28px;font-weight:800;color:<%= site.brand_color %>"><%= inr(price) %></div>
        <small class="muted">+ taxes · EMI available</small>
        <hr>
        <%- include('../partials/site-enquiry', { site, pkg }) %>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/site-footer', { site }) %>
