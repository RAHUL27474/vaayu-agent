<%
  const first = user.name.split(' ')[0];
  const brand = /^#[0-9a-f]{6}$/i.test(agency.brand_color || '') ? agency.brand_color : '#0077c0';
  const diff = stats.earnings - personal.prevEarnings;
  const plural = (n, w) => `${n} ${w}${n === 1 ? '' : 's'}`;
  let story;
  if (stats.bookings) story = `You've earned <b>${inr(stats.earnings)}</b> this month from ${plural(stats.bookings, 'booking')}${personal.prevEarnings > 0 ? (diff >= 0 ? `, <b class="up">${inr(diff)} more</b> than last month` : `, ${inr(-diff)} behind last month so far`) : ''}.`;
  else if (personal.life.n) story = `No bookings yet this month. Last month you earned ${inr(personal.prevEarnings)}; a quote or two today gets you going.`;
  else { const nextStep = checklist.find((c) => !c.done); story = nextStep ? 'Welcome aboard. ' + checklist.filter((c) => c.done).length + ' of ' + checklist.length + ' set-up steps done; next: <a href="' + nextStep.href + '">' + nextStep.label.charAt(0).toLowerCase() + nextStep.label.slice(1) + '</a>.' : 'Welcome aboard. Build your first package and send a quote: your customers see only your brand.'; }
  const since = personal.life.first ? new Date(personal.life.first.replace(' ', 'T') + 'Z').toLocaleDateString('en-IN', { month: 'short', year: 'numeric', timeZone: 'Asia/Kolkata' }) : null;
%>
<section class="hello" style="--brand-agency:<%= brand %>">
  <div class="hello-id">
    <div>
      <p class="hello-date"><%= new Date().toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Asia/Kolkata' }) %></p>
      <h1><%= personal.greeting %>, <%= first %></h1>
      <p class="hello-story"><%- story %></p>
    </div>
  </div>
  <div class="hello-facts">
    <div><b><%= personal.life.n %></b><span><%= personal.life.n === 1 ? 'trip' : 'trips' %> booked<%= since ? ` since ${since}` : '' %></span></div>
    <div><b><%= personal.customersCount %></b><span><%= personal.customersCount === 1 ? 'customer' : 'customers' %> in your book</span></div>
    <div><b><%= personal.weekTrips %></b><span>travelling this week</span></div>
  </div>
</section>

<% if (personal.lastQuote) { const q = personal.lastQuote; %>
  <a class="resume" href="/agent/quotes/<%= q.id %>">
    <span class="resume-ico"><%- icon('file') %></span>
    <span><small>Pick up where you left off</small><b><%= q.title %></b></span>
    <span class="badge <%= q.status %>"><%= q.status %></span>
    <span class="resume-go">Continue<%- icon('arrowRight') %></span>
  </a>
<% } %>

<% if (agentCan('/agent/find')) { %>
<form class="book-panel" method="get" action="/agent/find">
  <div class="book-head">
    <h2>Where are your customers going next, <%= first %>?</h2>
    <span>Net rates from VaayuTrip · your markup added automatically</span>
  </div>
  <div class="svc-tabs" role="radiogroup" aria-label="Service">
    <% services.forEach((s, i) => { %>
      <label class="svc-tab"><input type="radio" name="svc" value="<%= s.path %>" <%= s.path === 'hotels' ? 'checked' : '' %>><%- icon(s.icon) %><span><%= s.label %></span></label>
    <% }) %>
  </div>
  <div class="book-fields">
    <div class="field"><label for="bk-dest">Destination</label>
      <select id="bk-dest" name="dest"><option value="">All destinations</option><% destinations.forEach(d => { %><option><%= d %></option><% }) %></select>
    </div>
    <div class="field grow"><label for="bk-q">City, hotel or experience</label><input id="bk-q" type="search" name="q" placeholder="e.g. Ubud, Burj Khalifa, Emirates"></div>
    <button class="btn btn-accent btn-lg"><%- icon('search') %>Search net rates</button>
  </div>
</form>
<% } %>

<div class="quick-grid">
  <a class="quick t-blue" href="/agent/packages/new"><span class="q-go" aria-hidden="true">→</span><span class="q-ico"><%- icon('briefcase') %></span><b>Build a package</b><small>Day-wise trip from our inventory</small></a>
  <a class="quick t-teal" href="/agent/quotes"><span class="q-go" aria-hidden="true">→</span><span class="q-ico"><%- icon('file') %></span><b>Quotes</b><small><%= personal.awaiting ? `${personal.awaiting} waiting on your customers` : quotes.length ? 'All answered' : 'Share prices on WhatsApp' %></small></a>
  <a class="quick t-amber" href="/agent/leads"><span class="q-go" aria-hidden="true">→</span><span class="q-ico"><%- icon('target') %></span><b>Leads</b><small><%= followUps.length ? `${followUps.length} to call today` : `${openLeads} open lead${openLeads === 1 ? '' : 's'}` %></small></a>
  <% if (agentCan('/agent/wallet')) { %><a class="quick t-green" href="/agent/wallet"><span class="q-go" aria-hidden="true">→</span><span class="q-ico"><%- icon('wallet') %></span><b>Top up wallet</b><small>Balance <%= inr(agency.wallet_balance) %></small></a><% } %>
</div>

<% if (tierNow.tier !== 'standard') { %>
  <div class="tier-banner <%= tierNow.tier %>"><span class="tier-badge <%= tierNow.tier %>"><%= tierNow.tier === 'gold' ? 'Gold' : 'Silver' %> prices</span>
    <span><%= tierNow.source === 'all' ? (tierNow.label || 'Special offer') + ': lower net rates on all VaayuTrip inventory and packages' : `You're a ${tierNow.tier === 'gold' ? 'Gold' : 'Silver'} partner: lower net rates on all VaayuTrip inventory and packages` %><%= tierNow.until ? ` till ${fmtDate(tierNow.until)}` : '' %>.</span></div>
<% } %>
<% if (credit.dueOn && (credit.overdue || credit.daysLeft <= 3)) { %>
  <div class="alert <%= credit.overdue ? 'error' : 'warn' %>"><b><%= credit.overdue ? 'Credit overdue' : 'Credit due soon' %>:</b> <%= inr(credit.used) %> <%= credit.overdue ? `was due on ${fmtDate(credit.dueOn)}. Bookings can't use credit until it's repaid.` : `is due on ${fmtDate(credit.dueOn)}.` %> <% if (agentCan('/agent/wallet')) { %><a href="/agent/wallet">Repay from wallet</a><% } %></div>
<% } %>
<% if (lowWallet) { %>
  <div class="alert warn"><b>Low wallet balance:</b> <%= inr(agency.wallet_balance) %>, below your alert of <%= inr(agency.low_balance_alert) %>. <% if (agentCan('/agent/wallet')) { %><a href="/agent/wallet">Top up</a><% } %></div>
<% } %>
<% if (followUps.length) { %>
  <div class="today-grid">
    <% if (followUps.length) { %>
    <div class="card flush">
      <div class="card-head"><h3>Follow-ups due</h3><a href="/agent/leads?due=1">All</a></div>
      <table class="table">
        <% followUps.forEach(l => { const overdue = l.follow_up_on < today; %>
          <tr class="click" data-href="/agent/leads?due=1">
            <td><b><%= l.name %></b><br><small class="muted"><%= l.follow_up_note || l.destination || '' %><%= l.assignee ? ` · ${l.assignee}` : '' %></small></td>
            <td class="num"><span class="badge <%= overdue ? 'cancelled' : 'pending' %>"><%= overdue ? `overdue · ${fmtDate(l.follow_up_on)}` : 'today' %></span><% if (l.phone) { %><br><a href="tel:<%= l.phone.replace(/\s/g, '') %>"><small><%= l.phone %></small></a><% } %></td>
          </tr>
        <% }) %>
      </table>
    </div>
    <% } %>
  </div>
<% } %>

<% if (agency.status === 'active' && profileGaps.length) { %>
  <div class="alert warn"><b>Complete your company profile to start booking.</b> Your customers' invoices carry your agency's name, logo and details. Missing: <%= profileGaps.join(', ') %>. <a href="/agent/settings">Go to Company &amp; branding</a></div>
<% } %>
<% if (agency.status !== 'active') { %>
  <div class="alert warn">Your account is <b><%= agency.status %></b>. VaayuTrip is reviewing your details; you can explore, build quotes and set up your branding meanwhile. Booking unlocks after approval.</div>
<% } %>
<% const doneCount = checklist.filter(c => c.done).length; %>
<% if (doneCount < checklist.length) { %>
  <div class="card setup">
    <div class="card-head">
      <h3>Get set up</h3>
      <span class="muted" style="font-size:13px"><%= doneCount %> of <%= checklist.length %> done</span>
    </div>
    <div class="progress"><div style="width:<%= Math.round(doneCount / checklist.length * 100) %>%"></div></div>
    <ol class="checklist">
      <% checklist.forEach(c => { %>
        <li class="<%= c.done ? 'done' : '' %>"><% if (c.done) { %><span><%= c.label %></span><% } else { %><a href="<%= c.href %>"><%= c.label %> →</a><% } %></li>
      <% }) %>
    </ol>
  </div>
<% } %>

<% if (offers.length) { %>
  <div class="offer-strip">
    <% offers.forEach(o => { %><%- include('../partials/offer-card', { o }) %><% }) %>
  </div>
<% } %>

<%
  const used = agency.credit_limit > 0 ? Math.min(100, Math.round(agency.credit_used / agency.credit_limit * 100)) : 0;
  const spark = (vals) => { const mx = Math.max(1, ...vals); const n = vals.length; return vals.map((x, i) => `${(n > 1 ? i * 100 / (n - 1) : 50).toFixed(1)},${(30 - x / mx * 26).toFixed(1)}`).join(' '); };
  const earnVals = chart.map(c => c.value || 0);
%>
<div class="grid grid-4 money-row" style="margin-bottom:20px">
  <div class="stat s-blue"><div class="label"><span class="s-ico"><%- icon('wallet') %></span>Wallet balance</div><div class="value" data-tick><%= inr(agency.wallet_balance) %></div><div class="sub"><a href="/agent/wallet">Top up →</a></div></div>
  <div class="stat s-teal"><div class="label"><span class="s-ico"><%- icon('shield') %></span>Credit available</div><div class="value" data-tick><%= inr(agency.credit_limit - agency.credit_used) %></div>
    <% if (agency.credit_limit > 0) { %><% if (used) { %><div class="meter" title="<%= used %>% of your credit line used"><i style="width:<%= used %>%"></i></div><% } %><div class="sub"><%= used ? used + '% used of ' : 'of ' %><%= inr(agency.credit_limit) %> limit</div><% } else { %><div class="sub">ask VaayuTrip for a credit line</div><% } %></div>
  <div class="stat s-amber"><div class="label"><span class="s-ico"><%- icon('chart') %></span>Sales this month</div><div class="value" data-tick><%= inr(stats.sales) %></div><div class="sub"><%= stats.bookings %> booking<%= stats.bookings === 1 ? '' : 's' %></div></div>
  <div class="stat s-green"><div class="label"><span class="s-ico"><%- icon('target') %></span>Your earnings this month</div><div class="value profit" data-tick><%= inr(stats.earnings) %></div><div class="sub"><%= stats.sales > 0 ? `${(stats.earnings / stats.sales * 100).toFixed(1)}% of your sales` : 'No sales yet this month' %></div>
    <% if (earnVals.some(Boolean)) { %><svg class="spark" viewBox="0 0 100 32" preserveAspectRatio="none" aria-hidden="true"><polygon points="0,32 <%= spark(earnVals) %> 100,32"/><polyline points="<%= spark(earnVals) %>"/></svg><% } %></div>
</div>

<div class="card">
  <div class="card-head"><h3>Your earnings, last 6 months</h3><a href="/agent/reports">Full reports</a></div>
  <% if (!chart.some(c => c.value)) { %><div class="empty">Your commission from bookings will show here.</div><% } else { %>
    <%- include('../partials/bar-chart', { bars: chart, format: (n) => n >= 1e5 ? `₹${(n / 1e5).toFixed(1)}L` : n >= 1e3 ? `₹${Math.round(n / 1e3)}k` : inr(n) }) %>
  <% } %>
</div>

<div class="grid grid-2">
  <div class="card flush">
    <div class="card-head"><h3>Recent quotes</h3><a href="/agent/quotes">All quotes</a></div>
    <% if (!quotes.length) { %><div class="empty">No quotes yet. Start from <a href="/agent/packages">one of your packages</a> or any <a href="/agent/hotels">hotel</a>, <a href="/agent/flights">airfare</a> or <a href="/agent/activities">activity</a>.</div><% } else { %>
    <table class="table" style="margin-top:10px">
      <% quotes.forEach(q => { %>
        <tr class="click" data-href="/agent/quotes/<%= q.id %>"><td><b><%= q.title %></b><br><small><%= q.code %></small></td><td><span class="badge <%= q.status %>"><%= q.status %></span></td></tr>
      <% }) %>
    </table>
    <% } %>
  </div>
  <div class="card flush">
    <div class="card-head"><h3>New leads</h3><a href="/agent/leads">All leads</a></div>
    <% if (!leads.length) { %><div class="empty">No new leads. Add enquiries you get by phone or WhatsApp in <a href="/agent/leads">Leads</a>.</div><% } else { %>
    <table class="table" style="margin-top:10px">
      <% leads.forEach(l => { %>
        <tr><td><b><%= l.name %></b><br><small><%= l.destination || 'Any destination' %> · <%= l.source %></small></td><td class="num"><form method="post" action="/agent/leads/<%= l.id %>/quote"><button class="btn btn-sm">Create quote</button></form></td></tr>
      <% }) %>
    </table>
    <% } %>
  </div>
</div>

<div class="grid grid-2">
  <div class="card flush">
    <div class="card-head"><h3>Your customers travelling soon</h3><a href="/agent/bookings">All bookings</a></div>
    <% if (!personal.trips.length) { %><div class="empty">No trips coming up. Confirmed bookings show here with a countdown.</div><% } else { %>
    <div class="trips">
      <% personal.trips.forEach(t => { %>
        <a class="trip" href="/agent/bookings/<%= t.id %>">
          <img src="<%= cover({ destination: t.destination, city: t.destination, title: t.trip }) %>" alt="" loading="lazy">
          <span class="trip-body"><b><%= t.who || t.trip %></b><small><%= t.who ? t.trip : t.code %> · <%= fmtDate(t.travel_date) %></small></span>
          <span class="trip-count <%= t.days <= 3 ? 'soon' : '' %>"><b><%= t.days === 0 ? 'Today' : t.days === 1 ? '1' : t.days %></b><small><%= t.days === 0 ? 'flying' : t.days === 1 ? 'day to go' : 'days to go' %></small></span>
        </a>
      <% }) %>
    </div>
    <% } %>
  </div>
  <div class="card">
    <div class="card-head"><h3>New from VaayuTrip</h3><a href="/agent/activities">Browse</a></div>
    <% featured.forEach(x => { %>
      <a href="/agent/<%= x.path %>/<%= x.id %>" style="display:flex;gap:12px;align-items:center;padding:8px 0;color:inherit">
        <% if (x.image_url || ['hotel', 'activity', 'visa'].includes(x.kind)) { %><img src="<%= cover({ image_url: x.image_url, city: x.city }) %>" alt="" style="width:72px;height:52px;object-fit:cover;border-radius:8px;flex:none"><% } else { %><span class="feat-ico"><%- icon(x.kind === 'insurance' ? 'shield' : x.kind === 'flight' ? 'plane' : 'car') %></span><% } %>
        <div style="flex:1"><b><%= x.title %></b><br><small><%= x.city %>, <%= x.country %></small></div>
        <div class="num"><% if (x.price.was) { %><s class="was-price"><%= inr(x.price.was) %></s> <b class="tier-price"><%= inr(x.price.net) %></b><% } else { %><%= inr(x.price.net) %><% } %><small class="muted"> net</small><br><small class="muted"><%= x.price.unit %></small></div>
      </a>
    <% }) %>
  </div>
</div>
