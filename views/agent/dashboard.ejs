<%
  const diff = stats.earnings - personal.prevEarnings;
  const plural = (n, w) => `${n} ${w}${n === 1 ? '' : 's'}`;
  const canBook = agentCan('/agent/find');
  const canUseLeads = agentCan('/agent/leads');
  const canUseWallet = agentCan('/agent/wallet');
  const creditUsedPercent = agency.credit_limit > 0 ? Math.min(100, Math.round(agency.credit_used / agency.credit_limit * 100)) : 0;
  const since = personal.life.first ? new Date(personal.life.first.replace(' ', 'T') + 'Z').toLocaleDateString('en-IN', { month: 'short', year: 'numeric', timeZone: 'Asia/Kolkata' }) : null;
%>
<section class="hello agent-overview">
  <div class="hello-id">
    <h1>Dashboard</h1>
    <p class="hello-line"><%= new Date().toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Asia/Kolkata' }) %> · <%= personal.life.n %> <%= personal.life.n === 1 ? 'trip' : 'trips' %> booked<%= since ? ` since ${since}` : '' %> · <%= personal.customersCount %> <%= personal.customersCount === 1 ? 'customer' : 'customers' %></p>
  </div>
  <div class="hello-actions">
    <% if (canUseWallet) { %><a class="btn" href="/agent/wallet"><%- icon('wallet') %>Top up wallet</a><% } %>
    <% if (agentCan('/agent/packages/new')) { %><a class="btn btn-primary" href="/agent/packages/new"><%- icon('plus') %>New package</a><% } %>
  </div>
</section>

<% if (credit.dueOn && (credit.overdue || credit.daysLeft <= 3)) { %>
  <div class="alert <%= credit.overdue ? 'error' : 'warn' %>"><span><b><%= credit.overdue ? 'Credit overdue' : 'Credit due soon' %>:</b> <%= inr(credit.used) %> <%= credit.overdue ? `was due on ${fmtDate(credit.dueOn)}. Bookings can't use credit until it's repaid.` : `is due on ${fmtDate(credit.dueOn)}.` %> <% if (canUseWallet) { %><a href="/agent/wallet">Repay from wallet</a><% } %></span></div>
<% } %>
<% if (lowWallet) { %>
  <div class="alert warn"><span><b>Low wallet balance:</b> <%= inr(agency.wallet_balance) %>, below your alert of <%= inr(agency.low_balance_alert) %>. <% if (canUseWallet) { %><a href="/agent/wallet">Top up</a><% } %></span></div>
<% } %>

<% if (canBook) { const heroDest = destinations[0]; %>
<section class="dash-hero" aria-labelledby="book-net-rates">
  <div class="dash-hero-banner" style="--hero:url('<%= cover({ destination: heroDest }) %>')">
    <div class="dash-hero-copy">
      <h2 id="book-net-rates">Book at agent net rates</h2>
      <p>Find hotels, airfares and travel services for your next client trip.</p>
    </div>
    <span class="dash-hero-cap"><%- icon('mapPin') %><%= heroDest %></span>
  </div>
<form class="book-panel" method="get" action="/agent/find" role="search" aria-labelledby="book-net-rates">
  <div class="svc-tabs" role="radiogroup" aria-label="Service">
    <% services.forEach(s => { %>
      <label class="svc-tab"><input type="radio" name="svc" value="<%= s.path %>" <%= s.path === 'hotels' ? 'checked' : '' %>><%- icon(s.icon) %><span><%= s.label %></span></label>
    <% }) %>
  </div>
  <%
    // What each tab asks: [field, label, kind of input, placeholder / first option]
    const SEARCH = {
      activities: { go: 'Search activities', f: [['dest', 'Destination', 'dest', 'All destinations'], ['cat', 'Type of activity', 'cat', 'Any type'], ['q', 'Activity or place', 'text', 'e.g. Burj Khalifa, desert safari, Ha Long Bay']] },
      hotels: { go: 'Search hotels', f: [['dest', 'Destination', 'dest', 'All destinations'], ['q', 'City, area or hotel name', 'text', 'e.g. Ubud, Seminyak, Deira, Paris'], ['cat', 'Property type', 'cat', 'Any type']] },
      flights: { go: 'Search airfares', f: [['q', 'From', 'text', 'e.g. Delhi, Mumbai'], ['dest', 'To', 'dest', 'Any destination'], ['cat', 'Cabin', 'cat', 'Any cabin']] },
      transfers: { go: 'Search transfers', f: [['dest', 'Destination', 'dest', 'All destinations'], ['cat', 'Type of transfer', 'cat', 'Any type'], ['q', 'Route or place', 'text', 'e.g. airport to hotel, Ubud']] },
      visas: { go: 'Search visas', f: [['dest', 'Visa for', 'dest', 'All countries'], ['cat', 'Visa type', 'cat', 'Any type']] },
      insurance: { go: 'Search plans', f: [['dest', 'Trip to', 'dest', 'Any destination'], ['cat', 'Plan', 'cat', 'Any plan']] },
    };
  %>
  <% services.forEach((s) => { const cfg = SEARCH[s.path]; if (!cfg) return; %>
    <div class="book-fields bf bf-<%= s.path %> n<%= cfg.f.length %>">
      <% cfg.f.forEach(([k, label, type, ph]) => { const id = `bk-${s.path}-${k}`; %>
        <div class="field<%= type === 'text' ? ' grow' : '' %>"><label for="<%= id %>"><%= label %></label>
          <% if (type === 'dest') { %><select id="<%= id %>" name="<%= s.path %>_dest"><option value=""><%= ph %></option><% destinations.forEach(d => { %><option><%= d %></option><% }) %></select>
          <% } else if (type === 'cat') { %><select id="<%= id %>" name="<%= s.path %>_cat"><option value=""><%= ph %></option><% s.categories.forEach(c => { %><option><%= c %></option><% }) %></select>
          <% } else { %><input id="<%= id %>" type="search" name="<%= s.path %>_q" placeholder="<%= ph %>"><% } %>
        </div>
      <% }) %>
      <button class="btn btn-primary btn-lg"><%- icon('search') %><%= cfg.go %></button>
    </div>
  <% }) %>
</form>
</section>
<% } %>

<dl class="dash-metrics" aria-label="Account and monthly performance">
  <div class="dash-metric">
    <dt><span><%- icon('wallet') %></span>Wallet balance</dt>
    <dd><b><%= inr(agency.wallet_balance) %></b><% if (canUseWallet) { %><a href="/agent/wallet/statement">View statement</a><% } %></dd>
  </div>
  <div class="dash-metric">
    <dt><span><%- icon('card') %></span>Credit available</dt>
    <dd><b><%= inr(agency.credit_limit - agency.credit_used) %></b><small><%= agency.credit_limit > 0 ? (creditUsedPercent ? `${creditUsedPercent}% of ${inr(agency.credit_limit)} used` : `Limit ${inr(agency.credit_limit)}`) : 'No credit line' %></small><% if (creditUsedPercent) { %><span class="meter" aria-hidden="true"><i style="width:<%= creditUsedPercent %>%"></i></span><% } %></dd>
  </div>
  <div class="dash-metric">
    <dt><span><%- icon('receipt') %></span>Sales this month</dt>
    <dd><b><%= inr(stats.sales) %></b><small><%= plural(stats.bookings, 'booking') %></small></dd>
  </div>
  <div class="dash-metric dash-metric-earnings">
    <dt><span><%- icon('chart') %></span>Earnings this month</dt>
    <dd><b><%= inr(stats.earnings) %></b><% if (personal.prevEarnings > 0) { %><small class="<%= diff >= 0 ? 'up' : 'down' %>"><%= diff >= 0 ? '+' : '−' %><%= inr(Math.abs(diff)) %> vs last month</small><% } %></dd>
  </div>
</dl>

<% if (canBook) { %>
<section class="dest-row" aria-label="Destinations">
  <div class="sec-head"><h2>Destinations</h2><a href="/agent/vaayutrip-packages">Ready packages</a></div>
  <div class="dest-tiles">
    <% destinations.forEach((d) => { %>
      <a class="dest-tile" href="/agent/find?svc=hotels&amp;dest=<%= encodeURIComponent(d) %>"><img src="<%= cover({ destination: d }, 640) %>" alt="" loading="lazy"><span><b><%= d %></b><small>Browse hotels</small></span></a>
    <% }) %>
  </div>
</section>
<% } %>

<% if (offers.length) { %>
<section class="deals" aria-label="Deals for you">
  <div class="sec-head"><h2>Deals for you</h2><a href="/agent/offers">All offers</a></div>
  <div class="offer-strip">
    <% offers.forEach(o => { %><%- include('../partials/offer-card', { o }) %><% }) %>
  </div>
</section>
<% } %>

<% if (tierNow.tier !== 'standard') { %>
  <div class="tier-banner <%= tierNow.tier %>"><span class="tier-badge <%= tierNow.tier %>"><%= tierNow.tier === 'gold' ? 'Gold' : 'Silver' %> prices</span>
    <span><%= tierNow.source === 'all' ? (tierNow.label || 'Special offer') + ': lower net rates on all VaayuTrip inventory and packages' : `You're a ${tierNow.tier === 'gold' ? 'Gold' : 'Silver'} partner: lower net rates on all VaayuTrip inventory and packages` %><%= tierNow.until ? ` till ${fmtDate(tierNow.until)}` : '' %>.</span></div>
<% } %>
<% if (canUseLeads && followUps.length) { %>
  <div class="today-grid">
    <div class="card flush">
      <div class="card-head"><h2 class="h3">Follow-ups due</h2><a href="/agent/leads?due=1">All</a></div>
      <table class="table">
        <% followUps.forEach(l => { const overdue = l.follow_up_on < today; %>
          <tr class="click" data-href="/agent/leads?due=1">
            <td><b><%= l.name %></b><br><small class="muted"><%= l.follow_up_note || l.destination || '' %><%= l.assignee ? ` · ${l.assignee}` : '' %></small></td>
            <td class="num"><span class="badge <%= overdue ? 'cancelled' : 'pending' %>"><%= overdue ? `overdue · ${fmtDate(l.follow_up_on)}` : 'today' %></span><% if (l.phone) { %><br><a href="tel:<%= l.phone.replace(/\s/g, '') %>"><small><%= l.phone %></small></a><% } %></td>
          </tr>
        <% }) %>
      </table>
    </div>
  </div>
<% } %>

<% if (agency.status === 'active' && profileGaps.length) { %>
  <div class="alert warn"><b>Complete your company profile to start booking.</b> Your customers' invoices carry your agency's name, logo and details. Missing: <%= profileGaps.join(', ') %>. <a href="/agent/settings">Go to Company &amp; branding</a></div>
<% } %>
<% if (agency.status !== 'active') { %>
  <div class="alert warn">Your account is <b><%= agency.status %></b>. VaayuTrip is reviewing your details; you can explore, build quotes and set up your branding meanwhile. Booking unlocks after approval.</div>
<% } %>
<% const doneCount = checklist.filter(c => c.done).length; %>
<% if (doneCount < checklist.length) { %>
  <div class="card setup">
    <div class="card-head">
      <h2 class="h3">Get set up</h2>
      <span class="muted" style="font-size:13px"><%= doneCount %> of <%= checklist.length %> done</span>
    </div>
    <div class="progress"><div style="width:<%= Math.round(doneCount / checklist.length * 100) %>%"></div></div>
    <ol class="checklist">
      <% checklist.forEach(c => { %>
        <li class="<%= c.done ? 'done' : '' %>"><% if (c.done) { %><span><%= c.label %></span><% } else { %><a href="<%= c.href %>"><%= c.label %></a><% } %></li>
      <% }) %>
    </ol>
  </div>
<% } %>

<div class="split dash-split<%= canUseLeads || canBook ? '' : ' dash-split-wide' %>">
  <div>
    <div class="card flush">
      <div class="card-head"><h2 class="h3">Recent quotes<% if (personal.awaiting) { %> <small class="muted head-note"><%= personal.awaiting %> awaiting reply</small><% } %></h2><a href="/agent/quotes">All quotes</a></div>
      <% if (!quotes.length) { %><div class="empty">No quotes yet.<% if (canBook) { %> Start from <a href="/agent/packages">one of your packages</a> or browse <a href="/agent/hotels">hotels</a>, <a href="/agent/flights">airfares</a> and <a href="/agent/activities">activities</a>.<% } %></div><% } else { %>
      <table class="table no-stack dash-quotes">
        <thead><tr><th>Quote</th><th>Trip</th><th>Status</th></tr></thead>
        <% quotes.forEach(q => { const [trip, who] = q.title.split(' — '); %>
          <tr class="click" data-href="/agent/quotes/<%= q.id %>"><td class="nowrap"><a href="/agent/quotes/<%= q.id %>"><%= q.code %></a></td><td><b><%= trip %></b><% if (who) { %><br><small class="muted"><%= who %></small><% } %></td><td><span class="badge <%= q.status %>"><%= q.status %></span></td></tr>
        <% }) %>
      </table>
      <% } %>
    </div>

    <div class="card flush">
      <div class="card-head"><h2 class="h3">Upcoming departures</h2><a href="/agent/bookings">All bookings</a></div>
      <% if (!personal.trips.length) { %><div class="empty">No trips coming up. Confirmed bookings show here.</div><% } else { %>
      <table class="table no-stack dash-trips">
        <thead><tr><th>Travel date</th><th>Customer</th><th>Trip</th><th class="num">Departs</th></tr></thead>
        <% personal.trips.forEach(t => { %>
          <tr class="click" data-href="/agent/bookings/<%= t.id %>">
            <td class="nowrap"><%= fmtDate(t.travel_date) %></td>
            <td><b><%= t.who || '—' %></b></td>
            <td><span class="trip-cell"><img src="<%= cover({ destination: t.destination, city: t.destination, title: t.trip }, 640) %>" alt="" loading="lazy"><span><%= t.trip %><br><small class="muted"><%= t.code %></small></span></span></td>
            <td class="num nowrap"><span class="<%= t.days <= 3 ? 'due-soon' : '' %>"><%= t.days === 0 ? 'Today' : t.days === 1 ? 'Tomorrow' : `in ${t.days} days` %></span></td>
          </tr>
        <% }) %>
      </table>
      <% } %>
    </div>

    <div class="card">
      <div class="card-head"><h2 class="h3">Earnings by month</h2><% if (agentCan('/agent/reports')) { %><a href="/agent/reports">Full reports</a><% } %></div>
      <% if (!chart.some(c => c.value)) { %><div class="empty">Your commission from bookings will show here.</div><% } else { %>
        <%- include('../partials/bar-chart', { bars: chart, format: (n) => n >= 1e5 ? `₹${(n / 1e5).toFixed(1)}L` : n >= 1e3 ? `₹${Math.round(n / 1e3)}k` : inr(n) }) %>
      <% } %>
    </div>
  </div>

  <% if (canUseLeads || canBook) { %><aside>
    <% if (canUseLeads) { %>
    <div class="card flush">
      <div class="card-head"><h2 class="h3">New leads</h2><a href="/agent/leads">All leads</a></div>
      <% if (!leads.length) { %><div class="empty">No new leads. Add enquiries from phone or WhatsApp in <a href="/agent/leads">Leads</a>.</div><% } else { %>
      <table class="table">
        <% leads.forEach(l => { %>
          <tr><td><b><%= l.name %></b><br><small class="muted"><%= l.destination || 'Any destination' %> · <%= l.source %></small></td><td class="num"><form method="post" action="/agent/leads/<%= l.id %>/quote"><button class="btn btn-sm">Quote</button></form></td></tr>
        <% }) %>
      </table>
      <% } %>
    </div>
    <% } %>


    <% if (canBook) { %><div class="card flush">
      <div class="card-head"><h2 class="h3">New inventory</h2><a href="/agent/activities">Browse</a></div>
      <table class="table">
        <% featured.forEach(x => { %>
          <tr class="click" data-href="/agent/<%= x.path %>/<%= x.id %>"><td><a href="/agent/<%= x.path %>/<%= x.id %>" style="color:inherit"><b><%= x.title %></b></a><br><small class="muted"><%= x.city %>, <%= x.country %></small></td><td class="num nowrap"><% if (x.price.was) { %><s class="was-price"><%= inr(x.price.was) %></s><br><% } %><b><%= inr(x.price.net) %></b><br><small class="muted"><%= x.price.unit %></small></td></tr>
        <% }) %>
      </table>
    </div><% } %>
  </aside><% } %>
</div>
