<%
  const first = user.name.split(' ')[0];
  const brand = /^#[0-9a-f]{6}$/i.test(agency.brand_color || '') ? agency.brand_color : '#0077c0';
  const diff = stats.earnings - personal.prevEarnings;
  const plural = (n, w) => `${n} ${w}${n === 1 ? '' : 's'}`;
  let story;
  if (stats.bookings) story = `You've earned <b>${inr(stats.earnings)}</b> this month from ${plural(stats.bookings, 'booking')}${personal.prevEarnings > 0 ? (diff >= 0 ? `, <b class="up">${inr(diff)} more</b> than last month` : `, ${inr(-diff)} behind last month so far`) : ''}.`;
  else if (personal.life.n) story = `No bookings yet this month. Last month you earned ${inr(personal.prevEarnings)}; a quote or two today gets you going.`;
  else { const nextStep = checklist.find((c) => !c.done); story = nextStep ? 'Welcome aboard. ' + checklist.filter((c) => c.done).length + ' of ' + checklist.length + ' set-up steps done; next: <a href="' + nextStep.href + '">' + nextStep.label.charAt(0).toLowerCase() + nextStep.label.slice(1) + '</a>.' : 'Welcome aboard. Build your first package and send a quote: your customers see only your brand.'; }
  const since = personal.life.first ? new Date(personal.life.first.replace(' ', 'T') + 'Z').toLocaleDateString('en-IN', { month: 'short', year: 'numeric', timeZone: 'Asia/Kolkata' }) : null;
%>
<section class="hello" style="--brand-agency:<%= brand %>">
  <div class="hello-id">
    <h1>Dashboard</h1>
    <p class="hello-line"><%= new Date().toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Asia/Kolkata' }) %> · <%= personal.life.n %> <%= personal.life.n === 1 ? 'trip' : 'trips' %> booked<%= since ? ` since ${since}` : '' %> · <%= personal.customersCount %> <%= personal.customersCount === 1 ? 'customer' : 'customers' %></p>
  </div>
  <div class="hello-actions">
    <% if (agentCan('/agent/wallet')) { %><a class="btn" href="/agent/wallet">Top up wallet</a><% } %>
    <a class="btn btn-primary" href="/agent/packages/new"><%- icon('plus') %>New package</a>
  </div>
</section>

<% if (agentCan('/agent/find')) { %>
<form class="book-panel" method="get" action="/agent/find">
  <div class="svc-tabs" role="radiogroup" aria-label="Service">
    <% services.forEach((s, i) => { %>
      <label class="svc-tab"><input type="radio" name="svc" value="<%= s.path %>" <%= s.path === 'hotels' ? 'checked' : '' %>><%- icon(s.icon) %><span><%= s.label %></span></label>
    <% }) %>
  </div>
  <div class="book-fields">
    <div class="field"><label for="bk-dest">Destination</label>
      <select id="bk-dest" name="dest"><option value="">All destinations</option><% destinations.forEach(d => { %><option><%= d %></option><% }) %></select>
    </div>
    <div class="field grow"><label for="bk-q">City, hotel or experience</label><input id="bk-q" type="search" name="q" placeholder="e.g. Ubud, Burj Khalifa, Emirates"></div>
    <button class="btn btn-primary btn-lg"><%- icon('search') %>Search</button>
  </div>
</form>
<% } %>

<% if (tierNow.tier !== 'standard') { %>
  <div class="tier-banner <%= tierNow.tier %>"><span class="tier-badge <%= tierNow.tier %>"><%= tierNow.tier === 'gold' ? 'Gold' : 'Silver' %> prices</span>
    <span><%= tierNow.source === 'all' ? (tierNow.label || 'Special offer') + ': lower net rates on all VaayuTrip inventory and packages' : `You're a ${tierNow.tier === 'gold' ? 'Gold' : 'Silver'} partner: lower net rates on all VaayuTrip inventory and packages` %><%= tierNow.until ? ` till ${fmtDate(tierNow.until)}` : '' %>.</span></div>
<% } %>
<% if (credit.dueOn && (credit.overdue || credit.daysLeft <= 3)) { %>
  <div class="alert <%= credit.overdue ? 'error' : 'warn' %>"><b><%= credit.overdue ? 'Credit overdue' : 'Credit due soon' %>:</b> <%= inr(credit.used) %> <%= credit.overdue ? `was due on ${fmtDate(credit.dueOn)}. Bookings can't use credit until it's repaid.` : `is due on ${fmtDate(credit.dueOn)}.` %> <% if (agentCan('/agent/wallet')) { %><a href="/agent/wallet">Repay from wallet</a><% } %></div>
<% } %>
<% if (lowWallet) { %>
  <div class="alert warn"><b>Low wallet balance:</b> <%= inr(agency.wallet_balance) %>, below your alert of <%= inr(agency.low_balance_alert) %>. <% if (agentCan('/agent/wallet')) { %><a href="/agent/wallet">Top up</a><% } %></div>
<% } %>
<% if (followUps.length) { %>
  <div class="today-grid">
    <% if (followUps.length) { %>
    <div class="card flush">
      <div class="card-head"><h3>Follow-ups due</h3><a href="/agent/leads?due=1">All</a></div>
      <table class="table">
        <% followUps.forEach(l => { const overdue = l.follow_up_on < today; %>
          <tr class="click" data-href="/agent/leads?due=1">
            <td><b><%= l.name %></b><br><small class="muted"><%= l.follow_up_note || l.destination || '' %><%= l.assignee ? ` · ${l.assignee}` : '' %></small></td>
            <td class="num"><span class="badge <%= overdue ? 'cancelled' : 'pending' %>"><%= overdue ? `overdue · ${fmtDate(l.follow_up_on)}` : 'today' %></span><% if (l.phone) { %><br><a href="tel:<%= l.phone.replace(/\s/g, '') %>"><small><%= l.phone %></small></a><% } %></td>
          </tr>
        <% }) %>
      </table>
    </div>
    <% } %>
  </div>
<% } %>

<% if (agency.status === 'active' && profileGaps.length) { %>
  <div class="alert warn"><b>Complete your company profile to start booking.</b> Your customers' invoices carry your agency's name, logo and details. Missing: <%= profileGaps.join(', ') %>. <a href="/agent/settings">Go to Company &amp; branding</a></div>
<% } %>
<% if (agency.status !== 'active') { %>
  <div class="alert warn">Your account is <b><%= agency.status %></b>. VaayuTrip is reviewing your details; you can explore, build quotes and set up your branding meanwhile. Booking unlocks after approval.</div>
<% } %>
<% const doneCount = checklist.filter(c => c.done).length; %>
<% if (doneCount < checklist.length) { %>
  <div class="card setup">
    <div class="card-head">
      <h3>Get set up</h3>
      <span class="muted" style="font-size:13px"><%= doneCount %> of <%= checklist.length %> done</span>
    </div>
    <div class="progress"><div style="width:<%= Math.round(doneCount / checklist.length * 100) %>%"></div></div>
    <ol class="checklist">
      <% checklist.forEach(c => { %>
        <li class="<%= c.done ? 'done' : '' %>"><% if (c.done) { %><span><%= c.label %></span><% } else { %><a href="<%= c.href %>"><%= c.label %></a><% } %></li>
      <% }) %>
    </ol>
  </div>
<% } %>

<% const used = agency.credit_limit > 0 ? Math.min(100, Math.round(agency.credit_used / agency.credit_limit * 100)) : 0; %>
<div class="split dash-split">
  <div>
    <div class="card flush">
      <div class="card-head"><h3>Recent quotes<% if (personal.awaiting) { %> <small class="muted head-note"><%= personal.awaiting %> awaiting reply</small><% } %></h3><a href="/agent/quotes">All quotes</a></div>
      <% if (!quotes.length) { %><div class="empty">No quotes yet. Start from <a href="/agent/packages">one of your packages</a> or any <a href="/agent/hotels">hotel</a>, <a href="/agent/flights">airfare</a> or <a href="/agent/activities">activity</a>.</div><% } else { %>
      <table class="table">
        <thead><tr><th>Quote</th><th>Trip</th><th>Status</th></tr></thead>
        <% quotes.forEach(q => { const [trip, who] = q.title.split(' — '); %>
          <tr class="click" data-href="/agent/quotes/<%= q.id %>"><td class="nowrap"><a href="/agent/quotes/<%= q.id %>"><%= q.code %></a></td><td><b><%= trip %></b><% if (who) { %><br><small class="muted"><%= who %></small><% } %></td><td><span class="badge <%= q.status %>"><%= q.status %></span></td></tr>
        <% }) %>
      </table>
      <% } %>
    </div>

    <div class="card flush">
      <div class="card-head"><h3>Upcoming departures</h3><a href="/agent/bookings">All bookings</a></div>
      <% if (!personal.trips.length) { %><div class="empty">No trips coming up. Confirmed bookings show here.</div><% } else { %>
      <table class="table">
        <thead><tr><th>Travel date</th><th>Customer</th><th>Trip</th><th class="num">Departs</th></tr></thead>
        <% personal.trips.forEach(t => { %>
          <tr class="click" data-href="/agent/bookings/<%= t.id %>">
            <td class="nowrap"><%= fmtDate(t.travel_date) %></td>
            <td><b><%= t.who || '—' %></b></td>
            <td><%= t.trip %><br><small class="muted"><%= t.code %></small></td>
            <td class="num nowrap"><span class="<%= t.days <= 3 ? 'due-soon' : '' %>"><%= t.days === 0 ? 'Today' : t.days === 1 ? 'Tomorrow' : `in ${t.days} days` %></span></td>
          </tr>
        <% }) %>
      </table>
      <% } %>
    </div>

    <div class="card">
      <div class="card-head"><h3>Earnings by month</h3><a href="/agent/reports">Full reports</a></div>
      <% if (!chart.some(c => c.value)) { %><div class="empty">Your commission from bookings will show here.</div><% } else { %>
        <%- include('../partials/bar-chart', { bars: chart, format: (n) => n >= 1e5 ? `₹${(n / 1e5).toFixed(1)}L` : n >= 1e3 ? `₹${Math.round(n / 1e3)}k` : inr(n) }) %>
      <% } %>
    </div>
  </div>

  <aside>
    <div class="card flush acct">
      <div class="card-head"><h3>Account</h3><% if (agentCan('/agent/wallet')) { %><a href="/agent/wallet/statement">Statement</a><% } %></div>
      <dl class="acct-list">
        <div><dt>Wallet balance</dt><dd><%= inr(agency.wallet_balance) %></dd></div>
        <div><dt>Credit available</dt><dd><%= inr(agency.credit_limit - agency.credit_used) %><% if (agency.credit_limit > 0) { %><small><%= used ? `${used}% used of ` : 'Limit ' %><%= inr(agency.credit_limit) %></small><% if (used) { %><span class="meter"><i style="width:<%= used %>%"></i></span><% } %><% } else { %><small>No credit line</small><% } %></dd></div>
        <div><dt>Sales this month</dt><dd><%= inr(stats.sales) %><small><%= plural(stats.bookings, 'booking') %></small></dd></div>
        <div><dt>Earnings this month</dt><dd class="profit"><%= inr(stats.earnings) %><% if (personal.prevEarnings > 0) { %><small class="<%= diff >= 0 ? 'up' : 'down' %>"><%= diff >= 0 ? '+' : '−' %><%= inr(Math.abs(diff)) %> vs last month</small><% } %></dd></div>
      </dl>
      <% if (agentCan('/agent/wallet')) { %><div class="acct-foot"><a class="btn btn-accent" href="/agent/wallet">Top up wallet</a></div><% } %>
    </div>

    <div class="card flush">
      <div class="card-head"><h3>New leads</h3><a href="/agent/leads">All leads</a></div>
      <% if (!leads.length) { %><div class="empty">No new leads. Add enquiries from phone or WhatsApp in <a href="/agent/leads">Leads</a>.</div><% } else { %>
      <table class="table">
        <% leads.forEach(l => { %>
          <tr><td><b><%= l.name %></b><br><small class="muted"><%= l.destination || 'Any destination' %> · <%= l.source %></small></td><td class="num"><form method="post" action="/agent/leads/<%= l.id %>/quote"><button class="btn btn-sm">Quote</button></form></td></tr>
        <% }) %>
      </table>
      <% } %>
    </div>

    <% if (offers.length) { %>
    <div class="card flush">
      <div class="card-head"><h3>Offers</h3><a href="/agent/offers">All offers</a></div>
      <div class="offer-list">
        <% offers.forEach(o => { %>
          <div class="offer-row">
            <b><%= o.title %></b>
            <% if (o.body) { %><p><%= o.body %></p><% } %>
            <small class="muted"><%= o.valid_until ? `Valid till ${fmtDate(o.valid_until)}` : 'Ongoing' %><% if (o.code) { %> · Code <code><%= o.code %></code><% } %><% if (o.link) { %> · <a href="<%= o.link %>">Details</a><% } %></small>
          </div>
        <% }) %>
      </div>
    </div>
    <% } %>

    <div class="card flush">
      <div class="card-head"><h3>New inventory</h3><a href="/agent/activities">Browse</a></div>
      <table class="table">
        <% featured.forEach(x => { %>
          <tr class="click" data-href="/agent/<%= x.path %>/<%= x.id %>"><td><a href="/agent/<%= x.path %>/<%= x.id %>" style="color:inherit"><b><%= x.title %></b></a><br><small class="muted"><%= x.city %>, <%= x.country %></small></td><td class="num nowrap"><% if (x.price.was) { %><s class="was-price"><%= inr(x.price.was) %></s><br><% } %><b><%= inr(x.price.net) %></b><br><small class="muted"><%= x.price.unit %></small></td></tr>
        <% }) %>
      </table>
    </div>
  </aside>
</div>
