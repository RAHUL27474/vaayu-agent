<div class="page-head"><div><h1>Travel insurance</h1><p>Add cover to any trip; insurance is a simple extra earning on every booking.</p></div></div>
<form class="card" method="get">
  <div class="row">
    <div class="field"><label for="region">Trip</label>
      <select id="region" name="region">
        <option value="domestic" <%= params.region !== 'international' ? 'selected' : '' %>>Domestic</option>
        <option value="international" <%= params.region === 'international' ? 'selected' : '' %>>International</option>
      </select>
    </div>
    <div class="field"><label for="days">Days</label><input id="days" type="number" min="1" name="days" value="<%= params.days || 5 %>"></div>
    <div class="field"><label for="travellers">Travellers</label><input id="travellers" type="number" min="1" name="travellers" value="<%= params.travellers || 2 %>"></div>
  </div>
  <button class="btn btn-primary">Get plans</button>
</form>
<% if (searched) { %>
  <div class="grid grid-3">
    <% results.forEach(r => { %>
      <div class="card">
        <h3><%= r.title.split(' (')[0] %></h3>
        <p class="muted"><%= r.cover %></p>
        <p><%= r.travellers %> traveller<%= r.travellers > 1 ? 's' : '' %> · <%= r.days %> days</p>
        <div style="font-size:22px;font-weight:800;margin-bottom:12px"><%= inr(r.net) %> <small class="muted" style="font-size:12px;font-weight:500">net</small></div>
        <%- include('../partials/add-to-quote', { kind, params, r, quotes }) %>
      </div>
    <% }) %>
  </div>
<% } %>
