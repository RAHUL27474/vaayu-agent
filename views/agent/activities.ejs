<%
  const mk = agency.markup_type === 'flat' ? `${inr(agency.markup_value)} per booking` : `${agency.markup_value}%`;
  const qs = (over) => '?' + new URLSearchParams(Object.entries({ ...f, ...over }).filter(([, v]) => v)).toString();
%>
<div class="page-head">
  <div><h1>Activities</h1><p>Tours, tickets and experiences from VaayuTrip at agent net rates. Add them to a quote, or build them into your own packages. Prices shown include your default markup (<%= mk %>).</p></div>
  <a class="btn btn-primary" href="/agent/packages/new">+ Build a package</a>
</div>
<div class="chips filter-chips" style="margin-bottom:12px">
  <a class="<%= !f.region ? 'on' : '' %>" href="<%= qs({ region: '', city: '' }) %>">All</a>
  <a class="<%= f.region === 'india' ? 'on' : '' %>" href="<%= qs({ region: 'india', city: '' }) %>">India</a>
  <a class="<%= f.region === 'abroad' ? 'on' : '' %>" href="<%= qs({ region: 'abroad', city: '' }) %>">International</a>
</div>
<form class="card" method="get" style="display:flex;gap:10px;flex-wrap:wrap;align-items:end;padding:14px 16px">
  <% if (f.region) { %><input type="hidden" name="region" value="<%= f.region %>"><% } %>
  <div style="flex:1;min-width:200px"><label for="q">Search</label><input id="q" type="search" name="q" value="<%= f.q %>" placeholder="City, country or activity"></div>
  <div><label for="city">City</label><select id="city" name="city"><option value="">All cities</option><% cities.filter(c => !f.region || (f.region === 'india') === (c.country === 'India')).forEach(c => { %><option value="<%= c.city %>" <%= c.city === f.city ? 'selected' : '' %>><%= c.city %><%= c.country !== 'India' ? `, ${c.country}` : '' %> (<%= c.n %>)</option><% }) %></select></div>
  <div><label for="category">Category</label><select id="category" name="category"><option value="">All</option><% categories.forEach(c => { %><option <%= c === f.category ? 'selected' : '' %>><%= c %></option><% }) %></select></div>
  <button class="btn btn-primary">Filter</button>
  <% if (f.q || f.city || f.category) { %><a class="btn btn-ghost" href="<%= qs({ q: '', city: '', category: '' }) %>">Clear</a><% } %>
</form>
<% if (!activities.length) { %><div class="card empty"><span class="big">🎟</span>No activities match your search.</div><% } %>
<div class="pkg-grid">
  <% activities.forEach(a => { %>
    <a class="pkg" href="/agent/activities/<%= a.id %>" style="color:inherit;text-decoration:none">
      <img src="<%= cover({ image_url: a.image_url, destination: a.city }) %>" alt="" loading="lazy">
      <div class="body">
        <div class="meta"><span class="badge info"><%= a.category %></span> <%= a.city %><%= a.country !== 'India' ? `, ${a.country}` : '' %> · <%= a.duration %></div>
        <h3><%= a.title %></h3>
        <p class="muted" style="font-size:13px;margin:0"><%= a.summary %></p>
        <div class="price">
          <div><small class="muted">Net <%= a.price_basis === 'per_group' ? `per group of ${a.group_size}` : 'per adult' %></small><br><b><%= inr(a.net_adult) %></b></div>
          <div class="num"><small class="muted">You earn pp</small><br><span class="profit"><%= inr(a.sell - a.net) %></span></div>
        </div>
      </div>
    </a>
  <% }) %>
</div>
