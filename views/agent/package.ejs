<%
  const o = calc.options;
  const vaayuLines = calc.lines.filter(l => l.supplier === 'vaayu');
  const ownLines = calc.lines.filter(l => l.supplier === 'agent');
  const markup = priced.vaayuSell - priced.net;
%>
<a href="/agent/packages"><%- icon('arrowLeft') %>My packages</a>
<div class="page-head" style="margin-top:10px">
  <div>
    <h1><%= pkg.title %></h1>
    <p><%= plural(pkg.nights, 'night') %> / <%= plural(pkg.nights + 1, 'day') %> · <%= pkg.destination %><%= pkg.theme ? ` · ${pkg.theme}` : '' %> ·
      <span class="badge <%= pkg.status === 'published' ? 'active' : '' %>"><%= pkg.status === 'published' ? 'On your website' : 'Draft' %></span>
      <% if (pkg.is_international) { %><span class="badge">International</span><% } %></p>
  </div>
  <div class="actions">
    <a class="btn btn-primary" href="/agent/packages/<%= pkg.id %>/edit">Edit package</a>
    <% if (pkg.status === 'published') { %>
      <form method="post" action="/agent/packages/<%= pkg.id %>/status"><input type="hidden" name="status" value="draft"><button class="btn">Unpublish</button></form>
    <% } else { %>
      <form method="post" action="/agent/packages/<%= pkg.id %>/status"><input type="hidden" name="status" value="published"><button class="btn btn-accent" <%= problems.length ? 'disabled' : '' %> title="<%= problems.join(' ') %>">Publish to my website</button></form>
    <% } %>
    <form method="post" action="/agent/packages/<%= pkg.id %>/duplicate"><button class="btn">Duplicate</button></form>
  </div>
</div>
<% if (problems.length && pkg.status !== 'published') { %>
  <div class="alert warn">To publish this package on your website: <%= problems.join(' ') %> <a href="/agent/packages/<%= pkg.id %>/edit">Edit package</a></div>
<% } %>
<% calc.warnings.forEach(w => { %><div class="alert warn"><%= w %> <a href="/agent/packages/<%= pkg.id %>/edit#items">Replace it</a></div><% }) %>
<% if (siteUrl) { %>
  <div class="share-bar">
    <span>Share with a customer: this package on <b>your website</b>, with your branding and prices.</span>
    <a class="btn btn-sm btn-wa" href="https://wa.me/?text=<%= encodeURIComponent(`${pkg.title} — ${pkg.nights}N/${pkg.nights + 1}D ${pkg.destination}, from ${inr(from.sell)} per person. Full itinerary: ${siteUrl}`) %>" target="_blank" rel="noopener">WhatsApp</a>
    <button class="btn btn-sm" type="button" data-copy="<%= siteUrl %>">Copy link</button>
  </div>
<% } %>

<div class="split">
  <div>
    <img src="<%= cover(pkg) %>" alt="" style="width:100%;max-height:320px;object-fit:cover;border-radius:14px;margin-bottom:20px">
    <div class="card">
      <% if (pkg.summary) { %><p style="font-size:15px"><%= pkg.summary %></p><% } %>
      <%- include('../partials/package-full', { p: view, showSource: true }) %>
    </div>
  </div>

  <div>
    <form class="card calc" method="get" action="/agent/packages/<%= pkg.id %>" style="position:sticky;top:76px">
      <h3>Price this trip</h3>
      <div class="field"><label for="date">Travel date</label><input id="date" type="date" min="<%= o.date && o.date < today ? o.date : today %>" name="date" value="<%= o.date %>"></div>
      <div class="row">
        <div class="field"><label for="adults">Adults</label><input id="adults" type="number" min="1" name="adults" value="<%= o.adults %>"></div>
        <div class="field"><label for="children">Children 2–11</label><input id="children" type="number" min="0" name="children" value="<%= o.children %>"></div>
        <div class="field"><label for="infants">Infants</label><input id="infants" type="number" min="0" name="infants" value="<%= o.infants %>"></div>
        <div class="field"><label for="rooms">Rooms</label><input id="rooms" type="number" min="1" name="rooms" value="<%= o.rooms %>"></div>
      </div>
      <button class="btn btn-primary" style="width:100%">Calculate price</button>

      <% if (calc.errors.length) { %>
        <div class="alert error" style="margin:14px 0 0;font-size:13px"><%= calc.errors.join(' ') %></div>
      <% } else if (!calc.lines.length) { %>
        <div class="alert info" style="margin:14px 0 0;font-size:13px">Nothing is priced yet. <a href="/agent/packages/<%= pkg.id %>/edit">Add VaayuTrip services or your own.</a></div>
      <% } else { %>
        <hr>
        <% if (vaayuLines.length) { %>
          <div class="muted" style="font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.04em">From VaayuTrip (net)</div>
          <table class="table" style="font-size:12.5px">
            <% vaayuLines.forEach(l => { %><tr><td style="padding:6px 0"><%= l.title %> <span class="muted">× <%= l.qty %></span></td><td class="num" style="padding:6px 0"><%= inr(l.net * l.qty) %></td></tr><% }) %>
          </table>
        <% } %>
        <% if (ownLines.length) { %>
          <div class="muted" style="font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;margin-top:10px">Your own hotels &amp; services (your price)</div>
          <table class="table" style="font-size:12.5px">
            <% ownLines.forEach(l => { %><tr><td style="padding:6px 0"><%= l.title %> <span class="muted">× <%= l.qty %></span></td><td class="num" style="padding:6px 0"><%= inr(l.sell * l.qty) %></td></tr><% }) %>
          </table>
        <% } %>
        <table class="totals" style="margin-top:8px">
          <tr><td class="muted">Net to VaayuTrip</td><td class="num"><b><%= inr(priced.net) %></b></td></tr>
          <tr><td class="muted">Your markup (<%= agency.markup_type === 'flat' ? inr(agency.markup_value) : agency.markup_value + '%' %>)</td><td class="num profit">+ <%= inr(markup) %></td></tr>
          <% if (ownLines.length) { %><tr><td class="muted">Your hotels &amp; services</td><td class="num">+ <%= inr(priced.agentItemsTotal) %></td></tr><% } %>
          <tr class="grand"><td>Selling price</td><td class="num"><%= inr(priced.sell) %></td></tr>
          <tr><td class="pp" colspan="2">≈ <%= inr(calc.pax ? priced.sell / calc.pax : 0) %> per person<%= gstOn ? ' · + GST' : '' %><%= pkg.is_international ? ' · + TCS' : '' %></td></tr>
          <% if (priced.agentCost) { %><tr><td class="muted">Your hotel &amp; service costs</td><td class="num">− <%= inr(priced.agentCost) %></td></tr><% } %>
          <tr><td><b>Your earning</b></td><td class="num profit"><b><%= inr(priced.commission) %></b></td></tr>
        </table>
      <% } %>
    </form>

    <% if (!calc.errors.length && calc.lines.length) { %>
      <form class="card" method="post" action="/agent/packages/<%= pkg.id %>/quote">
        <h3>Create quote</h3>
        <% ['date', 'adults', 'children', 'infants', 'rooms'].forEach(k => { %><input type="hidden" name="<%= k %>" value="<%= o[k] %>"><% }) %>
        <div class="field"><label for="customer_id">Customer</label>
          <select id="customer_id" name="customer_id"><option value="">Choose later</option><% customers.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select>
        </div>
        <button class="btn btn-accent btn-lg" style="width:100%">Create quote · <%= inr(priced.sell) %></button>
        <p class="muted" style="font-size:12.5px;margin:10px 0 0">You can still change any price, add more from VaayuTrip, and choose the invoice type in the quote. Your own hotels and services appear on your branded invoice.</p>
      </form>
    <% } %>
  </div>
</div>
<form method="post" action="/agent/packages/<%= pkg.id %>/delete" data-confirm="Delete this package? Quotes made from it keep their copy." style="margin-top:8px"><button class="btn btn-danger btn-sm">Delete package</button></form>
