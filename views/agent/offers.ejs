<div class="page-head"><div><h1>Offers &amp; deals</h1><p>Current promotions from VaayuTrip. Pass the savings on to customers, or keep them as extra margin.</p></div></div>
<% if (!offers.length) { %>
  <div class="card"><div class="empty"><span class="big"><%- icon('tag') %></span>No live offers right now. We'll notify you when new deals go live.</div></div>
<% } else { %>
  <div class="offers-grid">
    <% offers.forEach(o => { %><%- include('../partials/offer-card', { o }) %><% }) %>
  </div>
<% } %>
