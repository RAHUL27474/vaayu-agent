<div class="page-head"><div><h1>Transfers &amp; cabs</h1><p>Airport pick-ups, sightseeing cabs and intercity transfers.</p></div></div>
<form class="card" method="get">
  <div class="row">
    <div class="field"><label for="city">City</label><input id="city" name="city" value="<%= params.city %>" placeholder="e.g. Jaipur" required></div>
    <div class="field"><label for="kind">Type</label>
      <select id="kind" name="kind">
        <option value="airport" <%= params.kind === 'airport' ? 'selected' : '' %>>Airport transfer</option>
        <option value="fullday" <%= params.kind === 'fullday' ? 'selected' : '' %>>Full-day sightseeing</option>
        <option value="intercity" <%= params.kind === 'intercity' ? 'selected' : '' %>>Intercity transfer</option>
      </select>
    </div>
    <div class="field"><label for="pax">Passengers</label><input id="pax" type="number" min="1" name="pax" value="<%= params.pax || 2 %>"></div>
  </div>
  <button class="btn btn-primary">Search</button>
</form>
<% if (searched) { %>
  <div class="card flush">
    <% results.forEach(r => { %>
      <div class="result">
        <div class="grow"><b><%= r.title %></b><br><small><%= r.city %> · up to <%= r.seats %> passengers</small></div>
        <div class="fare"><b><%= inr(r.net) %></b><small class="muted">net</small></div>
        <%- include('../partials/add-to-quote', { kind, params, r, quotes }) %>
      </div>
    <% }) %>
  </div>
<% } %>
