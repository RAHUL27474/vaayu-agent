<div class="page-head"><div><h1>Leads</h1><p>Enquiries you add yourself, and those from your website when VaayuTrip builds one for you.</p></div></div>
<%
  const total = statuses.reduce((t, k) => t + Number(counts[k] || 0), 0);
  const closed = Number(counts.won || 0) + Number(counts.lost || 0);
  const winRate = closed ? Math.round(Number(counts.won || 0) / closed * 100) : null;
  const stages = [['new', 'New', 'target'], ['contacted', 'Contacted', 'phone'], ['quoted', 'Quoted', 'file'], ['won', 'Won', 'checkCircle']];
%>
<% if (total) { %>
<section class="funnel" aria-label="Leads by stage">
  <ol class="funnel-steps">
    <% stages.forEach(([k, label, ic], i) => { %>
      <li class="fs-<%= i %><%= status === k ? ' on' : '' %>"><a href="/agent/leads?status=<%= k %>"><span class="fs-ico"><%- icon(ic) %></span><span><b><%= counts[k] || 0 %></b><small><%= label %></small></span></a></li>
    <% }) %>
  </ol>
  <div class="funnel-sum"><b><%= winRate === null ? '—' : winRate + '%' %></b><small><%= winRate === null ? 'win rate once leads close' : `won of ${closed} closed lead${closed === 1 ? '' : 's'}` %></small><span><%= total %> lead<%= total === 1 ? '' : 's' %> · <%= counts.lost || 0 %> lost</span></div>
</section>
<% } %>
<div class="tabs">
  <a href="/agent/leads" class="<%= !status && !due ? 'active' : '' %>">All</a>
  <a href="/agent/leads?due=1" class="<%= due ? 'active' : '' %>">Follow-ups due <small class="<%= dueCount ? 'count-due' : 'muted' %>"><%= dueCount %></small></a>
  <% statuses.forEach(s => { %><a href="/agent/leads?status=<%= s %>" class="<%= status === s ? 'active' : '' %>" style="text-transform:capitalize"><%= s %> <small class="muted"><%= counts[s] || 0 %></small></a><% }) %>
</div>
<div class="split">
  <div class="card flush">
    <% if (!leads.length) { %><div class="empty"><span class="big"><%- icon('target') %></span>No leads here. Add one with the form.</div><% } else { %>
    <div class="table-wrap"><table class="table">
      <thead><tr><th>Lead</th><th>Trip</th><th>Status &amp; follow-up</th><th></th></tr></thead>
      <% leads.forEach(l => { %>
        <tr>
          <td><span class="cust"><span class="av" style="--h:<%= [...l.name].reduce((h, ch) => (h * 31 + ch.charCodeAt(0)) % 360, 7) %>"><%= l.name.split(/[\s&]+/).filter(Boolean).map((w) => w[0]).slice(0, 2).join('').toUpperCase() %></span><span><b><%= l.name %></b><br><small><%= l.phone || '' %> <%= l.email || '' %></small></span></span><br><span class="badge"><%= l.source %></span> <small class="muted"><%= fmtDate(l.created_at) %></small></td>
          <td><%= l.package_title || l.destination || '—' %><br><small><%= l.travel_date ? fmtDate(l.travel_date) : '' %><%= l.pax ? ` · ${l.pax} pax` : '' %><%= l.budget ? ` · budget ${inr(l.budget)}` : '' %></small><% if (l.notes) { %><br><small class="muted"><%= l.notes %></small><% } %></td>
          <td>
            <form method="post" action="/agent/leads/<%= l.id %>/status">
              <select name="status" onchange="this.form.submit()" aria-label="Status"><% statuses.forEach(s => { %><option value="<%= s %>" <%= l.status === s ? 'selected' : '' %>><%= s[0].toUpperCase() + s.slice(1) %></option><% }) %></select>
            </form>
            <% const overdue = l.follow_up_on && l.follow_up_on < today && !['won', 'lost'].includes(l.status); const isToday = l.follow_up_on === today; %>
            <details class="follow-up">
              <summary class="<%= overdue ? 'fu-overdue' : isToday ? 'fu-today' : '' %>"><%- icon('bell') %><%= l.follow_up_on ? `${overdue ? 'Overdue · ' : isToday ? 'Today · ' : ''}${fmtDate(l.follow_up_on)}` : 'Set follow-up' %></summary>
              <form method="post" action="/agent/leads/<%= l.id %>/follow-up">
                <label class="sr-only" for="fu-<%= l.id %>">Follow-up date</label>
                <input id="fu-<%= l.id %>" type="date" name="follow_up_on" value="<%= l.follow_up_on || '' %>">
                <label class="sr-only" for="fn-<%= l.id %>">What to discuss</label>
                <input id="fn-<%= l.id %>" name="follow_up_note" maxlength="200" placeholder="e.g. Send revised Bali quote" value="<%= l.follow_up_note || '' %>">
                <% if (staff.length > 1) { %><label class="sr-only" for="fa-<%= l.id %>">Assign to</label><select id="fa-<%= l.id %>" name="assigned_to"><option value="">Anyone</option><% staff.forEach(s => { %><option value="<%= s.id %>" <%= l.assigned_to === s.id ? 'selected' : '' %>><%= s.name %></option><% }) %></select><% } %>
                <button class="btn btn-sm">Save</button>
              </form>
            </details>
            <% if (l.follow_up_note) { %><small class="muted"><%= l.follow_up_note %><%= l.assignee ? ` · ${l.assignee}` : '' %></small><% } %>
          </td>
          <td class="num">
            <form method="post" action="/agent/leads/<%= l.id %>/quote"><button class="btn btn-sm btn-primary">Create quote</button></form>
            <% if (l.phone) { const d = l.phone.replace(/\D/g, ''); const first = l.name.split(/[\s&]+/)[0]; %><a class="btn btn-sm btn-wa" style="margin-top:6px" href="https://wa.me/<%= d.length === 10 ? '91' + d : d %>?text=<%- encodeURIComponent(`Hi ${first}, this is ${user.name.split(' ')[0]} from ${agency.name}. Thanks for your enquiry${l.destination ? ` about ${l.destination}` : ''}.`) %>" target="_blank" rel="noopener">WhatsApp <%= first %></a><% } %>
          </td>
        </tr>
      <% }) %>
    </table></div>
    <% } %>
  </div>
  <form class="card" method="post" action="/agent/leads">
    <h2 class="h3">Add lead</h2>
    <p class="muted" style="font-size:13px;margin:-4px 0 14px">A call, a WhatsApp or a walk-in: note it here so the follow-up isn't missed.</p>
    <div class="row">
      <div class="field"><label for="l-name">Name</label><input id="l-name" name="name" required placeholder="Customer or family name"></div>
      <div class="field"><label for="l-phone">Phone</label><input id="l-phone" name="phone" inputmode="tel" placeholder="+91"></div>
      <div class="field"><label for="l-email">Email</label><input id="l-email" type="email" name="email"></div>
    </div>
    <div class="row">
      <div class="field"><label for="l-dest">Destination</label><input id="l-dest" name="destination" placeholder="e.g. Bali"></div>
      <div class="field"><label for="l-pkg">Package <span class="muted">(optional)</span></label><select id="l-pkg" name="package_id"><option value="">—</option><% packages.forEach(p => { %><option value="<%= p.id %>"><%= p.title %></option><% }) %></select></div>
    </div>
    <div class="row">
      <div class="field"><label for="l-date">Travel date</label><input id="l-date" type="date" min="<%= today %>" name="travel_date"></div>
      <div class="field"><label for="l-pax">Pax</label><input id="l-pax" type="number" min="1" name="pax"></div>
      <div class="field"><label for="l-budget">Budget (₹)</label><input id="l-budget" type="number" min="0" name="budget"></div>
      <div class="field"><label for="l-fu">Follow up on <span class="muted">(optional)</span></label><input id="l-fu" type="date" min="<%= today %>" name="follow_up_on"></div>
    </div>
    <div class="field"><label for="l-notes">Notes</label><textarea id="l-notes" name="notes" rows="3" placeholder="What they asked for, hotel category, special requests…"></textarea></div>
    <button class="btn btn-primary">Add lead</button>
  </form>
</div>
