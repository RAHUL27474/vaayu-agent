<div class="page-head"><div><h1>Flights</h1><p>Domestic and international fares at agent net rates. Add any flight to a quote.</p></div></div>
<form class="card" method="get">
  <div class="row">
    <div class="field"><label for="from">From</label><select id="from" name="from"><% Object.entries(cities).forEach(([c, n]) => { %><option value="<%= c %>" <%= (params.from || 'DEL') === c ? 'selected' : '' %>><%= n %> (<%= c %>)</option><% }) %></select></div>
    <div class="field"><label for="to">To</label><select id="to" name="to"><% Object.entries(cities).forEach(([c, n]) => { %><option value="<%= c %>" <%= (params.to || 'GOI') === c ? 'selected' : '' %>><%= n %> (<%= c %>)</option><% }) %></select></div>
    <div class="field"><label for="date">Date</label><input id="date" type="date" name="date" value="<%= params.date %>" required></div>
    <div class="field"><label for="adults">Adults</label><input id="adults" type="number" min="1" name="adults" value="<%= params.adults || 2 %>"></div>
    <div class="field"><label for="children">Children</label><input id="children" type="number" min="0" name="children" value="<%= params.children || 0 %>"></div>
  </div>
  <button class="btn btn-primary">Search flights</button>
  <a class="btn btn-ghost" href="/agent/flights?from=DEL&to=GOI&date=<%= new Date(Date.now() + 864e5 * 21).toISOString().slice(0, 10) %>&adults=2&children=0">Try a sample search</a>
</form>

<% if (searched) { %>
  <div class="card flush">
    <div class="card-head" style="padding-bottom:12px"><h3><%= results.length %> flights · <%= cities[params.from] %> → <%= cities[params.to] %></h3><span class="muted">Sample inventory</span></div>
    <% results.forEach(r => { %>
      <div class="result">
        <div style="min-width:130px"><b><%= r.airline %></b><br><small><%= r.flightNo %></small></div>
        <div class="grow timeline">
          <div><div class="t"><%= r.depart %></div><small><%= r.from %></small></div>
          <div class="line"><%= r.duration %><br><%= r.stops ? '1 stop' : 'Non-stop' %></div>
          <div><div class="t"><%= r.arrive %></div><small><%= r.to %></small></div>
        </div>
        <div><small><%= r.baggage %> · <%= r.refundable ? 'Refundable' : 'Non-refundable' %></small></div>
        <div class="fare"><b><%= inr(r.net) %></b><small class="muted"><%= inr(r.farePerPax) %> × <%= r.pax %> pax, net</small></div>
        <%- include('../partials/add-to-quote', { kind, params, r, quotes }) %>
      </div>
    <% }) %>
  </div>
<% } %>
