<div class="page-head"><div><h1>Wallet &amp; credit</h1><p>Bookings are paid from your wallet first, then your credit line.</p></div>
  <div class="actions"><a class="btn" href="/agent/wallet/statement"><%- icon('file') %>Account statement</a></div></div>
<div class="grid grid-3" style="margin-bottom:20px">
  <div class="stat"><div class="label">Wallet balance</div><div class="value"><%= inr(agency.wallet_balance, { decimals: 2 }) %></div></div>
  <div class="stat"><div class="label">Credit used</div><div class="value"><%= inr(agency.credit_used, { decimals: 2 }) %></div><div class="sub">of <%= inr(agency.credit_limit) %> limit<% if (credit.dueOn) { %> · <span class="<%= credit.overdue ? 'bad' : credit.daysLeft <= 3 ? 'warn-text' : '' %>"><%= credit.overdue ? 'overdue since' : 'due' %> <%= fmtDate(credit.dueOn) %></span><% } %></div></div>
  <div class="stat"><div class="label">Available to book</div><div class="value"><%= inr(agency.wallet_balance + agency.credit_limit - agency.credit_used) %></div></div>
</div>
<% if (credit.dueOn) { %>
  <form class="card credit-due <%= credit.overdue ? 'overdue' : '' %>" method="post" action="/agent/wallet/repay" data-confirm="Repay credit from your wallet?">
    <div>
      <h3><%= credit.overdue ? 'Credit overdue' : 'Credit due' %>: <%= inr(agency.credit_used, { decimals: 2 }) %></h3>
      <p class="muted" style="margin:4px 0 0;font-size:13px"><%= credit.overdue ? `Was due on ${fmtDate(credit.dueOn)}. New bookings can't use credit until it's repaid.` : `Due on ${fmtDate(credit.dueOn)} (${credit.daysLeft ? `${credit.daysLeft} day${credit.daysLeft === 1 ? '' : 's'} left` : 'today'}). Credit is repaid from your wallet.` %></p>
    </div>
    <div class="credit-pay">
      <label class="sr-only" for="repay-amt">Amount to repay</label>
      <input id="repay-amt" type="number" min="1" step="0.01" name="amount" value="<%= Math.min(agency.credit_used, Math.max(agency.wallet_balance, 0)).toFixed(2) %>">
      <button class="btn <%= credit.overdue ? 'btn-danger' : 'btn-primary' %>" <%= agency.wallet_balance <= 0 ? 'disabled title="Add money to your wallet first"' : '' %>>Repay from wallet</button>
    </div>
  </form>
<% } %>
<div class="split">
  <div class="card flush">
    <div class="card-head"><h3>Transactions</h3><a class="btn btn-sm" href="/agent/wallet/statement">Statement (PDF)</a></div>
    <% if (!txns.length) { %><div class="empty">No transactions yet.</div><% } else { %>
    <div class="table-wrap"><table class="table" style="margin-top:10px">
      <thead><tr><th>Date</th><th>Details</th><th class="num">Amount</th><th class="num">Balance</th></tr></thead>
      <% txns.forEach(t => { %>
        <tr><td class="nowrap"><%= fmtDate(t.created_at) %></td><td><span class="badge"><%= ({ topup: 'Top-up', booking: 'Booking', refund: 'Refund', adjustment: 'Adjustment', credit_repay: 'Credit repaid' })[t.type] || t.type %></span> <%= t.note || '' %><br><small><%= t.ref || '' %></small></td>
        <td class="num nowrap" style="color:<%= t.amount < 0 ? 'var(--bad)' : 'var(--ok)' %>"><%= t.amount < 0 ? '−' : '+' %><%= inr(Math.abs(t.amount), { decimals: 2 }) %></td><td class="num nowrap"><%= inr(t.balance_after, { decimals: 2 }) %></td></tr>
      <% }) %>
    </table></div>
    <% } %>
  </div>
  <div>
    <% if (phonepeOn) { %>
    <form class="card" method="post" action="/agent/wallet/topup">
      <h3>Add money instantly</h3>
      <p class="muted" style="font-size:13px">Pay by UPI, card or netbanking through PhonePe. Your wallet is credited as soon as the payment succeeds.</p>
      <input type="hidden" name="method" value="phonepe">
      <div class="field"><label for="pp-amount">Amount (₹)</label><input id="pp-amount" type="number" min="100" step="1" name="amount" required></div>
      <button class="btn btn-accent" style="width:100%" <%= agency.status !== 'active' ? 'disabled' : '' %>>Pay with PhonePe</button>
    </form>
    <% } %>
    <form class="card" method="post" action="/agent/wallet/topup">
      <h3><%= phonepeOn ? 'Or pay by bank transfer' : 'Add money' %></h3>
      <p class="muted" style="font-size:13px">Transfer to VaayuTrip by NEFT/IMPS/UPI, then submit the reference number. We credit your wallet after verification.</p>
      <% if (settings.bank_details) { %><div class="alert info" style="font-size:13px;white-space:pre-line">A/c: <b><%= settings.legal_name %></b>
<%= settings.bank_details %></div><% } else { %><div class="alert warn" style="font-size:13px">Ask VaayuTrip support for our bank details before transferring.</div><% } %>
      <div class="field"><label for="amount">Amount (₹)</label><input id="amount" type="number" min="100" name="amount" required></div>
      <div class="field"><label for="utr">UTR / reference no.</label><input id="utr" name="utr" required minlength="6" maxlength="40" autocomplete="off" spellcheck="false" placeholder="e.g. 412345678901"><small class="muted">From your bank app. Each transfer can be credited once.</small></div>
      <button class="btn btn-primary" <%= agency.status !== 'active' ? 'disabled' : '' %>>Submit top-up</button>
    </form>
    <form class="card" method="post" action="/agent/wallet/alert">
      <h3>Low-balance alert</h3>
      <p class="muted" style="font-size:13px">We notify you when your wallet drops below this amount. 0 switches it off.</p>
      <div style="display:flex;gap:8px"><label class="sr-only" for="lba">Alert below (₹)</label><input id="lba" type="number" min="0" step="500" name="low_balance_alert" value="<%= agency.low_balance_alert %>"><button class="btn">Save</button></div>
    </form>
    <% if (requests.length) { %>
      <div class="card flush"><div class="card-head"><h3>Top-up requests</h3></div>
        <table class="table" style="margin-top:10px"><% requests.forEach(r => { %><tr><td><%= fmtDate(r.created_at) %><br><small><%= r.method === 'phonepe' ? (r.status === 'pending' ? 'PhonePe · processing' : r.utr || 'PhonePe') : r.utr %></small></td><td class="num"><%= inr(r.amount) %></td><td><span class="badge <%= r.status %>"><%= r.status %></span></td></tr><% }) %></table>
      </div>
    <% } %>
  </div>
</div>
