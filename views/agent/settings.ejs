<div class="page-head"><div><h1>Company &amp; branding</h1><p>Used on your invoices, quotes, website and payment pages.</p></div></div>
<form method="post" action="/agent/settings" enctype="multipart/form-data">
  <div class="split">
    <div>
      <div class="card">
        <h3>Company</h3>
        <div class="row">
          <div class="field"><label for="name">Brand name</label><input id="name" name="name" value="<%= agency.name %>" required></div>
          <div class="field"><label for="legal_name">Legal name</label><input id="legal_name" name="legal_name" value="<%= agency.legal_name || '' %>" placeholder="As registered"></div>
        </div>
        <div class="row">
          <div class="field"><label for="pan">PAN</label><input id="pan" name="pan" value="<%= agency.pan || '' %>"></div>
        </div>
        <div class="row">
          <div class="field"><label for="phone">Phone</label><input id="phone" name="phone" value="<%= agency.phone || '' %>"></div>
          <div class="field"><label for="email">Email</label><input id="email" type="email" name="email" value="<%= agency.email || '' %>"></div>
        </div>
        <div class="field"><label for="address">Address</label><input id="address" name="address" value="<%= agency.address || '' %>"></div>
        <div class="field"><label for="bank_details">Bank details for your invoices</label><textarea id="bank_details" name="bank_details" rows="3" maxlength="500" placeholder="Bank, account name and number, IFSC, UPI ID"><%= agency.bank_details || '' %></textarea><div class="hint">Printed on your branded invoices so customers can pay you.</div></div>
        <div class="field"><label for="city">City</label><input id="city" name="city" value="<%= agency.city || '' %>"></div>
      </div>
      <div class="card">
        <h3>Default commission</h3>
        <p class="muted" style="font-size:13px">Applied to new quotes, your website and API prices. You can change it on any quote.</p>
        <div class="row">
          <div class="field"><label for="markup_type">Type</label><select id="markup_type" name="markup_type"><option value="percent" <%= agency.markup_type === 'percent' ? 'selected' : '' %>>Percent of net</option><option value="flat" <%= agency.markup_type === 'flat' ? 'selected' : '' %>>Flat ₹ per booking</option></select></div>
          <div class="field"><label for="markup_value">Value</label><input id="markup_value" type="number" min="0" step="0.5" name="markup_value" value="<%= agency.markup_value %>"></div>
        </div>
        <div class="kind-markups">
          <b>Default by service</b>
          <p class="muted" style="font-size:12.5px;margin:2px 0 10px">Your usual markup for each service, as a % of net or a ₹ amount. Leave a service empty to use the default above. On any quote you can keep these or set your own.</p>
          <% Object.entries(kinds).forEach(([k, c]) => { const r = kindMarkups(agency)[k]; %>
            <div class="kind-row">
              <span class="kind-name"><%- icon(c.icon) %><%= c.plural %></span>
              <select name="markup_type_<%= k %>" aria-label="<%= c.plural %>: % or ₹"><option value="percent" <%= !r || r.type === 'percent' ? 'selected' : '' %>>%</option><option value="flat" <%= r && r.type === 'flat' ? 'selected' : '' %>>₹</option></select>
              <input name="markup_<%= k %>" type="number" min="0" step="0.5" value="<%= r ? r.value : '' %>" placeholder="Default" aria-label="<%= c.plural %> markup">
            </div>
          <% }) %>
        </div>
      </div>
    </div>
    <div>
      <div class="card">
        <h3>Branding</h3>
        <div class="field">
          <label>Logo</label>
          <div style="border:1px dashed #cbd5e1;border-radius:10px;padding:16px;text-align:center;margin-bottom:10px;background:#fafbfd">
            <% if (agency.logo_path) { %><img src="<%= agency.logo_path %>" alt="Logo" style="max-height:64px"><% } else { %><span class="muted">No logo yet</span><% } %>
          </div>
          <input type="file" name="logo" accept="image/png,image/jpeg,image/webp" aria-label="Company logo (PNG, JPG or WebP)">
          <div class="hint">PNG, JPG or WebP, up to 2 MB. A wide logo on a transparent background works best.</div>
          <% if (agency.logo_path) { %><label class="check" style="margin-top:8px"><input type="checkbox" name="remove_logo" value="1"> Remove logo</label><% } %>
        </div>
        <div class="field"><label for="brand_color">Brand colour</label><input id="brand_color" type="color" name="brand_color" value="<%= agency.brand_color || '#0e7490' %>"></div>
        <div class="alert <%= branded ? 'success' : 'info' %>" style="font-size:13px">
          <%= branded ? 'Branded invoices are on: customers can receive invoices under your name and logo.' : "Add a logo to issue invoices under your own brand. Until then, customers get VaayuTrip invoices that include your commission." %>
        </div>
      </div>
      <div class="card">
        <h3>Verification</h3>
        <dl class="kv">
          <dt>Account</dt><dd><span class="badge <%= agency.status %>"><%= agency.status %></span></dd>
          <dt>KYC</dt><dd><span class="badge <%= agency.kyc_status %>"><%= agency.kyc_status %></span></dd>
          <dt>Documents</dt><dd><%= missing.length ? 'Missing: ' + missing.join(', ') : 'All received' %></dd>
        </dl>
        <% if (missing.length) { %><p class="muted" style="font-size:13px;margin:8px 0 0"><a href="#tax">Upload your KYC documents</a> so we can approve your agency.</p><% } %>
      </div>
      <button class="btn btn-primary btn-lg" style="width:100%">Save changes</button>
    </div>
  </div>
</form>

<% const india = (agency.country || 'India') === 'India'; %>
<form method="post" action="/agent/settings/tax" enctype="multipart/form-data" class="card" id="tax" style="margin-top:20px">
  <div class="card-head">
    <h3>Verification (KYC)</h3>
    <span class="badge <%= agency.kyc_status %>">KYC <%= agency.kyc_status %></span>
  </div>
  <% if (missing.length) { %>
    <div class="alert warn"><%- icon('xCircle') %><span>Still needed before we can approve you: <b><%= missing.join(', ') %></b>.</span></div>
  <% } else if (agency.kyc_status !== 'verified') { %>
    <div class="alert info"><%- icon('checkCircle') %><span>All documents received. Our team is reviewing them.</span></div>
  <% } %>
  <p class="muted" style="font-size:13px">Changing any of these sends your KYC back for review. PDF, JPG or PNG, up to 5 MB each; only VaayuTrip's team can see them.</p>
  <div class="row">
    <div class="field">
      <label for="country">Country of registration</label>
      <select id="country" name="country" data-tax-country>
        <% countries.forEach(c => { %><option <%= (agency.country || 'India') === c ? 'selected' : '' %>><%= c %></option><% }) %>
      </select>
    </div>
    <div class="field" data-tax-india<%= india ? '' : ' hidden' %>>
      <label for="gstin">GSTIN</label>
      <input id="gstin" name="gstin" value="<%= agency.gstin || '' %>" maxlength="15" placeholder="27ABCDE1234F1Z5" style="text-transform:uppercase" autocomplete="off">
    </div>
    <div class="field" data-tax-foreign<%= india ? ' hidden' : '' %>>
      <label for="tax_id">Company tax ID</label>
      <input id="tax_id" name="tax_id" value="<%= agency.tax_id || '' %>" maxlength="40" placeholder="e.g. VAT / TRN / EIN / ABN" autocomplete="off">
    </div>
  </div>
  <div class="doc-grid">
    <label class="doc-drop<%= agency.tax_doc ? ' on-file' : '' %>" for="tax_doc">
      <span class="d-ico"><%- icon(agency.tax_doc ? 'checkCircle' : 'file') %></span>
      <b><span data-tax-india<%= india ? '' : ' hidden' %>>GST certificate</span><span data-tax-foreign<%= india ? ' hidden' : '' %>>Tax certificate</span></b>
      <small data-file-name><%= agency.tax_doc ? 'On file · choose to replace' : 'Choose file' %></small>
      <input id="tax_doc" type="file" name="tax_doc" accept="application/pdf,image/png,image/jpeg,image/webp"<%= agency.tax_doc ? '' : ' required' %>>
    </label>
    <label class="doc-drop<%= agency.pan_doc ? ' on-file' : '' %>" for="pan_doc" data-tax-india<%= india ? '' : ' hidden' %>>
      <span class="d-ico"><%- icon(agency.pan_doc ? 'checkCircle' : 'passport') %></span>
      <b>PAN card</b>
      <small data-file-name><%= agency.pan_doc ? 'On file · choose to replace' : 'Choose file' %></small>
      <input id="pan_doc" type="file" name="pan_doc" accept="application/pdf,image/png,image/jpeg,image/webp" data-required-india<%= agency.pan_doc ? ' data-on-file="1"' : '' %><%= india && !agency.pan_doc ? ' required' : '' %>>
    </label>
    <label class="doc-drop photo-drop<%= agency.photo ? ' on-file' : '' %>" for="photo">
      <span class="d-ico"><img data-photo-preview alt="" hidden><%- icon(agency.photo ? 'checkCircle' : 'user') %></span>
      <b>Your photo</b>
      <small data-file-name><%= agency.photo ? 'On file · choose to replace' : 'Clear, front-facing photo' %></small>
      <input id="photo" type="file" name="photo" accept="image/png,image/jpeg,image/webp" capture="user"<%= agency.photo ? '' : ' required' %>>
    </label>
  </div>
  <button class="btn btn-primary">Save verification details</button>
</form>
