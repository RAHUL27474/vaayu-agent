<%
  const locked = ['booked', 'cancelled'].includes(quote.status);
  const markupLabel = quote.markup_type === 'flat' ? `${inr(quote.markup_value)} flat` : `${quote.markup_value}%`;
  // Per-service rules in force, e.g. "hotels 8%, transfers ₹500, others 12%".
  const byKind = kindMarkups(quote);
  const kindLabel = Object.keys(byKind).length ? Object.entries(byKind).map(([k, r]) => `${kinds[k].plural.toLowerCase()} ${r.type === 'flat' ? inr(r.value) : r.value + '%'}`).join(', ') + `, others ${markupLabel}` : '';
%>
<% const viewOnly = Boolean(user && user.agency_role === 'accounts'); const editLocked = locked || viewOnly; %>
<a href="/agent/quotes"><%- icon('arrowLeft') %>All quotes</a>
<div class="page-head" style="margin-top:10px">
  <div>
    <h1><%= quote.title %></h1>
    <p><%= quote.code %> · <span class="badge <%= quote.status %>"><%= quote.status %></span><%= customer ? ` · ${customer.name}` : '' %><%= quote.travel_date ? ` · ${fmtDate(quote.travel_date)}` : '' %></p>
  </div>
  <div class="actions">
    <a class="btn btn-primary" href="/agent/quotes/<%= quote.id %>/pdf" target="_blank"><%- icon('download') %>Quote PDF</a>
    <% if (!viewOnly) { %><form method="post" action="/agent/quotes/<%= quote.id %>/duplicate"><button class="btn" title="Make a new draft with the same services">Duplicate</button></form>
    <% if (quote.status === 'draft') { %><form method="post" action="/agent/quotes/<%= quote.id %>/send"><button class="btn">Mark as sent</button></form><% } %>
    <% if (['draft', 'sent'].includes(quote.status)) { %><form method="post" action="/agent/quotes/<%= quote.id %>/accepted"><button class="btn">Customer accepted</button></form><% } %><% } %>
    <% if (!locked) { %>
<% const cantBook = agency.status !== 'active' || !items.length || profileGaps.length; %>
      <% if (!approval.valid) { %>
        <% if (approval.status === 'requested') { %>
          <form method="post" action="/agent/quotes/<%= quote.id %>/withdraw-request" data-confirm="Withdraw this booking request?"><button class="btn">Withdraw request</button></form>
          <span class="btn btn-accent is-waiting" aria-disabled="true"><%- icon('clock') %>Waiting for VaayuTrip approval</span>
        <% } else { %>
          <a class="btn btn-accent<%= cantBook ? ' disabled' : '' %>" href="#request-booking" <%- cantBook ? 'aria-disabled="true"' : '' %>><%- icon('clipboard') %><%= approval.status ? 'Send booking request again' : 'Send booking request' %></a>
        <% } %>
      <% } else { %>
      <% if (phonepeOn) { %>
      <form method="post" action="/agent/quotes/<%= quote.id %>/pay-online" data-confirm="Pay <%= inr(netPayable.total) %> <%= netPayable.tax ? '(net + GST) ' : '' %>online by UPI, card or net banking? The booking is confirmed as soon as the payment goes through.">
        <button class="btn" <%= cantBook ? 'disabled' : '' %> title="UPI, debit / credit card or net banking, through PhonePe"><%- icon('card') %>Pay online · UPI / card</button>
      </form>
      <% } %>
      <form method="post" action="/agent/quotes/<%= quote.id %>/book" data-confirm="Book now? <%= inr(netPayable.total) %> <%= netPayable.tax ? '(net + GST) ' : '' %>will be paid to VaayuTrip from your wallet/credit.">
        <button class="btn btn-accent" <%= cantBook ? 'disabled' : '' %> <%- profileGaps.length ? `title="Complete your company profile first"` : '' %>>Book from <%= agency.credit_limit > 0 ? "wallet / credit" : "wallet" %> · <%= inr(netPayable.total) %></button>
      </form>
      <% } %>
    <% } else if (booking) { %>
      <a class="btn btn-primary" href="/agent/bookings/<%= booking.id %>">View booking <%= booking.code %></a>
    <% } %>
  </div>
</div>

<% if (approval.needed && !locked) { const untilTxt = approval.until ? new Date(String(approval.until).replace(' ', 'T') + 'Z').toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit', timeZone: 'Asia/Kolkata' }) : ''; %>
  <% if (approval.valid) { %>
    <div class="alert success appr"><%- icon('checkCircle') %><span><b>Approved by VaayuTrip operations.</b> Pay by <%= untilTxt %> to book it at this price.<%= approval.note ? ` Note: ${approval.note}` : '' %></span></div>
  <% } else if (approval.status === 'requested') { %>
    <div class="alert info appr"><%- icon('clock') %><span><b>Booking request sent.</b> VaayuTrip operations are confirming availability. You will get a notification when it is approved; you can pay then.</span></div>
  <% } else { %>
    <section class="card appr-card" id="request-booking">
      <% if (approval.status === 'rejected') { %><div class="alert error"><b>Not approved:</b> <%= approval.note %></div>
      <% } else if (approval.changed) { %><div class="alert warn">This quote changed after it was approved. Send it again for a fresh approval.</div>
      <% } else if (approval.expired) { %><div class="alert warn">The approval expired on <%= untilTxt %>. Send the request again.</div><% } %>
      <form method="post" action="/agent/quotes/<%= quote.id %>/request-booking" class="appr-form">
        <div>
          <h2 class="h3">Ready to book? Send a booking request</h2>
          <p class="muted">VaayuTrip operations confirm availability and rates for <%= inr(netPayable.total) %><%= netPayable.tax ? ' (net + GST)' : '' %>. Once approved, you pay by wallet<%= phonepeOn ? ', credit or online' : ' or credit' %> and the booking is confirmed.</p>
          <label for="req-note" class="sr-only">Note for operations</label>
          <textarea id="req-note" name="note" rows="2" maxlength="500" placeholder="Anything operations should know (optional): room preference, flight timing…"></textarea>
        </div>
        <button class="btn btn-accent btn-lg" <%= agency.status !== 'active' || !items.length || profileGaps.length ? 'disabled' : '' %>><%- icon('clipboard') %>Send booking request</button>
      </form>
    </section>
  <% } %>
<% } %>
<% if (typeof payingOnline !== 'undefined' && payingOnline && !locked) { %><div class="alert info">PhonePe is still confirming your online payment for this quote. The booking will be made automatically once it goes through; please don't pay again.</div><% } %>
<% if (profileGaps.length && !locked) { %><div class="alert warn">You can't book yet: complete your company profile first (missing: <%= profileGaps.join(', ') %>). <a href="/agent/settings">Go to Company &amp; branding</a></div><% } %>
<div class="split">
  <div>
    <form class="card flush" id="items" method="post" action="/agent/quotes/<%= quote.id %>/items">
      <div class="card-head"><h2 class="h3">Items &amp; your prices</h2><span class="muted">Leave "Your price" blank to use your markup: <%= kindLabel || markupLabel %></span></div>
      <div class="table-wrap" style="margin-top:10px">
        <table class="table">
          <thead><tr><th>Item</th><th class="num">Net</th><th class="num" style="width:130px">Your price</th><th class="num" style="width:86px">Qty</th><th class="num">Total</th><th class="num">You earn</th><th></th></tr></thead>
          <tbody>
            <% if (!priced.lines.length) { %><tr><td colspan="7" class="empty">No items yet. Add an airfare, hotel, activity or transfer from VaayuTrip, or your own service below.</td></tr><% } %>
            <% priced.lines.forEach(l => { %>
              <tr>
                <td>
                  <b><%= l.title %></b>
                  <% if (l.description) { %><br><small><%= l.description %></small><% } %>
                  <br><span class="badge <%= l.supplier === 'agent' ? 'info' : '' %>" style="margin-top:4px"><%= l.supplier === 'agent' ? 'Your service' : l.type %></span>
                </td>
                <td class="num"><% if (l.supplier === 'agent') { %><%= l.cost ? inr(l.cost) : '—' %><% if (l.cost) { %><br><small class="muted">your cost</small><% } %><% } else { %><%= inr(l.unitNet) %><% } %></td>
                <td class="num">
                  <% if (editLocked) { %><%= inr(l.unitSell) %><% } else { %>
                  <input type="number" step="1" min="<%= l.supplier === 'agent' ? 0 : l.unitNet %>" name="sell_<%= l.id %>" aria-label="Price per unit for <%= l.title %>" value="<%= l.overridden || l.supplier === 'agent' ? l.unitSell : '' %>" placeholder="<%= Math.round(l.unitSell) %>" style="text-align:right">
                  <% } %>
                </td>
                <td class="num"><% if (editLocked) { %><%= l.qty %><% } else { %><input type="number" min="1" name="qty_<%= l.id %>" aria-label="Quantity for <%= l.title %>" value="<%= l.qty %>" style="text-align:right"><% } %></td>
                <td class="num"><b><%= inr(l.lineSell) %></b></td>
                <td class="num profit"><%= inr(l.commission) %></td>
                <td class="num"><% if (!editLocked) { %><button class="btn btn-ghost btn-sm btn-danger" formnovalidate formaction="/agent/quotes/<%= quote.id %>/items/<%= l.id %>/delete" data-confirm="Remove &quot;<%= l.title %>&quot; from this quote?" title="Remove" aria-label="Remove">✕</button><% } %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if (!editLocked && priced.lines.length) { %><div style="padding:12px 20px;border-top:1px solid var(--line-2);text-align:right"><button class="btn btn-primary">Update prices</button></div><% } %>
    </form>

    <% if (!editLocked) { %>
      <div class="grid grid-2">
        <form class="card" method="post" action="/agent/quotes/<%= quote.id %>/items/custom">
          <h2 class="h3">Add your own service</h2>
          <p class="muted" style="font-size:13px">Hotel you book, guide, visa help, decoration… Billed only on your branded invoice. Add what it costs you to see your real earning.</p>
          <div class="field"><label for="c-title">Service</label><input id="c-title" name="title" required placeholder="e.g. Private photographer, 2 hours"></div>
          <div class="field"><label for="c-desc">Details</label><input id="c-desc" name="description"></div>
          <div class="row">
            <div class="field"><label for="c-price">Your price</label><input id="c-price" type="number" min="0" name="price" required></div>
            <div class="field"><label for="c-cost">Your cost <span class="muted">(private)</span></label><input id="c-cost" type="number" min="0" name="cost" placeholder="0"></div>
            <div class="field"><label for="c-qty">Qty</label><input id="c-qty" type="number" min="1" name="qty" value="1"></div>
          </div>
          <button class="btn">Add service</button>
        </form>
        <div class="card">
          <h2 class="h3">Add from VaayuTrip</h2>
          <p class="muted" style="font-size:13px">Open any item, then choose this quote under "Add to a quote".</p>
          <div class="grid grid-2" style="gap:10px">
            <a class="btn" href="/agent/flights"><%- icon('plane') %>Airfares</a>
            <a class="btn" href="/agent/hotels"><%- icon('bed') %>Hotels</a>
            <a class="btn" href="/agent/activities"><%- icon('ticket') %>Activities</a>
            <a class="btn" href="/agent/transfers"><%- icon('car') %>Transfers</a>
            <a class="btn" href="/agent/visas"><%- icon('passport') %>Visas</a>
            <a class="btn" href="/agent/insurance"><%- icon('shield') %>Insurance</a>
          </div>
        </div>
      </div>
    <% } %>

    <% if (pkgView) { %>
      <details class="card more" style="padding:16px 20px">
        <summary>Package details shown to the customer · <%= pkgView.party.rooms %> room<%= pkgView.party.rooms > 1 ? 's' : '' %><%= pkgView.party.category ? ` · ${pkgView.party.category}` : '' %></summary>
        <div style="margin-top:14px"><%- include('../partials/package-full', { p: pkgView, showSource: true, showCategory: pkgView.party.category }) %></div>
      </details>
    <% } %>

    <div class="card" id="share">
<%
        const cName = customer ? customer.name : (quote.title.split(' — ')[1] || '');
        const cFirst = cName.split(/[\s&]+/).filter(Boolean)[0] || '';
        const cDigits = customer && customer.phone ? customer.phone.replace(/\D/g, '') : '';
        const cWa = cDigits.length === 10 ? '91' + cDigits : cDigits;
        const waText = `Hi ${cFirst || 'there'}, here is your quote for ${quote.title.split(' — ')[0]}${quote.travel_date ? ` (${fmtDate(quote.travel_date)})` : ''}. The PDF is attached. Happy to adjust anything. – ${user.name.split(' ')[0]}, ${agency.name}`;
      %>
      <div class="card-head"><h2 class="h3"><%= cName ? `For ${cName}` : 'For your customer' %></h2></div>
      <p class="muted" style="font-size:13px;margin:0 0 12px">Download the PDF with your logo, then send it<%= cFirst ? ` to ${cFirst}` : '' %> on WhatsApp or email. Payment is between you and your customer.</p>
      <div class="actions" style="flex-wrap:wrap">
        <a class="btn btn-primary" href="/agent/quotes/<%= quote.id %>/pdf" target="_blank"><%- icon('download') %>Quote PDF</a>
        <a class="btn btn-wa" href="https://wa.me/<%= cWa %>?text=<%- encodeURIComponent(waText) %>" target="_blank" rel="noopener"><%= cFirst && cWa ? `WhatsApp ${cFirst}` : 'Write on WhatsApp' %></a>
      </div>
      <p class="muted" style="font-size:12px;margin:10px 0 0">The message is ready with <%= cFirst ? cFirst + "'s" : 'the' %> name and trip; attach the PDF in WhatsApp.</p>
    </div>

    <div class="card flush">
      <div class="card-head"><h2 class="h3">Invoices</h2>
        <form method="post" action="/agent/quotes/<%= quote.id %>/invoice"><button class="btn btn-primary btn-sm" <%= agency.status !== 'active' || !items.length ? 'disabled' : '' %>>Issue <%= quote.invoice_mode === 'agent' ? 'my branded' : 'VaayuTrip' %> invoice</button></form>
      </div>
      <% if (!invoices.length) { %><div class="empty">No invoices yet.</div><% } else { %>
        <table class="table" style="margin-top:10px">
          <% invoices.forEach(i => { %>
            <tr class="click" data-href="/agent/invoices/<%= i.id %>"><td><b><%= i.number %></b><br><small><%= fmtDate(i.created_at) %></small></td>
            <td><%= { customer_agent: 'Your branded invoice', customer_vaayu: 'VaayuTrip invoice to customer', b2b: 'VaayuTrip → you (net)' }[i.kind] %></td><td class="num"><%= inr(i.total) %></td></tr>
          <% }) %>
        </table>
      <% } %>
    </div>
  </div>

  <div>
    <div class="card">
      <h2 class="h3">Summary</h2>
      <table class="totals">
        <tr><td class="muted">VaayuTrip net</td><td class="num"><%= inr(priced.net) %></td></tr>
        <tr><td class="muted">Your commission</td><td class="num profit">+ <%= inr(priced.vaayuCommission) %></td></tr>
        <% if (priced.agentItemsTotal) { %><tr><td class="muted">Your own services<%= priced.agentCost ? ` (cost ${inr(priced.agentCost)})` : '' %></td><td class="num">+ <%= inr(priced.agentItemsTotal) %></td></tr><% } %>
        <tr><td>Customer subtotal</td><td class="num"><%= inr(customerTotal.subtotal) %></td></tr>
        <% if (customerTotal.tax) { %><tr><td class="muted">GST <%= customerTotal.taxRate %>%</td><td class="num"><%= inr(customerTotal.tax) %></td></tr><% } %>
        <% if (customerTotal.tcs) { %><tr><td class="muted">TCS <%= customerTotal.tcsRate %>% (international)</td><td class="num"><%= inr(customerTotal.tcs) %></td></tr><% } %>
        <tr class="grand"><td>Customer pays</td><td class="num"><%= inr(customerTotal.total) %></td></tr>
      </table>
      <hr>
      <table class="totals" id="pay">
        <% if (coupon && coupon.discount > 0) { %>
          <tr><td class="muted">VaayuTrip net</td><td class="num"><%= inr(priced.net) %></td></tr>
          <tr><td class="profit">Offer <b><%= coupon.code %></b></td><td class="num profit">− <%= inr(coupon.discount) %></td></tr>
        <% } %>
        <tr><td>You pay VaayuTrip</td><td class="num"><b><%= inr(netPayable.total) %></b></td></tr>
        <% if (netPayable.tax) { %><tr><td class="muted" colspan="2" style="font-size:12px">Net <%= inr(netPayable.subtotal) %> + GST <%= inr(netPayable.tax) %></td></tr><% } %>
        <% if (priced.agentCost) { %><tr><td>You pay your suppliers</td><td class="num"><%= inr(priced.agentCost) %></td></tr><% } %>
        <tr><td><b>Your earning</b></td><td class="num profit" style="font-size:18px"><%= inr(priced.commission + (coupon ? coupon.discount : 0)) %></td></tr>
      </table>
      <% if (!locked) { %>
        <div class="coupon-box">
          <% if (coupon) { %>
            <div class="coupon-on <%= coupon.error ? 'bad' : '' %>">
              <span><%- icon(coupon.error ? 'xCircle' : 'checkCircle') %><b><%= coupon.code %></b> <%= coupon.error ? 'can’t be used' : `applied: ${inr(coupon.discount)} off` %></span>
              <form method="post" action="/agent/quotes/<%= quote.id %>/coupon/remove"><button class="link-btn">Remove</button></form>
            </div>
            <% if (coupon.error) { %><p class="coupon-err"><%= coupon.error %></p><% } %>
          <% } else { %>
            <form method="post" action="/agent/quotes/<%= quote.id %>/coupon" class="coupon-form">
              <label for="coupon-code">Offer code</label>
              <div><input id="coupon-code" name="code" maxlength="30" placeholder="Enter code" autocomplete="off" value="<%= couponTry ? couponTry.code : '' %>" required <%- couponTry ? 'aria-invalid="true" aria-describedby="coupon-why"' : '' %>><button class="btn">Apply</button></div>
              <% if (couponTry) { %><p class="coupon-err" id="coupon-why" role="alert"><%= couponTry.error %></p><% } %>
              <small class="muted">Applied before you pay: by wallet, credit or online. <a href="/agent/offers">See offers</a></small>
            </form>
          <% } %>
        </div>
      <% } else if (booking && booking.discount > 0) { %>
        <p class="coupon-used"><%- icon('checkCircle') %>Offer <b><%= booking.coupon_code %></b> saved you <%= inr(booking.discount) %> on this booking.</p>
      <% } %>
    </div>

    <% if (!viewOnly) { %>
    <form class="card" method="post" action="/agent/quotes/<%= quote.id %>">
      <h2 class="h3">Quote details</h2>
      <div class="field"><label for="title">Title</label><input id="title" name="title" value="<%= quote.title %>"></div>
      <div class="field"><label for="customer_id">Customer</label>
        <select id="customer_id" name="customer_id"><option value="">—</option><% customers.forEach(c => { %><option value="<%= c.id %>" <%= c.id === quote.customer_id ? 'selected' : '' %>><%= c.name %></option><% }) %></select>
        <div class="hint"><a href="/agent/customers">Add a new customer</a></div>
      </div>
      <div class="field"><label for="travel_date">Travel date</label><input id="travel_date" type="date" min="<%= quote.travel_date && quote.travel_date < today ? quote.travel_date : today %>" name="travel_date" value="<%= quote.travel_date || '' %>"></div>
      <div class="row">
        <div class="field"><label for="adults">Adults</label><input id="adults" type="number" min="1" name="adults" value="<%= quote.adults %>"></div>
        <div class="field"><label for="children">Children</label><input id="children" type="number" min="0" name="children" value="<%= quote.children %>"></div>
      </div>

      <h2 class="h3" style="margin-top:8px">Your commission</h2>
      <div class="row">
        <div class="field"><label for="markup_type">Markup</label>
          <select id="markup_type" name="markup_type" <%= locked ? 'disabled' : '' %>><option value="percent" <%= quote.markup_type === 'percent' ? 'selected' : '' %>>Percent of net</option><option value="flat" <%= quote.markup_type === 'flat' ? 'selected' : '' %>>Flat amount</option></select>
        </div>
        <div class="field"><label for="markup_value">Value</label><input id="markup_value" type="number" min="0" step="0.5" name="markup_value" value="<%= quote.markup_value %>" <%= locked ? 'disabled' : '' %>></div>
      </div>
      <div class="hint" style="margin:-6px 0 14px">Applies to lines without your own price.</div>
        <div class="kind-markups">
          <b>By service</b>
          <p class="muted" style="font-size:12.5px;margin:2px 0 10px">Ticked: your default for that service. Untick to set this quote's own % or ₹ (a ₹ amount is spread over that service's lines).</p>
          <% Object.entries(kinds).forEach(([k, c]) => {
               const mine = kindMarkups(quote)[k]; const custom = Boolean(mine && mine.custom); const def = agencyRates[k];
               const defLabel = def ? (def.type === 'flat' ? inr(def.value) : def.value + '%') : (quote.markup_type === 'flat' ? 'overall' : quote.markup_value + '%'); %>
            <div class="kind-row" data-kind-row>
              <span class="kind-name"><%- icon(c.icon) %><%= c.plural %></span>
              <label class="check kind-default"><input type="checkbox" name="use_default_<%= k %>" value="1" <%= custom ? '' : 'checked' %> <%= locked ? 'disabled' : '' %> data-kind-default> Default (<%= defLabel %>)</label>
              <select name="markup_type_<%= k %>" aria-label="<%= c.plural %>: % or ₹" <%= custom && !locked ? '' : 'disabled' %> data-kind-own><option value="percent" <%= !custom || mine.type === 'percent' ? 'selected' : '' %>>%</option><option value="flat" <%= custom && mine.type === 'flat' ? 'selected' : '' %>>₹</option></select>
              <input name="markup_<%= k %>" type="number" min="0" step="0.5" value="<%= custom ? mine.value : '' %>" placeholder="<%= custom ? '' : 'Own' %>" aria-label="<%= c.plural %> markup on this quote" <%= custom && !locked ? '' : 'disabled' %> data-kind-own>
            </div>
          <% }) %>
        </div>

      <h2 class="h3">Customer invoice</h2>
      <p class="muted" style="font-size:13px;margin:0 0 6px">Your customer's invoice, quote and voucher carry <b><%= agency.name %></b>'s name, logo and details.</p>
      <div class="field"><label for="notes">Notes for customer</label><textarea id="notes" name="notes" placeholder="Validity, cancellation policy, special requests…"><%= quote.notes || '' %></textarea></div>
      <button class="btn btn-primary" style="width:100%">Save details</button>
    </form>
    <% } %>

    <% if (quote.status !== 'booked' && !viewOnly) { %>
      <form method="post" action="/agent/quotes/<%= quote.id %>/delete" data-confirm="Delete this quote?"><button class="btn btn-danger btn-sm">Delete quote</button></form>
    <% } %>
  </div>
</div>
