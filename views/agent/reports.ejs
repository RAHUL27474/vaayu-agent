<%
  const qs = `from=${from}&to=${to}`;
  const short = (n) => n >= 1e5 ? `₹${(n / 1e5).toFixed(n >= 1e6 ? 0 : 1)}L` : n >= 1e3 ? `₹${Math.round(n / 1e3)}k` : inr(n);
  // One bar per calendar month in the period, including months with no sales.
  const bars = [];
  const byMonth = Object.fromEntries(months.map(m => [m.month, m]));
  for (let d = new Date(`${from.slice(0, 7)}-01T00:00:00Z`); d.toISOString().slice(0, 7) <= to.slice(0, 7); d.setUTCMonth(d.getUTCMonth() + 1)) {
    const key = d.toISOString().slice(0, 7);
    const m = byMonth[key];
    bars.push({ label: d.toLocaleDateString('en-IN', { month: 'short', timeZone: 'UTC' }) + (bars.length && key.endsWith('-01') ? ` ’${key.slice(2, 4)}` : ''), value: m ? m.earnings : 0, note: m ? `${m.bookings} booking${m.bookings === 1 ? '' : 's'}, sales ${inr(m.sales)}` : 'no bookings' });
  }
  const maxDest = Math.max(1, ...destinations.map(d => d.sales));
  const margin = totals.sales ? (totals.earnings / totals.sales * 100).toFixed(1) : '0.0';
%>
<div class="page-head">
  <div><h1>Reports</h1><p>Your sales and earnings for <%= fmtDate(from) %> – <%= fmtDate(to) %>.</p></div>
  <div class="actions">
    <a class="btn" href="/agent/reports/bookings.csv?<%= qs %>"><%- icon('download') %>Bookings CSV</a>
    <a class="btn" href="/agent/reports/ledger.csv?<%= qs %>"><%- icon('download') %>Wallet ledger CSV</a>
    <a class="btn" href="/agent/wallet/statement?<%= qs %>"><%- icon('file') %>Account statement</a>
    <a class="btn" href="/agent/reports/tcs.csv?<%= qs %>" title="TCS you collected on your own branded invoices, for your CA"><%- icon('download') %>TCS CSV</a>
  </div>
</div>

<form class="card filter-bar" method="get" action="/agent/reports">
  <div class="field"><label for="from">From</label><input id="from" type="date" name="from" value="<%= from %>"></div>
  <div class="field"><label for="to">To</label><input id="to" type="date" name="to" value="<%= to %>"></div>
  <button class="btn btn-primary">Apply</button>
  <div class="chips">
    <% const today = new Date(); const iso = (d) => d.toISOString().slice(0, 10);
       const fyStart = new Date(Date.UTC(today.getUTCMonth() >= 3 ? today.getUTCFullYear() : today.getUTCFullYear() - 1, 3, 1)); %>
    <a class="chip" href="/agent/reports?from=<%= iso(new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), 1))) %>&to=<%= iso(today) %>">This month</a>
    <a class="chip" href="/agent/reports?from=<%= iso(new Date(Date.now() - 89 * 864e5)) %>&to=<%= iso(today) %>">Last 90 days</a>
    <a class="chip" href="/agent/reports?from=<%= iso(fyStart) %>&to=<%= iso(today) %>">This financial year</a>
  </div>
</form>

<%
  const best = months.length ? months.reduce((m, x) => (x.earnings > m.earnings ? x : m)) : null;
  const topDest = destinations.find((d) => d.destination !== 'Custom trips') || destinations[0];
  const topCust = customers[0];
  const monthName = (k) => new Date(k + '-01T00:00:00Z').toLocaleDateString('en-IN', { month: 'long', year: 'numeric', timeZone: 'UTC' });
%>
<% if (totals.bookings) { %>
<div class="highlights">
  <% if (best) { %><div class="hl-card"><span class="hl-ico"><%- icon('chart') %></span><div><small>Your best month</small><b><%= monthName(best.month) %></b><span><%= inr(best.earnings) %> earned from <%= best.bookings %> booking<%= best.bookings === 1 ? '' : 's' %></span></div></div><% } %>
  <% if (topDest) { %><div class="hl-card"><span class="hl-ico"><%- icon('globe') %></span><div><small>Your customers love</small><b><%= topDest.destination %></b><span><%= topDest.bookings %> trip<%= topDest.bookings === 1 ? '' : 's' %> · <%= inr(topDest.sales) %> in sales</span></div></div><% } %>
  <% if (topCust) { %><a class="hl-card" href="/agent/customers/<%= topCust.id %>"><span class="hl-ico"><%- icon('user') %></span><div><small>Your top customer</small><b><%= topCust.name %></b><span><%= inr(topCust.sales) %> across <%= topCust.bookings %> trip<%= topCust.bookings === 1 ? '' : 's' %></span></div></a><% } %>
</div>
<% } %>
<div class="grid grid-4" style="margin-bottom:20px">
  <div class="stat"><div class="label">Bookings</div><div class="value"><%= totals.bookings %></div><div class="sub"><%= totals.cancelled %> cancelled</div></div>
  <div class="stat"><div class="label">Sales (your price)</div><div class="value"><%= inr(totals.sales) %></div><div class="sub">before tax</div></div>
  <div class="stat"><div class="label">Paid to VaayuTrip (net)</div><div class="value"><%= inr(totals.net) %></div><div class="sub"><%= totals.refunds ? `${inr(totals.refunds)} refunded` : 'no refunds' %></div></div>
  <div class="stat"><div class="label">Your earnings</div><div class="value profit"><%= inr(totals.earnings) %></div><div class="sub"><%= totals.sales ? margin + "% of sales" : "no sales in this period" %></div></div>
</div>

<div class="card">
  <div class="card-head"><h3>Earnings by month</h3></div>
  <% if (!totals.bookings) { %><div class="empty">No bookings in this period.</div><% } else { %>
    <%- include('../partials/bar-chart', { bars, format: short }) %>
  <% } %>
</div>

<div class="grid grid-2">
  <div class="card flush">
    <div class="card-head"><h3>Top destinations</h3><a href="/agent/bookings">All bookings</a></div>
    <div style="padding:16px 20px 20px"><%- include('../partials/hbars', { id: 'my-destinations', rows: destinations.map(d => ({ label: d.destination, value: d.sales, sub: '+' + inr(d.earnings) + ' earned · ' + d.bookings + (d.bookings === 1 ? ' booking' : ' bookings') })), format: (n) => inr(n) }) %></div>
  </div>
  <div class="card flush">
    <div class="card-head"><h3>Top customers</h3><a href="/agent/customers">All customers</a></div>
    <% if (!customers.length) { %><div class="empty">Link bookings to customers to see who buys most.</div><% } else { %>
    <table class="table" style="margin-top:10px">
      <% customers.forEach(c => { %><tr class="click" data-href="/agent/customers/<%= c.id %>"><td><b><%= c.name %></b><br><small><%= c.bookings %> booking<%= c.bookings === 1 ? '' : 's' %></small></td><td class="num"><%= inr(c.sales) %></td></tr><% }) %>
    </table>
    <% } %>
  </div>
</div>
