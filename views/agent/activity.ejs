<%
  const list = (v) => String(v || '').split(/\r?\n/).map(s => s.trim()).filter(Boolean);
  const pax = party.adults + party.children;
%>
<a href="/agent/activities?city=<%= encodeURIComponent(a.city) %>">← Activities in <%= a.city %></a>
<div class="page-head" style="margin-top:10px">
  <div>
    <h1><%= a.title %></h1>
    <p><span class="badge info"><%= a.category %></span> <%= a.city %><%= a.country !== 'India' ? `, ${a.country}` : '' %> · <%= a.duration %><%= a.country !== 'India' ? ' · International' : '' %></p>
  </div>
  <div class="num">
    <div class="pp">Net <%= a.price_basis === 'per_group' ? `per group of up to ${a.group_size}` : 'per adult' %></div>
    <div class="price-big"><%= inr(a.net_adult) %></div>
    <div class="pp"><% if (a.price_basis === 'per_person') { %>Child (2–11) <b><%= inr(a.net_child ?? a.net_adult) %></b> · <% } %>Suggested selling <b><%= inr(a.sell) %></b> pp</div>
  </div>
</div>

<div class="split">
  <div>
    <img src="<%= cover({ image_url: a.image_url, destination: a.city }) %>" alt="" style="width:100%;max-height:320px;object-fit:cover;border-radius:14px;margin-bottom:20px">
    <div class="card">
      <% if (a.summary) { %><p style="font-size:15px;font-weight:500"><%= a.summary %></p><% } %>
      <% if (a.description) { %><p style="white-space:pre-line"><%= a.description %></p><% } %>
      <% if (list(a.highlights).length) { %><div class="chips" style="margin:14px 0"><% list(a.highlights).forEach(x => { %><span>✓ <%= x %></span><% }) %></div><% } %>
      <table class="table" style="margin-top:8px">
        <% if (a.pickup) { %><tr><td class="muted" style="width:160px">Pickup / meeting point</td><td><%= a.pickup %></td></tr><% } %>
        <% if (a.timing) { %><tr><td class="muted">Timings</td><td><%= a.timing %></td></tr><% } %>
        <% if (a.cancellation) { %><tr><td class="muted">Cancellation</td><td><%= a.cancellation %></td></tr><% } %>
      </table>
      <% if (list(a.inclusions).length || list(a.exclusions).length) { %>
        <div class="grid grid-2" style="margin-top:16px">
          <div><h3>✅ Included</h3><ul style="padding-left:18px"><% list(a.inclusions).forEach(x => { %><li><%= x %></li><% }) %></ul></div>
          <div><h3>❌ Not included</h3><ul style="padding-left:18px" class="muted"><% list(a.exclusions).forEach(x => { %><li><%= x %></li><% }) %></ul></div>
        </div>
      <% } %>
    </div>
    <% if (more.length) { %>
      <h2 style="margin-top:24px">More in <%= a.city %></h2>
      <div class="pkg-grid">
        <% more.forEach(m => { %>
          <a class="pkg" href="/agent/activities/<%= m.id %>" style="color:inherit;text-decoration:none">
            <div class="body"><div class="meta"><%= m.category %> · <%= m.duration %></div><h3><%= m.title %></h3>
              <div class="price"><div><small class="muted">Net pp</small><br><b><%= inr(m.net) %></b></div><div class="num"><small class="muted">You earn pp</small><br><span class="profit"><%= inr(m.sell - m.net) %></span></div></div></div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div>
    <form class="card calc" method="get" action="/agent/activities/<%= a.id %>">
      <h3>Price for your customer</h3>
      <div class="row">
        <div class="field"><label for="adults">Adults</label><input id="adults" type="number" min="1" name="adults" value="<%= party.adults %>"></div>
        <div class="field"><label for="children">Children 2–11</label><input id="children" type="number" min="0" name="children" value="<%= party.children %>"></div>
      </div>
      <button class="btn" style="width:100%">Recalculate</button>
      <table class="table" style="font-size:12.5px;margin-top:10px">
        <% lines.forEach(l => { %><tr><td style="padding:6px 0"><%= l.title.replace(`${a.title}`, '').replace(/^: /, '') || 'Per group' %> <span class="muted">× <%= l.qty %></span></td><td class="num" style="padding:6px 0"><%= inr(l.net * l.qty) %></td></tr><% }) %>
      </table>
      <table class="totals" style="margin-top:8px">
        <tr><td class="muted">Net to VaayuTrip</td><td class="num"><b><%= inr(priced.net) %></b></td></tr>
        <tr><td class="muted">Your markup</td><td class="num profit">+ <%= inr(priced.sell - priced.net) %></td></tr>
        <tr class="grand"><td>Selling price</td><td class="num"><%= inr(priced.sell) %></td></tr>
        <tr><td class="pp" colspan="2">≈ <%= inr(pax ? priced.sell / pax : 0) %> per person · + GST<%= a.country !== 'India' ? ' + TCS' : '' %> · infants free</td></tr>
      </table>
    </form>

    <form class="card" method="post" action="/agent/activities/<%= a.id %>/add-to-package">
      <h3>Add to a package</h3>
      <div class="field"><label for="pkg-id">Package</label>
        <select id="pkg-id" name="package_id">
          <option value="new">+ New package in <%= a.city %></option>
          <% packages.forEach(p => { %><option value="<%= p.id %>"><%= p.title.slice(0, 40) %> (<%= p.nights %>N)</option><% }) %>
        </select>
      </div>
      <div class="field"><label for="pkg-day">On day</label><input id="pkg-day" type="number" min="1" max="60" name="day" value="1"></div>
      <button class="btn btn-primary" style="width:100%">Add to package</button>
    </form>

    <form class="card" method="post" action="/agent/activities/<%= a.id %>/quote">
      <h3>Add to a quote</h3>
      <input type="hidden" name="adults" value="<%= party.adults %>"><input type="hidden" name="children" value="<%= party.children %>">
      <div class="field"><label for="q-id">Quote</label>
        <select id="q-id" name="quote_id" data-new-toggle="q-new">
          <option value="new">+ New quote</option>
          <% quotes.forEach(q => { %><option value="<%= q.id %>"><%= q.title.slice(0, 36) %> (<%= q.code %>)</option><% }) %>
        </select>
      </div>
      <div id="q-new">
        <div class="field"><label for="q-cust">Customer</label><select id="q-cust" name="customer_id"><option value="">Choose later</option><% customers.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></div>
        <div class="field"><label for="q-date">Date of the activity</label><input id="q-date" type="date" name="date"></div>
      </div>
      <button class="btn btn-accent" style="width:100%">Add for <%= pax %> guest<%= pax > 1 ? 's' : '' %> · <%= inr(priced.sell) %></button>
    </form>
  </div>
</div>
