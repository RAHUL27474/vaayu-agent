<%
  const list = (v) => String(v || '').split(/\r?\n/).map(s => s.trim()).filter(Boolean);
  const pax = party.adults + party.children;
  const isHotel = kind === 'hotel';
  const perPerson = p.price_basis === 'per_person';
  const facts = [];
  if (kind === 'hotel') facts.push(['Room', `${d.stars ? `${d.stars}★ · ` : ''}${d.room || ''}`], ['Meals', d.mealPlan ? `${d.mealPlan} · ${mealPlans[d.mealPlan] || ''}` : ''], ['Area', d.area], ['Max guests per room', d.maxGuests]);
  if (kind === 'flight') facts.push(['Flight', `${d.airline || ''} ${d.flightNo || ''} · ${d.from || ''} → ${d.to || ''} · ${d.depart || ''}–${d.arrive || ''}`],
    ['Return', d.trip === 'return' ? `${d.returnFlightNo || ''} · ${d.to || ''} → ${d.from || ''} · ${d.returnDepart || ''}–${d.returnArrive || ''}` : 'One-way fare'],
    ['Cabin', p.category], ['Baggage', d.baggage], ['Stops', d.stops], ['Refundable', d.refundable]);
  if (kind === 'transfer') facts.push(['Vehicle', d.vehicle], ['Luggage', d.luggage]);
  if (kind === 'visa') facts.push(['Type', p.category], ['Processing', d.processing], ['Validity', d.validity], ['Entries', d.entries], ['Documents', d.documents]);
  if (kind === 'insurance') facts.push(['Plan', p.category], ['Medical cover', d.cover], ['Trip length', d.maxDays], ['Other benefits', d.benefits]);
  facts.push([isHotel ? 'Check-in / out' : 'Pickup / meeting point', p.pickup], [kind === 'flight' ? 'Operates' : 'Timings', p.timing], ['Cancellation', p.cancellation]);
%>
<a href="/agent/<%= cfg.path %>?city=<%= encodeURIComponent(p.city) %>"><%- icon('arrowLeft') %><%= cfg.plural %> in <%= p.city %></a>
<div class="page-head" style="margin-top:10px">
  <div>
    <h1><%= p.title %></h1>
    <p><span class="badge info"><%= p.category %></span> <%= p.city %>, <%= p.country %><%= p.duration ? ` · ${p.duration}` : '' %></p>
  </div>
  <div class="num">
    <div class="pp">Net <%= p.price.unit %></div>
    <% if (p.price.was) { %><div><s class="was-price" style="font-size:16px"><%= inr(p.price.was) %></s> <span class="tier-badge <%= p.price.tier %>"><%= p.price.tier === 'gold' ? 'Gold' : 'Silver' %> price</span></div><% } %>
    <div class="price-big<%= p.price.was ? ' tier-price' : '' %>"><%= inr(p.net_adult) %></div>
    <div class="pp"><% if (perPerson) { %>Child 2–11 <b><%= inr(p.net_child ?? p.net_adult) %></b><% if (p.net_infant) { %> · infant <b><%= inr(p.net_infant) %></b><% } %> · <% } %><%= p.price.earnLabel %> <b class="profit"><%= inr(p.price.earn) %></b></div>
  </div>
</div>

<div class="split">
  <div>
    <% if (p.image_url || kind === 'activity' || isHotel) { %><img src="<%= cover({ image_url: p.image_url, destination: p.city }) %>" alt="" style="width:100%;max-height:300px;object-fit:cover;border-radius:14px;margin-bottom:20px"><% } %>
    <div class="card">
      <% if (p.summary) { %><p style="font-size:15px;font-weight:500"><%= p.summary %></p><% } %>
      <% if (p.description) { %><p style="white-space:pre-line"><%= p.description %></p><% } %>
      <% if (list(p.highlights).length) { %><div class="chips" style="margin:14px 0"><% list(p.highlights).forEach(x => { %><span>✓ <%= x %></span><% }) %></div><% } %>
      <table class="table" style="margin-top:8px">
        <% facts.filter(([, v]) => v && String(v).trim()).forEach(([k, v]) => { %><tr><td class="muted" style="width:170px"><%= k %></td><td style="white-space:pre-line"><%= v %></td></tr><% }) %>
      </table>
      <% if (list(p.inclusions).length || list(p.exclusions).length) { %>
        <div class="grid grid-2" style="margin-top:16px">
          <div><h3 class="h-ok"><%- icon('checkCircle') %>Included</h3><ul style="padding-left:18px"><% list(p.inclusions).forEach(x => { %><li><%= x %></li><% }) %></ul></div>
          <div><h3 class="h-bad"><%- icon('xCircle') %>Not included</h3><ul style="padding-left:18px" class="muted"><% list(p.exclusions).forEach(x => { %><li><%= x %></li><% }) %></ul></div>
        </div>
      <% } %>
    </div>
    <% if (more.length) { %>
      <h2 style="margin-top:24px">More <%= cfg.plural.toLowerCase() %> in <%= p.city %></h2>
      <div class="pkg-grid">
        <% more.forEach(m => { %>
          <a class="pkg" href="/agent/<%= cfg.path %>/<%= m.id %>" style="color:inherit;text-decoration:none">
            <div class="body"><div class="meta"><%= m.category %><%= m.duration ? ` · ${m.duration}` : '' %></div><h3><%= m.title %></h3>
              <div class="price"><div><small class="muted">Net <%= m.price.unit %></small><br><b><%= inr(m.price.net) %></b></div><div class="num"><small class="muted"><%= m.price.earnLabel %></small><br><span class="profit"><%= inr(m.price.earn) %></span></div></div></div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div>
    <form class="card calc" method="get" action="/agent/<%= cfg.path %>/<%= p.id %>">
      <h3>Price for your customer</h3>
      <div class="row">
        <div class="field"><label for="adults">Adults</label><input id="adults" type="number" min="1" name="adults" value="<%= party.adults %>"></div>
        <div class="field"><label for="children">Children 2–11</label><input id="children" type="number" min="0" name="children" value="<%= party.children %>"></div>
        <% if (kind === 'flight') { %><div class="field"><label for="infants">Infants</label><input id="infants" type="number" min="0" name="infants" value="<%= party.infants %>"></div><% } %>
      </div>
      <div class="field"><label for="calc-date">Travel date <span class="muted">(for season prices)</span></label><input id="calc-date" type="date" min="<%= today %>" name="date" value="<%= party.date %>"></div>
      <% if (soldOut) { %><div class="alert error" style="font-size:13px">Sold out on <%= fmtDate(party.date) %><%= soldOut.label ? ` (${soldOut.label})` : '' %>. Choose another date.</div><% } else if (season) { %><div class="alert info" style="font-size:13px"><b><%= season.label %></b>: prices <%= season.pct > 0 ? 'up' : 'down' %> <%= Math.abs(season.pct) %>% for this date.</div><% } %>
      <% if (isHotel) { %>
        <div class="row">
          <div class="field"><label for="rooms">Rooms</label><input id="rooms" type="number" min="1" name="rooms" value="<%= party.rooms %>"></div>
          <div class="field"><label for="nights">Nights</label><input id="nights" type="number" min="1" max="60" name="nights" value="<%= party.nights %>"></div>
        </div>
      <% } %>
      <%
        const defLabel = defaultRule.type === 'flat' ? inr(defaultRule.value) : defaultRule.value + '%';
      %>
      <div class="calc-markup" data-kind-row>
        <b>Your markup</b>
        <label class="check"><input type="checkbox" name="use_default" value="1" <%= own ? '' : 'checked' %> data-kind-default> My default for <%= cfg.plural.toLowerCase() %> (<%= defLabel %>)</label>
        <div class="row">
          <div class="field"><label for="mu_type">Type</label><select id="mu_type" name="mu_type" data-kind-own <%= own ? '' : 'disabled' %>><option value="percent" <%= own && own.markup_type === 'flat' ? '' : 'selected' %>>% of net</option><option value="flat" <%= own && own.markup_type === 'flat' ? 'selected' : '' %>>₹ amount</option></select></div>
          <div class="field"><label for="mu">Value</label><input id="mu" type="number" min="0" step="0.5" name="mu" value="<%= own ? own.markup_value : '' %>" placeholder="Own" data-kind-own <%= own ? '' : 'disabled' %>></div>
        </div>
      </div>
      <button class="btn" style="width:100%">Recalculate</button>
      <table class="table" style="font-size:12.5px;margin-top:10px">
        <% lines.forEach(l => { %><tr><td style="padding:6px 0"><%= l.title.replace(p.title, '').replace(/^: /, '') || 'Per group' %> <span class="muted">× <%= l.qty %></span></td><td class="num" style="padding:6px 0"><%= inr(l.net * l.qty) %></td></tr><% }) %>
      </table>
      <table class="totals" style="margin-top:8px">
        <tr><td class="muted">Net to VaayuTrip</td><td class="num"><b><%= inr(priced.net) %></b></td></tr>
        <% if (tierSaving) { %><tr class="tier-row"><td><%= tierNow.tier === 'gold' ? 'Gold' : 'Silver' %> price saves you</td><td class="num"><b>− <%= inr(tierSaving) %></b></td></tr><% } %>
        <tr><td class="muted">Your markup <%= own ? (own.markup_type === 'flat' ? '' : `(${own.markup_value}%)`) : `(${defLabel})` %></td><td class="num profit">+ <%= inr(priced.sell - priced.net) %></td></tr>
        <tr class="grand"><td>Selling price</td><td class="num"><%= inr(priced.sell) %></td></tr>
        <tr><td class="pp" colspan="2">≈ <%= inr(pax ? priced.sell / pax : 0) %> per person · <%= gstOn ? '+ GST ' : '' %>+ TCS</td></tr>
      </table>
    </form>
    <% if (seasons.length || blackouts.length) { %>
      <div class="card season-card">
        <h3>Seasonal prices</h3>
        <ul>
          <% seasons.forEach(s => { %><li><span class="badge <%= s.pct > 0 ? 'pending' : 'ok' %>"><%= s.pct > 0 ? '+' : '' %><%= s.pct %>%</span> <%= s.label %> · <%= fmtDate(s.from) %> – <%= fmtDate(s.to) %></li><% }) %>
          <% blackouts.forEach(s => { %><li><span class="badge cancelled">Sold out</span> <%= s.label %> · <%= fmtDate(s.from) %> – <%= fmtDate(s.to) %></li><% }) %>
        </ul>
      </div>
    <% } %>

    <form class="card" method="post" action="/agent/<%= cfg.path %>/<%= p.id %>/add-to-package">
      <h3>Add to a package</h3>
      <div class="field"><label for="pkg-id">Package</label>
        <select id="pkg-id" name="package_id">
          <option value="new">+ New package in <%= p.city %></option>
          <% packages.forEach(k => { %><option value="<%= k.id %>"><%= k.title.slice(0, 40) %> (<%= k.nights %>N)</option><% }) %>
        </select>
      </div>
      <div class="row">
        <div class="field"><label for="pkg-day"><%= isHotel ? 'Check-in on day' : kind === 'flight' ? 'Flies on day' : 'On day' %></label><input id="pkg-day" type="number" min="1" max="60" name="day" value="1"></div>
        <% if (isHotel) { %><div class="field"><label for="pkg-nights">Nights</label><input id="pkg-nights" type="number" min="1" max="60" name="nights" value="<%= party.nights %>"></div><% } %>
      </div>
      <button class="btn btn-primary" style="width:100%">Add to package</button>
    </form>

    <form class="card" method="post" action="/agent/<%= cfg.path %>/<%= p.id %>/quote">
      <h3>Add to a quote</h3>
      <% ['adults', 'children', 'infants', 'rooms', 'nights'].forEach(k => { %><input type="hidden" name="<%= k %>" value="<%= party[k] %>"><% }) %>
      <% if (own) { %><input type="hidden" name="mu_type" value="<%= own.markup_type %>"><input type="hidden" name="mu" value="<%= own.markup_value %>"><% } %>
      <div class="field"><label for="q-id">Quote</label>
        <select id="q-id" name="quote_id" data-new-toggle="q-new">
          <option value="new">+ New quote</option>
          <% quotes.forEach(q => { %><option value="<%= q.id %>"><%= q.title.slice(0, 36) %> (<%= q.code %>)</option><% }) %>
        </select>
      </div>
      <div id="q-new">
        <div class="field"><label for="q-cust">Customer</label><select id="q-cust" name="customer_id"><option value="">Choose later</option><% customers.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></div>
        <div class="field"><label for="q-date">Travel date</label><input id="q-date" type="date" min="<%= today %>" name="date" value="<%= party.date %>"></div>
      </div>
      <button class="btn btn-accent" style="width:100%">Add · <%= inr(priced.sell) %></button>
    </form>
  </div>
</div>
