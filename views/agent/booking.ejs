<a href="/agent/bookings"><%- icon('arrowLeft') %>All bookings</a>
<%
  const [tripName, who] = booking.title.split(' — ');
  const dest = full && full.quote && full.quote.package_snapshot ? (JSON.parse(full.quote.package_snapshot).destination || '') : '';
  const dd = booking.travel_date ? Math.round((Date.parse(booking.travel_date + 'T00:00:00Z') - Date.parse(today + 'T00:00:00Z')) / 864e5) : null;
  const when = dd === null ? '' : booking.status !== 'confirmed' ? '' : dd > 1 ? `in ${dd} days` : dd === 1 ? 'tomorrow' : dd === 0 ? 'today' : 'travelled';
%>
<section class="trip-hero" style="--trip-img:url('<%= cover({ destination: dest, city: dest, title: tripName }) %>')">
  <div>
    <p class="trip-kicker"><%= who ? `${who}'s trip` : 'Trip' %><%= when ? ` · ${when}` : '' %></p>
    <h1><%= tripName %></h1>
    <p>Booking <b><%= booking.code %></b><%= booking.travel_date ? ` · ${fmtDate(booking.travel_date)}` : '' %> · <span class="badge <%= booking.status %>"><%= booking.status.replace('_', ' ') %></span></p>
  </div>
  <div class="actions trip-btns">
    <% if (booking.quote_id) { %>
      <% if (booking.status === 'confirmed') { %><a class="btn btn-primary" href="/agent/bookings/<%= booking.id %>/voucher"><%- icon('file') %>Travel voucher</a><% } %>
      <a class="btn btn-glass" href="/agent/quotes/<%= booking.quote_id %>">Open quote &amp; invoices</a>
    <% } %>
  </div>
</section>
<div class="split">
  <div>
    <% if (full) { %>
    <div class="card flush">
      <div class="card-head"><h3>Services</h3></div>
      <table class="table" style="margin-top:10px">
        <thead><tr><th>Item</th><th class="num">Qty</th><th class="num">Net</th><th class="num">Sold</th></tr></thead>
        <% let lastDay = null; full.priced.lines.forEach(l => { const m = /^Day (\d+):\s*(.*)$/.exec(l.title || ''); const day = m ? Number(m[1]) : 0; const name = m ? m[2] : l.title; %>
          <% if (day !== lastDay) { lastDay = day; %><tr class="day-row"><td colspan="4"><span><%= day ? 'Day ' + day : 'Extras' %></span></td></tr><% } %>
          <tr><td><b><%= name %></b><% if (l.description) { %><br><small><%= l.description %></small><% } %></td><td class="num"><%= l.qty %></td><td class="num"><%= l.supplier === 'agent' ? '—' : inr(l.lineNet) %></td><td class="num"><%= inr(l.lineSell) %></td></tr>
        <% }) %>
        <tfoot><tr class="total-row"><td>Total</td><td></td><td class="num"><%= inr(full.priced.net) %></td><td class="num"><%= inr(full.priced.sell) %></td></tr></tfoot>
      </table>
    </div>
    <% } %>
    <div class="card flush">
      <div class="card-head"><h3>Invoices</h3></div>
      <table class="table" style="margin-top:10px">
        <% invoices.forEach(i => { %><tr class="click" data-href="/agent/invoices/<%= i.id %>"><td><b><%= i.number %></b></td><td><%= { customer_agent: 'Your branded invoice', customer_vaayu: 'VaayuTrip invoice to customer', b2b: 'VaayuTrip → you (net)' }[i.kind] %></td><td class="num"><%= inr(i.total) %></td></tr><% }) %>
      </table>
    </div>
  </div>
  <div class="side-sticky">
    <div class="card">
      <dl class="kv">
        <dt>Travel date</dt><dd><%= fmtDate(booking.travel_date) || '—' %></dd>
        <dt>Booked on</dt><dd><%= fmtDate(booking.created_at) %></dd>
        <% if (booking.paid_online > 0) { %><dt>Paid online</dt><dd><%= inr(booking.paid_online) %> <small class="muted">UPI / card / net banking</small></dd><% } %>
        <% if (booking.paid_wallet - (booking.paid_online || 0) > 0.004 || !(booking.paid_online > 0)) { %><dt>From wallet</dt><dd><%= inr(booking.paid_wallet - (booking.paid_online || 0)) %></dd><% } %>
        <% if (booking.paid_credit > 0) { %><dt>From credit</dt><dd><%= inr(booking.paid_credit) %></dd><% } %>
        <dt>Sold for</dt><dd><%= inr(booking.total_sell) %><%= gstOn ? ' + GST' : '' %></dd>
        <dt>Your earning</dt><dd class="profit"><%= inr(booking.total_sell - booking.total_net) %></dd>
        <% if (booking.refund_amount != null) { %><dt>Refunded</dt><dd><%= inr(booking.refund_amount) %></dd><% } %>
        <% if (booking.cancel_reason) { %><dt>Cancel reason</dt><dd><%= booking.cancel_reason %></dd><% } %>
      </dl>
    </div>
    <% if (booking.status === 'confirmed' && dd !== null && dd < 0) { %>
      <div class="card"><h3>Trip completed</h3><p class="muted" style="font-size:13px;margin-bottom:12px">Hope <%= who || 'your customers' %> had a great time. Anything to sort out after the trip?</p><a class="btn btn-sm" href="/agent/support?booking=<%= booking.code %>#new">Raise a support ticket</a></div>
    <% } else if (booking.status === 'confirmed') { %>
      <form class="card" method="post" action="/agent/bookings/<%= booking.id %>/cancel" data-confirm="Request cancellation of this booking?">
        <h3>Request cancellation</h3>
        <p class="muted" style="font-size:13px">VaayuTrip checks supplier policies and refunds to your wallet/credit.</p>
        <div class="field"><label for="reason">Reason</label><input id="reason" name="reason" placeholder="e.g. Customer's plans changed"></div>
        <button class="btn btn-danger">Request cancellation</button>
      </form>
    <% } else if (booking.status === 'cancel_requested') { %>
      <div class="alert warn">Cancellation requested. VaayuTrip will confirm the refund shortly.</div>
    <% } %>
  </div>
</div>
