<%
  const hr = Number(new Date().toLocaleString('en-GB', { hour: 'numeric', hour12: false, timeZone: 'Asia/Kolkata' }));
  const hello = hr < 12 ? 'Good morning' : hr < 17 ? 'Good afternoon' : 'Good evening';
  const live = Object.values(byKind).reduce((t, k) => t + Number(k.live || 0), 0);
  const gaps = destinations.reduce((t, d) => t + Object.keys(kinds).filter((k) => !coverage[d][k]).length, 0);
  const todo = [
    pendingRequests && { href: '/backend/booking-requests', n: pendingRequests, label: pendingRequests === 1 ? 'booking request to approve' : 'booking requests to approve', tone: 'warn' },
    newEnquiries && { href: '/backend/enquiries', n: newEnquiries, label: newEnquiries === 1 ? 'new enquiry' : 'new enquiries', tone: 'info' },
    drafts.length && { href: '/backend/products?status=draft', n: drafts.length, label: drafts.length === 1 ? 'draft to finish' : 'drafts to finish', tone: 'info' },
  ].filter(Boolean);
%>
<%- include('../partials/console-hero', {
  kicker: 'Backend portal', title: `${hello}, ${user.name.split(' ')[0]}`,
  line: `${live} items live across ${destinations.length} destinations${gaps ? `, ${gaps} ${gaps === 1 ? 'gap' : 'gaps'} in coverage` : ', no gaps in coverage'}.`,
  chips: todo, clear: 'Nothing waiting for you',
  actions: [{ href: '/backend/import', label: 'Bulk import', icon: 'upload' }, { href: '/backend/products/new', label: 'Add inventory', icon: 'plus', primary: true }],
}) %>

<div class="grid grid-3 tone-cards" style="margin-bottom:20px">
  <% Object.entries(kinds).forEach(([k, c]) => { const n = byKind[k] || { live: 0, drafts: 0 }; %>
    <a class="stat <%= {'activity':'tone-pink','hotel':'tone-violet','flight':'tone-blue','transfer':'tone-amber','visa':'tone-teal','insurance':'tone-green'}[k] || 'tone-blue' %>" href="/backend/products?kind=<%= k %>" style="color:inherit;text-decoration:none">
      <span class="stat-ico"><%- icon(c.icon) %></span><div class="label"><%= c.plural %></div>
      <div class="value"><%= n.live || 0 %> <small class="muted" style="font-size:14px;font-weight:500">live</small></div>
      <div class="sub"><%= n.drafts || 0 %> draft<%= n.drafts === 1 ? '' : 's' %> · <span style="color:var(--brand)">+ Add <%= c.label.toLowerCase() %></span></div>
    </a>
  <% }) %>
</div>

<div class="card flush">
  <div class="card-head"><h2 class="h3">Coverage by destination</h2><span class="muted heat-key">Live items <i class="heat heat-1"></i><i class="heat heat-2"></i><i class="heat heat-3"></i><i class="heat heat-4"></i> more · <i class="heat heat-0"></i> gap agents can't fill</span></div>
  <div class="table-wrap"><table class="table no-stack cov-table" style="margin-top:10px">
    <thead><tr><th>Destination</th><% Object.values(kinds).forEach(c => { %><th class="num"><%= c.plural %></th><% }) %></tr></thead>
    <% destinations.forEach(dest => { %>
      <tr>
        <td><b><%= dest %></b></td>
        <% Object.keys(kinds).forEach(k => { const n = coverage[dest][k] || 0; %>
          <td class="num heat heat-<%= n >= 6 ? 4 : n >= 4 ? 3 : n >= 2 ? 2 : n %>"><a href="/backend/products?kind=<%= k %>&dest=<%= encodeURIComponent(dest) %>" aria-label="<%= dest %>, <%= kinds[k].plural %>: <%= n || 'none' %>"><%= n || 'none' %></a></td>
        <% }) %>
      </tr>
    <% }) %>
  </table></div>
</div>

<div class="grid grid-2">
  <div class="card flush">
    <div class="card-head"><h2 class="h3">Drafts to finish</h2><a href="/backend/products?status=draft">All drafts</a></div>
    <% if (!drafts.length) { %><div class="empty">No drafts. Everything entered is live.</div><% } else { %>
    <table class="table" style="margin-top:10px">
      <% drafts.slice(0, 8).forEach(p => { %>
        <tr class="click" data-href="/backend/products/<%= p.id %>">
          <td><b><%= p.title %></b><br><small><%= kinds[p.kind].label %> · <%= p.city %></small></td>
          <td><% if (p.problems.length) { %><small style="color:var(--warn)"><%= p.problems[0] %></small><% } else { %><span class="badge ok">Ready to publish</span><% } %></td>
        </tr>
      <% }) %>
    </table>
    <% } %>
  </div>
  <div class="card flush">
    <div class="card-head"><h2 class="h3">Recently updated</h2></div>
    <table class="table" style="margin-top:10px">
      <% recent.forEach(p => { %>
        <tr class="click" data-href="/backend/products/<%= p.id %>">
          <td><b><%= p.title %></b><br><small><%= kinds[p.kind].label %> · <%= p.city %> · <span class="badge <%= p.status %>"><%= p.status %></span></small></td>
          <td class="num"><small><%= p.updated_by_name || 'System' %><br><span class="muted"><%= fmtDate(p.updated_at) %></span></small></td>
        </tr>
      <% }) %>
    </table>
  </div>
</div>
