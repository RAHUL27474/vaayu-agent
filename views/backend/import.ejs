<div class="page-head">
  <div><h1>Bulk import</h1><p>Load many items at once from a spreadsheet saved as CSV. Everything imports as a draft so you can check it before publishing.</p></div>
  <a class="btn" href="/backend/import/template.csv"><%- icon('download') %>Download template</a>
</div>
<div class="split">
  <form class="card" method="post" action="/backend/import" enctype="multipart/form-data">
    <h3>Upload CSV</h3>
    <div class="field"><label for="file">CSV file (UTF-8, up to 2 MB)</label><input id="file" type="file" name="file" accept=".csv,text/csv" required></div>
    <button class="btn btn-primary">Import as drafts</button>
  </form>
  <div class="card">
    <h3>Columns</h3>
    <p class="muted" style="font-size:13px">The first row must be the header. Column order doesn't matter; unknown columns are ignored.</p>
    <table class="table" style="font-size:13px">
      <tr><td><code>kind</code></td><td><%= Object.keys(kinds).join(', ') %></td></tr>
      <tr><td><code>title</code>, <code>city</code></td><td>Required</td></tr>
      <tr><td><code>country</code></td><td>One of: <%= countries.join(', ') %></td></tr>
      <tr><td><code>category</code></td><td><% Object.entries(kinds).forEach(([k, c]) => { %><b><%= k %>:</b> <%= c.categories.join(', ') %><br><% }) %></td></tr>
      <tr><td><code>price_basis</code></td><td><%= Object.keys(basisLabels).join(', ') %> (hotels are always per_room_night)</td></tr>
      <tr><td><code>net_adult</code></td><td>Net in ₹: per adult, per group, or per room per night</td></tr>
      <tr><td><code>net_child</code>, <code>net_infant</code></td><td>Optional, per-person items only</td></tr>
      <tr><td><code>highlights</code>, <code>inclusions</code>, <code>exclusions</code></td><td>Separate lines with <code>|</code></td></tr>
      <tr><td>Kind details</td><td><%= detailColumns.map(c => c).join(', ') %></td></tr>
    </table>
  </div>
</div>
