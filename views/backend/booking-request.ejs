<%
  const q = quote;
  const when = (t) => t ? new Date(String(t).replace(' ', 'T') + 'Z').toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit', timeZone: 'Asia/Kolkata' }) : '';
  const vaayu = priced.lines.filter((l) => l.supplier === 'vaayu');
  const locked = ['booked', 'cancelled'].includes(q.status);
%>
<a href="/backend/booking-requests"><%- icon('arrowLeft') %>All booking requests</a>
<div class="page-head" style="margin-top:10px">
  <div>
    <h1><%= q.title %></h1>
    <p><span class="badge <%= { requested: 'pending', approved: 'active', rejected: 'cancelled' }[q.approval_status] %>"><%= { requested: 'waiting', approved: 'approved', rejected: 'rejected' }[q.approval_status] %></span>
      · <%= q.code %> · <%= reqAgency.name %> · sent <%= when(q.approval_requested_at) %><%= nameOf(q.approval_requested_by) ? ` by ${nameOf(q.approval_requested_by)}` : '' %></p>
  </div>
  <% if (reqAgency.phone) { %><div class="actions"><a class="btn" href="tel:<%= reqAgency.phone.replace(/[^\d+]/g, '') %>"><%- icon('phone') %>Call agency</a></div><% } %>
</div>

<% if (booking) { %><div class="alert success">Booked: <b><%= booking.code %></b>. <a href="/admin/bookings/<%= booking.id %>">Open booking</a></div><% } %>
<% if (netChanged && !locked) { %><div class="alert warn">The agent changed this quote after it was sent: VaayuTrip net was <%= inr(q.approval_net) %>, now <%= inr(priced.net) %>. Approving confirms the current items.</div><% } %>

<div class="split">
  <div>
    <div class="card">
      <h2 class="h3">Trip</h2>
      <dl class="kv">
        <dt>Travel date</dt><dd><%= q.travel_date ? fmtDate(q.travel_date) : 'Not set' %></dd>
        <dt>Travellers</dt><dd><%= q.adults %> adult<%= q.adults === 1 ? '' : 's' %><%= q.children ? `, ${q.children} child${q.children === 1 ? '' : 'ren'}` : '' %><%= q.infants ? `, ${q.infants} infant${q.infants === 1 ? '' : 's'}` : '' %></dd>
        <% if (customer) { %><dt>Lead traveller</dt><dd><%= customer.name %></dd><% } %>
        <dt>Agency</dt><dd><%= reqAgency.name %><%= reqAgency.city ? `, ${reqAgency.city}` : '' %><br><small class="muted"><%= reqAgency.email || '' %><%= reqAgency.phone ? ` · ${reqAgency.phone}` : '' %></small></dd>
      </dl>
      <% if (q.approval_request_note) { %><h4 class="enq-msg-h">Agent's note</h4><p class="enq-msg"><%= q.approval_request_note %></p><% } %>
    </div>
    <div class="card flush">
      <div class="card-head"><h2 class="h3">Services to confirm</h2><span class="muted">VaayuTrip net <b class="req-net"><%= inr(priced.net) %></b></span></div>
      <div class="table-wrap"><table class="table">
        <thead><tr><th>Item</th><th class="num">Qty</th><th class="num">Net each</th><th class="num">Net</th></tr></thead>
        <% vaayu.forEach(l => { %><tr><td><b><%= l.title %></b><% if (l.description) { %><br><small class="muted"><%= l.description %></small><% } %></td><td class="num"><%= l.qty %></td><td class="num"><%= inr(l.unitNet) %></td><td class="num"><%= inr(l.lineNet) %></td></tr><% }) %>
      </table></div>
      <% const own = priced.lines.length - vaayu.length; if (own) { %><p class="muted" style="font-size:12.5px;padding:10px 16px;margin:0">Plus <%= own %> service<%= own === 1 ? '' : 's' %> the agent arranges itself (not booked through VaayuTrip).</p><% } %>
    </div>
  </div>

  <div>
    <% if (locked) { %>
      <div class="card"><p class="muted" style="margin:0">This quote is <%= q.status %>; nothing to decide.</p></div>
    <% } else { %>
    <form class="card appr-decide" method="post" action="/backend/booking-requests/<%= q.id %>/decide">
      <h2 class="h3">Decision</h2>
      <% if (q.approval_status !== 'requested') { %><p class="muted" style="font-size:13px;margin:0 0 12px"><%= q.approval_status === 'approved' ? 'Approved' : 'Rejected' %> <%= when(q.approval_decided_at) %><%= nameOf(q.approval_decided_by) ? ` by ${nameOf(q.approval_decided_by)}` : '' %>. You can change it.</p><% } %>
      <div class="field"><label for="ap-note">Note to the agent</label><textarea id="ap-note" name="note" rows="3" placeholder="e.g. Confirmed, deluxe room on hold. Or: Hotel full on these dates; try 12 Dec."><%= q.approval_note || '' %></textarea><div class="hint">Needed when rejecting.</div></div>
      <div class="field"><label for="ap-hours">Agent must pay within</label>
        <select id="ap-hours" name="hours"><% [[12, '12 hours'], [24, '24 hours'], [48, '2 days'], [72, '3 days']].forEach(([v, l]) => { %><option value="<%= v %>" <%= v === 24 ? 'selected' : '' %>><%= l %></option><% }) %></select></div>
      <button class="btn btn-accent btn-lg" name="decision" value="approve" style="width:100%"><%- icon('checkCircle') %>Approve: agent can pay</button>
      <button class="btn btn-danger" name="decision" value="reject" style="width:100%;margin-top:10px">Reject</button>
    </form>
    <% } %>
  </div>
</div>
