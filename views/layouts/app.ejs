<!doctype html>
<html lang="en">
<head>
  <script>(function(){var d=document.documentElement;d.classList.add('js');var t='system';try{t=localStorage.getItem('vt-theme')||'system'}catch(e){}var m=window.matchMedia&&matchMedia('(prefers-color-scheme: dark)');d.dataset.themePref=t;d.dataset.theme=t==='dark'||(t==='system'&&m&&m.matches)?'dark':'light'})()</script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#ffffff">
  <meta name="robots" content="noindex, nofollow">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>VaayuTrip Agent</title>
  <link rel="icon" href="/img/favicon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <link rel="preload" href="/fonts/dmsans-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="<%= asset('/css/app.css') %>">
</head>
<body class="app tp">
<%
  const isAdmin = user && user.role === 'admin';
  const isBackend = user && user.role === 'backend';
  const home = isAdmin ? '/admin' : isBackend ? '/backend' : '/agent';
  const isActive = (href) => href === home ? (path === home || path === home + '/') : (path === href || path.startsWith(href + '/'));
  const canOpen = (href) => typeof agentCan !== 'function' || !href.startsWith('/agent') || agentCan(href);
  const initialsOf = (name) => name.replace(/\(.*\)/, '').trim().split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
  const initials = initialsOf(user.name);
  const roleLabel = isAdmin ? 'Administrator' : isBackend ? 'Backend team' : ({ owner: 'Agent · Owner', sales: 'Agent · Sales', accounts: 'Agent · Accounts' }[user.agency_role] || 'Agent');
  // Menu: [href, icon, label, count?, active?] for a link; { group, items } for a dropdown.
  const L = (href, ico, label, count, active) => ({ href, ico, label, count, active: active === undefined ? isActive(href) : active });
  const G = (group, ico, items) => ({ group, ico, items });
  let menu;
  if (isAdmin) {
    menu = [
      L('/admin', 'dashboard', 'Dashboard'),
      L('/admin/agents', 'building', 'Agents'),
      L('/admin/topups', 'topup', 'Top-ups', typeof pendingTopups !== 'undefined' && pendingTopups ? pendingTopups : ''),
      L('/admin/bookings', 'clipboard', 'Bookings'),
      L('/admin/invoices', 'receipt', 'Invoices'),
      L('/admin/tickets', 'message', 'Support', typeof openTickets !== 'undefined' && openTickets ? openTickets : ''),
      L('/backend/enquiries', 'inbox', 'Enquiries', typeof newEnquiries !== 'undefined' && newEnquiries ? newEnquiries : ''),
      G('Monitor', 'activity', [L('/admin/log', 'activity', 'Activity log'), L('/backend', 'layers', 'Inventory'), L('/admin/team', 'users', 'Team')]),
      G('More', 'settings', [L('/admin/tiers', 'tag', 'Silver / Gold'), L('/admin/ledger', 'wallet', 'Wallet ledger'), L('/admin/offers', 'tag', 'Offers &amp; deals'), L('/admin/notifications', 'bell', 'Notifications', unread || ''), L('/admin/settings', 'settings', 'Settings')]),
    ];
  } else if (isBackend) {
    const navKind = typeof locals.navKind !== 'undefined' ? locals.navKind : '';
    menu = [
      L('/backend', 'dashboard', 'Dashboard'),
      L('/backend/enquiries', 'inbox', 'Enquiries', typeof newEnquiries !== 'undefined' && newEnquiries ? newEnquiries : ''),
      G('Inventory', 'layers', [L('/backend/products', 'layers', 'All inventory', '', path === '/backend/products' && !navKind), ...Object.entries(locals.kindsNav || {}).map(([k, c]) => L(`/backend/products?kind=${k}`, c.icon, c.plural, '', navKind === k))]),
      L('/backend/packages', 'briefcase', 'VaayuTrip packages'),
      L('/backend/import', 'upload', 'Bulk import'),
    ];
  } else if (agency && agency.status !== 'active') {
    menu = [
      L('/agent', 'clipboard', 'Application status'),
      L('/agent/settings', 'settings', 'Company &amp; documents'),
      L('/agent/notifications', 'bell', 'Notifications', unread || ''),
      L('/agent/support', 'help', 'Help &amp; support'),
    ];
  } else {
    menu = [
      L('/agent', 'dashboard', 'Dashboard'),
      G('Book', 'search', [L('/agent/vaayutrip-packages', 'briefcase', 'Ready packages'), L('/agent/hotels', 'bed', 'Hotels'), L('/agent/flights', 'plane', 'Airfares'), L('/agent/activities', 'ticket', 'Activities'), L('/agent/transfers', 'car', 'Transfers'), L('/agent/visas', 'passport', 'Visas'), L('/agent/insurance', 'shield', 'Travel insurance')]),
      L('/agent/quotes', 'file', 'Quotes'),
      L('/agent/bookings', 'clipboard', 'Bookings'),
      L('/agent/leads', 'target', 'Leads'),
      L('/agent/customers', 'users', 'Customers'),
      L('/agent/packages', 'briefcase', 'My packages'),
      G('Accounts', 'wallet', [L('/agent/wallet', 'wallet', 'Wallet &amp; credit'), L('/agent/invoices', 'receipt', 'Invoices'), L('/agent/reports', 'chart', 'Reports')]),
      G('More', 'settings', [L('/agent/offers', 'tag', 'Offers &amp; deals'), L('/agent/website', 'globe', 'My website'), L('/agent/api', 'code', 'API access'), L('/agent/notifications', 'bell', 'Notifications', unread || ''), L('/agent/support', 'help', 'Help &amp; support'), L('/agent/team', 'users', 'Team'), L('/agent/settings', 'settings', 'Company &amp; branding')]),
    ];
  }
  // Hide what this agent user's role can't open; drop empty groups.
  menu = menu.map((m) => (m.group ? { ...m, items: m.items.filter((i) => canOpen(i.href)) } : m)).filter((m) => (m.group ? m.items.length : canOpen(m.href)));
  const item = (i, cls) => `<a href="${i.href}" class="${cls}${i.active ? ' on' : ''}"${i.active ? ' aria-current="page"' : ''}>${icon(i.ico)}<span>${i.label}</span>${i.count ? `<b class="count">${i.count}</b>` : ''}</a>`;
%>
<a class="skip-link" href="#main">Skip to content</a>
<header class="tp-head">
  <div class="tp-top">
    <div class="tp-in">
      <button class="icon-btn menu-toggle" type="button" data-nav-toggle aria-label="Open menu" aria-controls="tp-nav" aria-expanded="false"><%- icon('menu') %></button>
      <a class="tp-logo" href="<%= home %>"><img src="/img/vaayutrip-logo-sm.png" alt="VaayuTrip" height="38"></a>
      <% if (agency) { %>
        <% const companyTag = canOpen('/agent/settings') ? 'a' : 'span'; %>
        <<%= companyTag %> class="tp-agency"<% if (companyTag === 'a') { %> href="/agent/settings" title="Company &amp; branding"<% } %>><b><%= agency.name %></b><small><%= agency.status === 'active' ? ((typeof tierNow !== 'undefined' && tierNow.source === 'own' && { gold: 'Gold partner', silver: 'Silver partner' }[tierNow.tier]) || 'Verified partner') : agency.status.charAt(0).toUpperCase() + agency.status.slice(1) %> · <%= roleLabel.replace('Agent · ', '') %></small></<%= companyTag %>>
      <% } else { %>
        <span class="tp-agency"><b><%= isBackend ? 'Backend portal' : 'Admin console' %></b><small>VaayuTrip HQ</small></span>
      <% } %>
      <div class="spacer"></div>
      <% if (isAdmin || (agency && agency.status === 'active')) { %>
        <form class="top-search" action="<%= home %>/search" method="get" role="search">
          <%- icon('search') %>
          <input type="search" name="q" placeholder="<%= isAdmin ? 'Search agencies, bookings, invoices' : 'Search quotes, bookings, customers' %>" aria-label="Search" value="<%= path === home + '/search' && query.q ? query.q : '' %>" minlength="2" data-search-key>
        </form>
        <a class="icon-btn search-btn" href="<%= home %>/search" aria-label="Search"><%- icon('search') %></a>
      <% } %>
      <% if (agency && agency.status === 'active' && canOpen('/agent/wallet')) { %>
        <a class="balance" href="/agent/wallet"><span>Wallet</span><b><%= inr(agency.wallet_balance) %></b></a>
        <% if (agency.credit_limit > 0) { %><a class="balance" href="/agent/wallet"><span>Credit available</span><b><%= inr(agency.credit_limit - agency.credit_used) %></b></a><% } %>
      <% } %>
      <% if (!isBackend) { %><a class="icon-btn bell" href="<%= home %>/notifications" aria-label="Notifications<%= unread ? ` (${unread} unread)` : '' %>"><%- icon('bell') %><% if (unread) { %><span class="dot"><%= unread %></span><% } %></a><% } %>
      <details class="user-menu" data-dropdown>
        <summary aria-label="Account menu">
          <span class="avatar"><%= initials %></span>
          <span class="who"><b><%= user.name.replace(/\s*\(.*\)/, '') %></b><small><%= roleLabel %></small></span>
          <%- icon('chevron', 'caret') %>
        </summary>
        <div class="menu" role="menu">
          <div class="menu-head"><span class="avatar"><%= initials %></span><div><b><%= user.name.replace(/\s*\(.*\)/, '') %></b><small><%= user.email %></small></div></div>
          <% if (agency && agency.status !== 'active') { %>
            <a href="/agent"><%- icon('clipboard') %>Application status</a>
            <a href="/agent/settings"><%- icon('settings') %>Company &amp; documents</a>
            <a href="/agent/support"><%- icon('help') %>Help &amp; support</a>
          <% } else if (agency) { %>
            <div class="menu-balances">
              <div><span>Wallet</span><b><%= inr(agency.wallet_balance) %></b></div>
              <div><span>Credit available</span><b><%= inr(agency.credit_limit - agency.credit_used) %></b></div>
            </div>
            <% if (canOpen('/agent/settings')) { %><a href="/agent/settings"><%- icon('settings') %>Company &amp; branding</a><% } %>
            <% if (canOpen('/agent/team')) { %><a href="/agent/team"><%- icon('users') %>Team</a><% } %>
            <% if (canOpen('/agent/wallet')) { %><a href="/agent/wallet"><%- icon('wallet') %>Wallet &amp; credit</a><% } %>
            <a href="/agent/support"><%- icon('help') %>Help &amp; support</a>
          <% } else if (isAdmin) { %>
            <a href="/admin/settings"><%- icon('settings') %>Settings</a>
            <a href="/admin/team"><%- icon('users') %>Team</a>
          <% } else { %>
            <a href="/backend/import"><%- icon('upload') %>Bulk import</a>
          <% } %>
          <a href="/account"><%- icon('shield') %>My account &amp; password</a>
          <div class="menu-theme" role="group" aria-label="Theme">
            <span>Theme</span>
            <div class="seg"><button type="button" data-theme-set="light" aria-pressed="false"><%- icon('sun') %>Light</button><button type="button" data-theme-set="dark" aria-pressed="false"><%- icon('moon') %>Dark</button><button type="button" data-theme-set="system" aria-pressed="false"><%- icon('monitor') %>System</button></div>
          </div>
          <form method="post" action="/logout"><button type="submit"><%- icon('logout') %>Log out</button></form>
        </div>
      </details>
    </div>
  </div>
  <nav class="tp-nav" id="tp-nav" aria-label="Main menu">
    <div class="tp-in">
      <div class="tp-drawer-head"><img src="/img/vaayutrip-logo-sm.png" alt="VaayuTrip" height="32"><button class="icon-btn" type="button" data-nav-close aria-label="Close menu"><%- icon('x') %></button></div>
      <% menu.forEach((m) => { if (!m.group) { %><%- item(m, 'tp-link') %><% } else { const on = m.items.some((i) => i.active); %>
        <div class="tp-group<%= on ? ' on' : '' %>" data-tp-group>
          <button type="button" class="tp-link tp-gbtn<%= on ? ' on' : '' %>" aria-expanded="false" aria-controls="nav-group-<%= m.ico %>"><%- icon(m.ico) %><span><%= m.group %></span><%- icon('chevron', 'caret') %></button>
          <span class="tp-group-label"><%= m.group %></span>
          <div class="tp-drop" id="nav-group-<%= m.ico %>"><% m.items.forEach((i) => { %><%- item(i, 'tp-item') %><% }) %></div>
        </div>
      <% } }) %>
      <% if (agency && settings.phone) { %>
        <a class="tp-help" href="tel:<%= settings.phone.replace(/\s/g, '') %>"><%- icon('phone') %><span>Partner desk <b><%= settings.phone %></b></span></a>
      <% } %>
    </div>
  </nav>
</header>
<div class="backdrop" data-nav-close></div>
<main class="content" id="main">
  <% flash.forEach(f => { %><div class="alert <%= f.type %>" role="<%= f.type === 'error' ? 'alert' : 'status' %>" data-flash><%- icon(f.type === 'error' ? 'xCircle' : 'checkCircle') %><span><%= f.message %></span></div><% }) %>
  <%- body %>
</main>
<% if (agency) { const bookPaths = ['/agent/activities', '/agent/hotels', '/agent/flights', '/agent/transfers', '/agent/visas', '/agent/insurance', '/agent/vaayutrip-packages']; %>
  <% if (agency.status !== 'active') { %>
  <nav class="bottom-nav" aria-label="Quick menu">
    <a href="/agent" class="<%= isActive('/agent') ? 'on' : '' %>"><%- icon('clipboard') %><span>Status</span></a>
    <a href="/agent/settings" class="<%= isActive('/agent/settings') ? 'on' : '' %>"><%- icon('upload') %><span>Documents</span></a>
    <a href="/agent/notifications" class="<%= isActive('/agent/notifications') ? 'on' : '' %>"><%- icon('bell') %><span>Alerts</span></a>
    <a href="/agent/support" class="<%= isActive('/agent/support') ? 'on' : '' %>"><%- icon('help') %><span>Support</span></a>
  </nav>
  <% } else { %>
  <nav class="bottom-nav" aria-label="Quick menu">
    <a href="/agent" class="<%= isActive('/agent') ? 'on' : '' %>"><%- icon('dashboard') %><span>Home</span></a>
    <% if (canOpen('/agent/hotels')) { %><a href="/agent/hotels" class="<%= bookPaths.some(isActive) ? 'on' : '' %>"><%- icon('search') %><span>Book</span></a><% } else { %><a href="/agent/invoices" class="<%= isActive('/agent/invoices') ? 'on' : '' %>"><%- icon('receipt') %><span>Invoices</span></a><% } %>
    <a href="/agent/quotes" class="<%= isActive('/agent/quotes') ? 'on' : '' %>"><%- icon('file') %><span>Quotes</span></a>
    <a href="/agent/bookings" class="<%= isActive('/agent/bookings') ? 'on' : '' %>"><%- icon('clipboard') %><span>Bookings</span></a>
    <button type="button" data-nav-toggle aria-label="More" aria-controls="tp-nav" aria-expanded="false"><%- icon('menu') %><span>More</span></button>
  </nav>
  <% } %>
<% } %>
<script src="<%= asset('/js/app.js') %>"></script>
</body>
</html>
