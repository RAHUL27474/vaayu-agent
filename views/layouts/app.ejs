<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#ffffff">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>VaayuTrip Agent</title>
  <link rel="icon" href="/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="app">
<%
  const isAdmin = user && user.role === 'admin';
  const isBackend = user && user.role === 'backend';
  const home = isAdmin ? '/admin' : isBackend ? '/backend' : '/agent';
  const isActive = (href) => href === home ? (path === home || path === home + '/') : (path === href || path.startsWith(href + '/'));
  // The first active menu item becomes the breadcrumb in the top bar.
  let curSection = '';
  let crumb = null;
  const section = (name) => { curSection = name; return `<div class="nav-section">${name}</div>`; };
  const link = (href, ico, label, active, extra) => {
    if (active && !crumb) crumb = { section: curSection, label };
    return `<a href="${href}" class="${active ? 'active' : ''}" title="${label}"${active ? ' aria-current="page"' : ''}>${icon(ico)}<span class="lbl">${label}</span>${extra ? `<span class="count">${extra}</span>` : ''}</a>`;
  };
  const navItem = (href, ico, label, extra) => link(href, ico, label, isActive(href), extra);
  const initialsOf = (name) => name.replace(/\(.*\)/, '').trim().split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
  const initials = initialsOf(user.name);
  const roleLabel = isAdmin ? 'Administrator' : isBackend ? 'Backend team' : 'Agent';
%>
<a class="skip-link" href="#main">Skip to content</a>
<div class="shell">
  <aside class="sidebar" id="sidebar" aria-label="Main menu">
    <div class="sidebar-head">
      <a class="logo" href="<%= home %>">
        <img src="/img/vaayutrip-mark.png" alt="">
        <span class="lbl"><span class="wordmark">Vaay<i>u</i><b>Trip</b></span><small><%= isAdmin ? 'Admin console' : isBackend ? 'Backend portal' : 'Agent portal' %></small></span>
      </a>
      <button class="icon-btn sidebar-close" type="button" data-nav-close aria-label="Close menu"><%- icon('x') %></button>
    </div>

    <% if (agency) { %>
      <a class="workspace" href="/agent/settings" title="<%= agency.name %>">
        <span class="ws-mark"><% if (agency.logo_path) { %><img src="<%= agency.logo_path %>" alt=""><% } else { %><%= initialsOf(agency.name) %><% } %></span>
        <span class="lbl ws-text"><b><%= agency.name %></b><small><span class="ws-dot <%= agency.status %>"></span><%= agency.status === 'active' ? 'Verified partner' : agency.status.charAt(0).toUpperCase() + agency.status.slice(1) %></small></span>
      </a>
    <% } else { %>
      <div class="workspace">
        <span class="ws-mark hq"><%- icon(isBackend ? 'layers' : 'building') %></span>
        <span class="lbl ws-text"><b>VaayuTrip HQ</b><small><span class="ws-dot active"></span><%= isBackend ? 'Inventory team' : 'Administration' %></small></span>
      </div>
    <% } %>

    <nav class="nav">
    <% if (isAdmin) { %>
      <%- navItem('/admin', 'dashboard', 'Dashboard') %>
      <%- section('Monitor') %>
      <%- navItem('/admin/log', 'activity', 'Activity log') %>
      <%- navItem('/backend', 'layers', 'Inventory') %>
      <%- navItem('/admin/team', 'users', 'Team') %>
      <%- section('Partners') %>
      <%- navItem('/admin/agents', 'building', 'Agents') %>
      <%- navItem('/admin/topups', 'topup', 'Top-up requests', typeof pendingTopups !== 'undefined' && pendingTopups ? pendingTopups : '') %>
      <%- section('Operations') %>
      <%- navItem('/admin/bookings', 'clipboard', 'Bookings') %>
      <%- navItem('/admin/invoices', 'receipt', 'Invoices') %>
      <%- navItem('/admin/tickets', 'message', 'Support tickets', typeof openTickets !== 'undefined' && openTickets ? openTickets : '') %>
      <%- navItem('/admin/offers', 'tag', 'Offers &amp; deals') %>
      <%- navItem('/admin/notifications', 'bell', 'Notifications', unread || '') %>
      <%- navItem('/admin/settings', 'settings', 'Settings') %>
    <% } else if (isBackend) { %>
      <%- navItem('/backend', 'dashboard', 'Dashboard') %>
      <%- section('Inventory') %>
      <% const navKind = typeof locals.navKind !== 'undefined' ? locals.navKind : ''; %>
      <%- link('/backend/products', 'layers', 'All inventory', path === '/backend/products' && !navKind) %>
      <% Object.entries(locals.kindsNav || {}).forEach(([k, c]) => { %>
        <%- link(`/backend/products?kind=${k}`, c.icon, c.plural, navKind === k) %>
      <% }) %>
      <%- section('Tools') %>
      <%- navItem('/backend/import', 'upload', 'Bulk import (CSV)') %>
    <% } else { %>
      <%- navItem('/agent', 'dashboard', 'Dashboard') %>
      <%- section('Book from VaayuTrip') %>
      <%- navItem('/agent/activities', 'ticket', 'Activities') %>
      <%- navItem('/agent/hotels', 'bed', 'Hotels') %>
      <%- navItem('/agent/flights', 'plane', 'Airfares') %>
      <%- navItem('/agent/transfers', 'car', 'Transfers') %>
      <%- navItem('/agent/visas', 'passport', 'Visas') %>
      <%- navItem('/agent/insurance', 'shield', 'Travel insurance') %>
      <%- section('Sell') %>
      <%- navItem('/agent/packages', 'briefcase', 'My packages') %>
      <%- navItem('/agent/leads', 'target', 'Leads') %>
      <%- navItem('/agent/customers', 'users', 'Customers') %>
      <%- navItem('/agent/quotes', 'file', 'Quotes') %>
      <%- navItem('/agent/bookings', 'clipboard', 'Bookings') %>
      <%- section('Money') %>
      <%- navItem('/agent/wallet', 'wallet', 'Wallet &amp; credit') %>
      <%- navItem('/agent/invoices', 'receipt', 'Invoices') %>
      <%- navItem('/agent/payment-links', 'link', 'Payment links') %>
      <%- navItem('/agent/reports', 'chart', 'Reports') %>
      <%- section('Grow') %>
      <%- navItem('/agent/website', 'globe', 'My website') %>
      <%- navItem('/agent/api', 'code', 'API access') %>
      <%- navItem('/agent/offers', 'tag', 'Offers &amp; deals') %>
      <%- section('Account') %>
      <%- navItem('/agent/notifications', 'bell', 'Notifications', unread || '') %>
      <%- navItem('/agent/support', 'help', 'Help &amp; support') %>
      <%- navItem('/agent/settings', 'settings', 'Company &amp; branding') %>
    <% } %>
    </nav>

    <% if (agency && settings.phone) { %>
      <div class="help-card lbl">
        <b>Need a hand?</b>
        <span>Our partner desk is available 9 am – 9 pm, 7 days.</span>
        <a href="tel:<%= settings.phone.replace(/\s/g, '') %>"><%- icon('phone') %><%= settings.phone %></a>
      </div>
    <% } %>
  </aside>
  <div class="backdrop" data-nav-close></div>

  <div class="main">
    <header class="topbar">
      <button class="icon-btn menu-toggle" type="button" data-nav-toggle aria-label="Open menu" aria-controls="sidebar" aria-expanded="false"><%- icon('menu') %></button>
      <nav class="crumbs" aria-label="Breadcrumb">
        <% if (crumb && crumb.section) { %><span class="crumb-section"><%- crumb.section %></span><span class="crumb-sep" aria-hidden="true">/</span><% } %>
        <span class="crumb-current"><%- crumb ? crumb.label : (typeof title !== 'undefined' ? title : 'Dashboard') %></span>
      </nav>
      <div class="spacer"></div>
      <% if (agency) { %>
        <a class="balance" href="/agent/wallet"><span>Wallet</span><b><%= inr(agency.wallet_balance) %></b></a>
        <a class="balance" href="/agent/wallet"><span>Credit available</span><b><%= inr(agency.credit_limit - agency.credit_used) %></b></a>
      <% } %>
      <% if (!isBackend) { %><a class="icon-btn bell" href="<%= home %>/notifications" aria-label="Notifications<%= unread ? ` (${unread} unread)` : '' %>"><%- icon('bell') %><% if (unread) { %><span class="dot"><%= unread %></span><% } %></a><% } %>
      <details class="user-menu" data-dropdown>
        <summary aria-label="Account menu">
          <span class="avatar"><%= initials %></span>
          <span class="who"><b><%= user.name.replace(/\s*\(.*\)/, '') %></b><small><%= roleLabel %></small></span>
          <%- icon('chevron', 'caret') %>
        </summary>
        <div class="menu" role="menu">
          <div class="menu-head"><span class="avatar"><%= initials %></span><div><b><%= user.name.replace(/\s*\(.*\)/, '') %></b><small><%= user.email %></small></div></div>
          <% if (agency) { %>
            <div class="menu-balances">
              <div><span>Wallet</span><b><%= inr(agency.wallet_balance) %></b></div>
              <div><span>Credit available</span><b><%= inr(agency.credit_limit - agency.credit_used) %></b></div>
            </div>
            <a href="/agent/settings"><%- icon('settings') %>Company &amp; branding</a>
            <a href="/agent/wallet"><%- icon('wallet') %>Wallet &amp; credit</a>
            <a href="/agent/support"><%- icon('help') %>Help &amp; support</a>
          <% } else if (isAdmin) { %>
            <a href="/admin/settings"><%- icon('settings') %>Settings</a>
            <a href="/admin/team"><%- icon('users') %>Team</a>
          <% } else { %>
            <a href="/backend/import"><%- icon('upload') %>Bulk import</a>
          <% } %>
          <form method="post" action="/logout"><button type="submit"><%- icon('logout') %>Log out</button></form>
        </div>
      </details>
    </header>
    <main class="content" id="main">
      <% flash.forEach(f => { %><div class="alert <%= f.type %>" role="status"><%- icon(f.type === 'error' ? 'xCircle' : 'checkCircle') %><span><%= f.message %></span></div><% }) %>
      <%- body %>
    </main>
    <% if (agency) { const bookPaths = ['/agent/activities', '/agent/hotels', '/agent/flights', '/agent/transfers', '/agent/visas', '/agent/insurance']; %>
      <nav class="bottom-nav" aria-label="Quick menu">
        <a href="/agent" class="<%= isActive('/agent') ? 'on' : '' %>"><%- icon('dashboard') %><span>Home</span></a>
        <a href="/agent/hotels" class="<%= bookPaths.some(isActive) ? 'on' : '' %>"><%- icon('search') %><span>Book</span></a>
        <a href="/agent/quotes" class="<%= isActive('/agent/quotes') ? 'on' : '' %>"><%- icon('file') %><span>Quotes</span></a>
        <a href="/agent/bookings" class="<%= isActive('/agent/bookings') ? 'on' : '' %>"><%- icon('clipboard') %><span>Bookings</span></a>
        <button type="button" data-nav-toggle aria-label="More"><%- icon('menu') %><span>More</span></button>
      </nav>
    <% } %>
  </div>
</div>
<script src="/js/app.js"></script>
</body>
</html>
