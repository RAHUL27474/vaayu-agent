<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'Document' %></title>
  <link rel="icon" href="<%= typeof favicon !== 'undefined' && favicon ? favicon : '/img/favicon.png' %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<div style="padding:0 16px">
  <% flash.forEach(f => { %><div class="doc-wrap" style="margin-bottom:0"><div class="alert <%= f.type %>"><%= f.message %></div></div><% }) %>
  <%- body %>
</div>
<script src="/js/app.js"></script>
</body>
</html>
