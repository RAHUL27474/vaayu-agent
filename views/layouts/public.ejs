<!doctype html>
<html lang="en">
<head>
  <script>document.documentElement.classList.add('js')</script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f4f8fb">
<%- include('../partials/meta') %>
  <link rel="icon" href="/img/favicon.png">
<% if (typeof site === 'undefined' || !site) { %>  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<% } %>
  <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="<%= asset('/css/app.css') %>">
  <link rel="stylesheet" href="<%= asset('/css/site.css') %>">
</head>
<body class="public">
<% if (typeof bare === 'undefined' || !bare) { %>
<header class="site-header<%= typeof overlayNav !== 'undefined' && overlayNav && !flash.length ? ' overlay' : '' %>">
<nav class="site-nav" aria-label="Main">
  <a class="logo" href="/"><img src="/img/vaayutrip-logo-sm.png" alt="VaayuTrip" width="171" height="58"></a>
  <button class="icon-btn site-menu-toggle" type="button" data-site-menu aria-label="Menu" aria-expanded="false" aria-controls="site-menu"><%- icon('menu') %></button>
  <div class="links site-menu" id="site-menu">
    <a href="/#features">Features</a>
    <a href="/#destinations">Destinations</a>
    <a href="/#calc">Your margin</a>
    <a href="/#how">How it works</a>
    <a href="/#faq">FAQ</a>
    <% if (user) { %>
      <a class="btn btn-primary" href="<%= user.role === 'admin' ? '/admin' : user.role === 'backend' ? '/backend' : '/agent' %>">Open portal</a>
    <% } else { %>
      <a href="/login" class="nav-login">Log in</a>
      <a class="btn btn-primary" href="/signup">Become a partner</a>
    <% } %>
  </div>
</nav>
</header>
<% } %>
<% if ((typeof bare === 'undefined' || !bare) && !body.includes('<div class="auth"')) flash.forEach(f => { %><div class="section" style="padding-top:0;padding-bottom:0"><div class="alert <%= f.type %>" role="<%= f.type === 'error' ? 'alert' : 'status' %>" data-flash><%= f.message %></div></div><% }) %>
<%- body %>
<% if (typeof bare === 'undefined' || !bare) { %>
<footer class="site-footer">
  <div class="inner foot-grid">
    <div class="foot-brand">
      <img src="/img/vaayutrip-logo-sm.png" alt="VaayuTrip DMC" class="footer-logo" width="189" height="64" loading="lazy">
      <p>B2B travel platform for agents: net rates, ready and custom packages, and invoices under your own brand.</p>
      <% if (waNumber) { %><a class="foot-wa" href="https://wa.me/<%= waNumber %>" target="_blank" rel="noopener">Chat on WhatsApp</a><% } %>
    </div>
    <div>
      <h4>Destinations</h4>
      <a href="/#destinations">Dubai</a><a href="/#destinations">Bali</a><a href="/#destinations">Vietnam</a><a href="/#destinations">Cambodia</a><a href="/#destinations">United Kingdom</a><a href="/#destinations">Europe</a>
    </div>
    <div>
      <h4>Partners</h4>
      <a href="/signup">Become a partner</a><a href="/login">Log in</a><a href="/#calc">Your margin</a><a href="/#how">How it works</a><a href="/#faq">FAQ</a>
    </div>
    <div>
      <h4>Contact</h4>
      <a href="mailto:<%= settings.email %>"><%= settings.email %></a>
      <span><%= settings.phone %></span>
      <span><%= settings.address %></span>
    </div>
  </div>
  <div class="inner foot-bottom">
    <span>© <%= new Date().getFullYear() %> <%= settings.legal_name %> · GSTIN <%= settings.gstin %></span>
    <span><a href="/terms">Terms of use</a> · <a href="/privacy">Privacy policy</a></span>
  </div>
</footer>
<% if (waNumber) { %>
<a class="wa-float" href="https://wa.me/<%= waNumber %>?text=<%- encodeURIComponent('Hi VaayuTrip, I run a travel agency and would like to know more about partnering with you.') %>" target="_blank" rel="noopener" aria-label="Chat with VaayuTrip on WhatsApp">
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path fill="#fff" d="M16 3C8.8 3 3 8.7 3 15.8c0 2.5.7 4.9 2 7L3 29l6.4-2c2 1.1 4.3 1.7 6.6 1.7 7.2 0 13-5.7 13-12.8S23.2 3 16 3zm0 23.4c-2.1 0-4.1-.6-5.9-1.7l-.4-.3-3.8 1.2 1.2-3.7-.3-.4a10.4 10.4 0 0 1-1.7-5.7C5.1 10 10 5.3 16 5.3S26.9 10 26.9 15.8 22 26.4 16 26.4zm6-7.8c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.7l.5-.6.3-.5c.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.5 2.5 1 3 .8 3.6.8.5-.1 1.9-.8 2.1-1.5.3-.7.3-1.3.2-1.5-.1-.2-.3-.2-.6-.4z"/></svg>
</a>
<% } %>
<% } %>
<script src="<%= asset('/js/app.js') %>"></script>
</body>
</html>
