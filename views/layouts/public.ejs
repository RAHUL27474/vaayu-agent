<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>VaayuTrip for Travel Agents</title>
  <meta name="description" content="VaayuTrip is the B2B travel platform for Indian travel agents: ready-made holiday packages, flights, hotels, branded invoices and your own website.">
  <link rel="icon" href="/img/vaayutrip-mark.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body style="background:#fff">
<% if (typeof bare === 'undefined' || !bare) { %>
<nav class="site-nav">
  <a class="logo" href="/"><img src="/img/vaayutrip-logo.svg" alt="VaayuTrip"></a>
  <div class="links">
    <a href="/#features">Features</a>
    <a href="/#invoices">Branded invoices</a>
    <a href="/#how">How it works</a>
    <a href="/#faq">FAQ</a>
    <% if (user) { %>
      <a class="btn btn-primary" href="<%= user.role === 'admin' ? '/admin' : '/agent' %>">Open portal</a>
    <% } else { %>
      <a href="/login">Log in</a>
      <a class="btn btn-primary" href="/signup">Become a partner</a>
    <% } %>
  </div>
</nav>
<% } %>
<% if (typeof bare === 'undefined' || !bare) flash.forEach(f => { %><div class="section" style="padding-top:0;padding-bottom:0"><div class="alert <%= f.type %>"><%= f.message %></div></div><% }) %>
<%- body %>
<% if (typeof bare === 'undefined' || !bare) { %>
<footer class="site-footer">
  <div class="inner">
    <div>
      <img src="/img/vaayutrip-mark.svg" alt="" style="height:28px;vertical-align:middle"> <b style="color:#fff">VaayuTrip</b>
      <div style="margin-top:8px"><%= settings.legal_name %> · GSTIN <%= settings.gstin %></div>
      <div><%= settings.address %></div>
    </div>
    <div>
      <div><a href="mailto:<%= settings.email %>"><%= settings.email %></a></div>
      <div><%= settings.phone %></div>
      <div style="margin-top:8px">© <%= new Date().getFullYear() %> VaayuTrip</div>
    </div>
  </div>
</footer>
<% if (settings.phone) { %>
<a class="wa-float" href="https://wa.me/<%= settings.phone.replace(/\D/g, '') %>?text=<%= encodeURIComponent('Hi VaayuTrip, I run a travel agency and would like to know more about partnering with you.') %>" target="_blank" rel="noopener" aria-label="Chat with VaayuTrip on WhatsApp">
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path fill="#fff" d="M16 3C8.8 3 3 8.7 3 15.8c0 2.5.7 4.9 2 7L3 29l6.4-2c2 1.1 4.3 1.7 6.6 1.7 7.2 0 13-5.7 13-12.8S23.2 3 16 3zm0 23.4c-2.1 0-4.1-.6-5.9-1.7l-.4-.3-3.8 1.2 1.2-3.7-.3-.4a10.4 10.4 0 0 1-1.7-5.7C5.1 10 10 5.3 16 5.3S26.9 10 26.9 15.8 22 26.4 16 26.4zm6-7.8c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.7l.5-.6.3-.5c.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.5 2.5 1 3 .8 3.6.8.5-.1 1.9-.8 2.1-1.5.3-.7.3-1.3.2-1.5-.1-.2-.3-.2-.6-.4z"/></svg>
</a>
<% } %>
<% } %>
<script src="/js/app.js"></script>
</body>
</html>
