<%# Your own login: details and password. Same page for agents, admins and the backend team. %>
<div class="page-head">
  <div><h1>My account</h1><p>Your login for the <%= user.role === 'agent' ? 'agent portal' : 'VaayuTrip team portal' %>.</p></div>
</div>
<div class="split">
  <form class="card" method="post" action="/account/password">
    <h3>Change password</h3>
    <p class="muted" style="font-size:13px">You'll stay logged in here; any other device using your account is logged out.</p>
    <input type="hidden" name="username" value="<%= me.email %>" autocomplete="username">
    <div class="field"><label for="current">Current password</label><input id="current" type="password" name="current" required autocomplete="current-password"></div>
    <div class="field"><label for="new-password">New password</label><input id="new-password" type="password" name="password" minlength="8" required autocomplete="new-password"><div class="hint">At least 8 characters. Avoid passwords you use elsewhere.</div></div>
    <div class="field"><label for="confirm">Confirm new password</label><input id="confirm" type="password" name="confirm" minlength="8" required autocomplete="new-password"></div>
    <button class="btn btn-primary"><%- icon('shield') %>Update password</button>
  </form>
  <div>
    <div class="card">
      <h3>Your details</h3>
      <dl class="kv">
        <dt>Name</dt><dd><%= me.name %></dd>
        <dt>Email</dt><dd><%= me.email %></dd>
        <% if (me.phone) { %><dt>Phone</dt><dd><%= me.phone %></dd><% } %>
        <dt>Member since</dt><dd><%= fmtDate(me.created_at) %></dd>
      </dl>
      <p class="muted" style="font-size:13px;margin:12px 0 0">To change your name or email, <%= user.role === 'agent' ? 'contact VaayuTrip support' : 'ask an administrator' %>.</p>
    </div>
    <div class="card" id="two-step">
      <h3>2-step login <% if (me.two_step) { %><span class="badge approved">On</span><% } else { %><span class="badge">Off</span><% } %></h3>
      <% if (me.two_step) { %>
        <p class="muted" style="font-size:13px">After your password we email a 6-digit code to <b><%= me.email %></b>. Someone who learns your password still can't get in.</p>
        <form method="post" action="/account/2step/off" data-confirm="Turn off 2-step login? Your password alone will be enough to log in.">
          <div class="field"><label for="off-pw">Your password</label><input id="off-pw" type="password" name="current" required autocomplete="current-password"></div>
          <button class="btn">Turn off</button>
        </form>
      <% } else if (!emailOn) { %>
        <p class="muted" style="font-size:13px">Available once email is set up on the portal.</p>
      <% } else { %>
        <p class="muted" style="font-size:13px">Recommended<%= user.role !== 'agent' ? ' for every VaayuTrip team member' : ' for owners' %>: after your password, we email a code to <b><%= me.email %></b>. Someone who learns your password still can't get in.</p>
        <form method="post" action="/account/2step/on">
          <div class="field"><label for="on-pw">Your password</label><input id="on-pw" type="password" name="current" required autocomplete="current-password"></div>
          <button class="btn btn-primary"><%- icon('shield') %>Turn on</button>
        </form>
      <% } %>
    </div>
    <% if (logins.length) { %>
    <div class="card flush">
      <div class="card-head"><h3>Recent logins</h3></div>
      <table class="table" style="margin-top:6px">
        <% logins.forEach((l, i) => { const where = (l.summary || '').split(' · ').slice(1).join(' · '); %>
          <tr><td style="white-space:nowrap"><%= fmtDate(l.created_at) %> <small class="muted"><%= fmtTime(l.created_at) %></small></td><td><small><%= where || 'details not recorded' %></small><%- i === 0 ? ' <span class="badge approved as-is">Current</span>' : '' %></td></tr>
        <% }) %>
      </table>
      <p class="muted" style="font-size:12.5px;padding:10px 16px;margin:0">Don't recognise one? Change your password now; that logs out every other device.</p>
    </div>
    <% } %>
  </div>
</div>
