<%# Your own login: details and password. Same page for agents, admins and the backend team. %>
<div class="page-head">
  <div><h1>My account</h1><p>Your login for the <%= user.role === 'agent' ? 'agent portal' : 'VaayuTrip team portal' %>.</p></div>
</div>
<div class="split">
  <form class="card" method="post" action="/account/password">
    <h3>Change password</h3>
    <p class="muted" style="font-size:13px">You'll stay logged in here; any other device using your account is logged out.</p>
    <input type="hidden" name="username" value="<%= me.email %>" autocomplete="username">
    <div class="field"><label for="current">Current password</label><input id="current" type="password" name="current" required autocomplete="current-password"></div>
    <div class="field"><label for="new-password">New password</label><input id="new-password" type="password" name="password" minlength="8" required autocomplete="new-password"><div class="hint">At least 8 characters. Avoid passwords you use elsewhere.</div></div>
    <div class="field"><label for="confirm">Confirm new password</label><input id="confirm" type="password" name="confirm" minlength="8" required autocomplete="new-password"></div>
    <button class="btn btn-primary"><%- icon('shield') %>Update password</button>
  </form>
  <div>
    <div class="card">
      <h3>Your details</h3>
      <dl class="kv">
        <dt>Name</dt><dd><%= me.name %></dd>
        <dt>Email</dt><dd><%= me.email %></dd>
        <% if (me.phone) { %><dt>Phone</dt><dd><%= me.phone %></dd><% } %>
        <dt>Member since</dt><dd><%= fmtDate(me.created_at) %></dd>
        <% if (lastLogin) { %><dt>Previous login</dt><dd><%= fmtDate(lastLogin.created_at) %> <%= lastLogin.created_at.slice(11, 16) %> UTC</dd><% } %>
      </dl>
      <p class="muted" style="font-size:13px;margin:12px 0 0">To change your name or email, <%= user.role === 'agent' ? 'contact VaayuTrip support' : 'ask an administrator' %>.</p>
    </div>
  </div>
</div>
