<a href="/admin/agents"><%- icon('arrowLeft') %>All agents</a>
<div class="page-head" style="margin-top:10px">
  <div style="display:flex;gap:14px;align-items:center">
    <% if (agent.logo_path) { %><img src="<%= agent.logo_path %>" alt="" style="height:44px;max-width:140px;object-fit:contain"><% } %>
    <div><h1><%= agent.name %></h1><p><span class="badge <%= agent.status %>"><%= agent.status %></span> · KYC <span class="badge <%= agent.kyc_status %>"><%= agent.kyc_status %></span> · <%= agent.city || '' %></p></div>
  </div>
  <div class="actions">
    <% if (agent.status !== 'active') { %>
      <form method="post" action="/admin/agents/<%= agent.id %>/status"><input type="hidden" name="status" value="active"><input type="hidden" name="kyc_status" value="verified"><button class="btn btn-primary" <%= missing.length ? 'disabled title="KYC documents incomplete"' : '' %>>Approve as agent</button></form>
    <% } %>
    <% if (agent.status === 'active') { %>
      <form method="post" action="/admin/agents/<%= agent.id %>/status" data-confirm="Suspend this agency? Its users will be logged out and its website taken offline."><input type="hidden" name="status" value="suspended"><button class="btn btn-danger">Suspend</button></form>
    <% } %>
    <% if (agent.status === 'active' && agent.website_enabled) { %><a class="btn" href="/site/<%= agent.slug %>" target="_blank">Agent website<%- icon('external') %></a><% } %>
  </div>
</div>

<% const indiaAgent = (agent.country || 'India') === 'India';
   const docs = [['tax_doc', indiaAgent ? 'GST certificate' : 'Tax certificate'], ...(indiaAgent ? [['pan_doc', 'PAN card']] : [])]; %>
<div class="card kyc-review" id="kyc">
  <div class="card-head">
    <h3>Verification documents</h3>
    <span class="badge <%= agent.kyc_status %>">KYC <%= agent.kyc_status %></span>
  </div>
  <div class="kyc-body">
    <div class="kyc-photo">
      <% if (agent.photo) { %><a href="/admin/agents/<%= agent.id %>/kyc/photo/view"><img src="/admin/agents/<%= agent.id %>/kyc/photo" alt="Photo of the applicant"></a><% } else { %><span class="kyc-nophoto"><%- icon('user') %><small>No photo</small></span><% } %>
      <small>Applicant: <b><%= users[0] ? users[0].name : '—' %></b></small>
    </div>
    <div class="kyc-docs">
      <dl class="kv">
        <dt>Country</dt><dd><%= agent.country || 'India' %></dd>
        <% if (indiaAgent) { %><dt>GSTIN</dt><dd><%= agent.gstin || '—' %></dd><dt>PAN</dt><dd><%= agent.pan || '—' %></dd><% } else { %><dt>Tax ID</dt><dd><%= agent.tax_id || '—' %></dd><% } %>
        <% docs.forEach(([f, label]) => { %>
          <dt><%= label %></dt>
          <dd><% if (agent[f]) { %><a class="btn btn-sm" href="/admin/agents/<%= agent.id %>/kyc/<%= f %>/view"><%- icon('file') %>View</a><% } else { %><span class="badge rejected">missing</span><% } %></dd>
        <% }) %>
        <dt>Photo</dt><dd><% if (agent.photo) { %><a class="btn btn-sm" href="/admin/agents/<%= agent.id %>/kyc/photo/view"><%- icon('user') %>View</a><% } else { %><span class="badge rejected">missing</span><% } %></dd>
      </dl>
      <% if (missing.length) { %><div class="alert warn" style="margin:14px 0 0"><%- icon('xCircle') %><span>Can't approve yet. Missing: <b><%= missing.join(', ') %></b>.</span></div><% } %>
    </div>
  </div>
  <div class="kyc-actions">
    <% if (agent.status !== 'active' || agent.kyc_status !== 'verified') { %>
      <form method="post" action="/admin/agents/<%= agent.id %>/status"><input type="hidden" name="status" value="active"><input type="hidden" name="kyc_status" value="verified"><button class="btn btn-primary" <%= missing.length ? 'disabled' : '' %>><%- icon('checkCircle') %>Approve as agent</button></form>
    <% } %>
    <form method="post" action="/admin/agents/<%= agent.id %>/kyc-reject" class="kyc-reject">
      <input name="reason" required maxlength="300" placeholder="Reason, e.g. PAN card photo is blurred" aria-label="Rejection reason">
      <button class="btn btn-danger"><%- icon('xCircle') %>Reject documents</button>
    </form>
  </div>
</div>

<div class="grid grid-4" style="margin-bottom:20px">
  <div class="stat"><div class="label">Wallet</div><div class="value"><%= inr(agent.wallet_balance) %></div></div>
  <div class="stat"><div class="label">Credit used</div><div class="value"><%= inr(agent.credit_used) %></div><div class="sub">of <%= inr(agent.credit_limit) %></div></div>
  <div class="stat"><div class="label">Bookings / net revenue</div><div class="value"><%= totals.n %></div><div class="sub"><%= inr(totals.revenue) %></div></div>
  <div class="stat"><div class="label">Agent's commission earned</div><div class="value profit"><%= inr(totals.commission) %></div><div class="sub">Default markup <%= agent.markup_type === 'flat' ? inr(agent.markup_value) : agent.markup_value + '%' %></div></div>
</div>

<div class="split">
  <div>
    <div class="card flush">
      <div class="card-head"><h3>Bookings</h3></div>
      <% if (!bookings.length) { %><div class="empty">No bookings yet.</div><% } else { %>
      <table class="table" style="margin-top:10px"><% bookings.forEach(b => { %><tr class="click" data-href="/admin/bookings/<%= b.id %>"><td><b><%= b.title %></b><br><small><%= b.code %> · <%= fmtDate(b.created_at) %></small></td><td><span class="badge <%= b.status %>"><%= b.status.replace('_', ' ') %></span></td><td class="num"><%= inr(b.total_net) %></td></tr><% }) %></table>
      <% } %>
    </div>
    <div class="card flush">
      <div class="card-head"><h3>Wallet transactions</h3></div>
      <% if (!txns.length) { %><div class="empty">None yet.</div><% } else { %>
      <table class="table" style="margin-top:10px"><% txns.forEach(t => { %><tr><td><%= fmtDate(t.created_at) %></td><td><span class="badge"><%= t.type %></span> <%= t.note || '' %> <small><%= t.ref || '' %></small></td><td class="num" style="color:<%= t.amount < 0 ? 'var(--bad)' : 'var(--ok)' %>"><%= t.amount < 0 ? '−' : '+' %><%= inr(Math.abs(t.amount)) %></td><td class="num"><%= inr(t.balance_after) %></td></tr><% }) %></table>
      <% } %>
    </div>
  </div>
  <div>
    <div class="card">
      <h3>Profile</h3>
      <dl class="kv">
        <dt>Legal name</dt><dd><%= agent.legal_name || '—' %></dd>
        <dt>Country</dt><dd><%= agent.country || 'India' %></dd>
        <dt>Phone</dt><dd><%= agent.phone || '—' %></dd>
        <dt>Email</dt><dd><%= agent.email || '—' %></dd>
        <dt>Address</dt><dd><%= [agent.address, agent.city].filter(Boolean).join(', ') || '—' %></dd>
        <dt id="users">Users</dt><dd><% users.forEach(u => { %>
          <div class="user-row"><%= u.name %> <small class="muted"><%= u.email %><%= u.phone ? ` · ${u.phone}` : '' %></small> <% if (u.email_verified === 0) { %><span class="badge pending">email not verified</span><% } %>
            <details class="inline-reset"><summary>Set new password</summary>
              <form method="post" action="/admin/agents/<%= agent.id %>/users/<%= u.id %>/password" data-confirm="Set a new password for <%= u.name %>? Verify the person by phone first.">
                <label class="sr-only" for="pw-<%= u.id %>">New password for <%= u.name %></label>
                <input id="pw-<%= u.id %>" type="text" name="password" minlength="8" required autocomplete="off" placeholder="At least 8 characters">
                <button class="btn btn-sm">Set</button>
              </form>
            </details>
          </div><% }) %></dd>
      </dl>
    </div>
    <form class="card" method="post" action="/admin/agents/<%= agent.id %>/tier">
      <h3>Rate tier</h3>
      <p class="muted" style="font-size:13px;margin:0 0 8px">Silver and Gold partners get lower net rates (Settings → tier discounts: Silver <%= settings.tier_silver_pct || 0 %>, Gold <%= settings.tier_gold_pct || 0 %> points off VaayuTrip's margin).</p>
      <div style="display:flex;gap:8px"><label class="sr-only" for="tier">Rate tier</label><select id="tier" name="rate_tier"><% [['standard', 'Standard'], ['silver', 'Silver'], ['gold', 'Gold']].forEach(([k, l]) => { %><option value="<%= k %>" <%= agent.rate_tier === k ? 'selected' : '' %>><%= l %></option><% }) %></select><button class="btn">Save</button></div>
    </form>
    <form class="card" method="post" action="/admin/agents/<%= agent.id %>/credit">
      <h3>Credit limit</h3>
      <div class="row">
        <div class="field"><label for="cl">Limit (₹)</label><input id="cl" type="number" min="0" step="1000" name="credit_limit" value="<%= agent.credit_limit %>"></div>
        <div class="field"><label for="cd">Repay within (days)</label><input id="cd" type="number" min="1" max="180" name="credit_days" value="<%= agent.credit_days %>"></div>
      </div>
      <% if (agent.credit_used > 0) { %><p class="muted" style="font-size:13px;margin:0 0 8px">Owes <b><%= inr(agent.credit_used) %></b><%= agent.credit_since ? ` since ${fmtDate(agent.credit_since)}` : '' %>.</p><% } %>
      <button class="btn">Update credit</button>
    </form>
    <form class="card" method="post" action="/admin/agents/<%= agent.id %>/wallet">
      <h3>Adjust wallet</h3>
      <div class="field"><label for="w-amount">Amount (₹, negative to debit)</label><input id="w-amount" type="number" step="0.01" name="amount" required></div>
      <div class="field"><label for="w-ref">Reference</label><input id="w-ref" name="ref" placeholder="UTR or note"></div>
      <div class="field"><label for="w-note">Note</label><input id="w-note" name="note" placeholder="e.g. Manual top-up"></div>
      <button class="btn btn-primary">Apply</button>
    </form>
    <form class="card" method="post" action="/admin/agents/<%= agent.id %>/status">
      <h3>KYC</h3>
      <div style="display:flex;gap:8px">
        <select name="kyc_status" aria-label="KYC status"><% ['pending', 'verified', 'rejected'].forEach(s => { %><option <%= agent.kyc_status === s ? 'selected' : '' %>><%= s %></option><% }) %></select>
        <button class="btn">Save</button>
      </div>
    </form>
  </div>
</div>
