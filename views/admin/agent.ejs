<a href="/admin/agents">← All agents</a>
<div class="page-head" style="margin-top:10px">
  <div style="display:flex;gap:14px;align-items:center">
    <% if (agent.logo_path) { %><img src="<%= agent.logo_path %>" alt="" style="height:44px;max-width:140px;object-fit:contain"><% } %>
    <div><h1><%= agent.name %></h1><p><span class="badge <%= agent.status %>"><%= agent.status %></span> · KYC <span class="badge <%= agent.kyc_status %>"><%= agent.kyc_status %></span> · <%= agent.city || '' %></p></div>
  </div>
  <div class="actions">
    <% if (agent.status !== 'active') { %>
      <form method="post" action="/admin/agents/<%= agent.id %>/status"><input type="hidden" name="status" value="active"><input type="hidden" name="kyc_status" value="verified"><button class="btn btn-primary">Approve &amp; verify KYC</button></form>
    <% } %>
    <% if (agent.status === 'active') { %>
      <form method="post" action="/admin/agents/<%= agent.id %>/status" data-confirm="Suspend this agency? Its users will be logged out and its website taken offline."><input type="hidden" name="status" value="suspended"><button class="btn btn-danger">Suspend</button></form>
    <% } %>
    <% if (agent.status === 'active' && agent.website_enabled) { %><a class="btn" href="/site/<%= agent.slug %>" target="_blank">Agent website ↗</a><% } %>
  </div>
</div>

<div class="grid grid-4" style="margin-bottom:20px">
  <div class="stat"><div class="label">Wallet</div><div class="value"><%= inr(agent.wallet_balance) %></div></div>
  <div class="stat"><div class="label">Credit used</div><div class="value"><%= inr(agent.credit_used) %></div><div class="sub">of <%= inr(agent.credit_limit) %></div></div>
  <div class="stat"><div class="label">Bookings / net revenue</div><div class="value"><%= totals.n %></div><div class="sub"><%= inr(totals.revenue) %></div></div>
  <div class="stat"><div class="label">Agent's commission earned</div><div class="value profit"><%= inr(totals.commission) %></div><div class="sub">Default markup <%= agent.markup_type === 'flat' ? inr(agent.markup_value) : agent.markup_value + '%' %></div></div>
</div>

<div class="split">
  <div>
    <div class="card flush">
      <div class="card-head"><h3>Bookings</h3></div>
      <% if (!bookings.length) { %><div class="empty">No bookings yet.</div><% } else { %>
      <table class="table" style="margin-top:10px"><% bookings.forEach(b => { %><tr class="click" data-href="/admin/bookings/<%= b.id %>"><td><b><%= b.title %></b><br><small><%= b.code %> · <%= fmtDate(b.created_at) %></small></td><td><span class="badge <%= b.status %>"><%= b.status.replace('_', ' ') %></span></td><td class="num"><%= inr(b.total_net) %></td></tr><% }) %></table>
      <% } %>
    </div>
    <div class="card flush">
      <div class="card-head"><h3>Wallet transactions</h3></div>
      <% if (!txns.length) { %><div class="empty">None yet.</div><% } else { %>
      <table class="table" style="margin-top:10px"><% txns.forEach(t => { %><tr><td><%= fmtDate(t.created_at) %></td><td><span class="badge"><%= t.type %></span> <%= t.note || '' %> <small><%= t.ref || '' %></small></td><td class="num" style="color:<%= t.amount < 0 ? 'var(--bad)' : 'var(--ok)' %>"><%= t.amount < 0 ? '−' : '+' %><%= inr(Math.abs(t.amount)) %></td><td class="num"><%= inr(t.balance_after) %></td></tr><% }) %></table>
      <% } %>
    </div>
  </div>
  <div>
    <div class="card">
      <h3>Profile</h3>
      <dl class="kv">
        <dt>Legal name</dt><dd><%= agent.legal_name || '—' %></dd>
        <dt>Country</dt><dd><%= agent.country || 'India' %></dd>
        <% if ((agent.country || 'India') === 'India') { %><dt>GSTIN</dt><dd><%= agent.gstin || '—' %></dd><% } else { %><dt>Tax ID</dt><dd><%= agent.tax_id || '—' %></dd><% } %>
        <dt>Tax certificate</dt><dd><% if (agent.tax_doc) { %><a href="/admin/agents/<%= agent.id %>/tax-doc" target="_blank" rel="noopener">View document</a><% } else { %><span class="badge rejected">missing</span><% } %></dd>
        <dt>PAN</dt><dd><%= agent.pan || '—' %></dd>
        <dt>Phone</dt><dd><%= agent.phone || '—' %></dd>
        <dt>Email</dt><dd><%= agent.email || '—' %></dd>
        <dt>Address</dt><dd><%= [agent.address, agent.city].filter(Boolean).join(', ') || '—' %></dd>
        <dt>Users</dt><dd><% users.forEach(u => { %><div><%= u.name %> <small class="muted"><%= u.email %></small></div><% }) %></dd>
      </dl>
    </div>
    <form class="card" method="post" action="/admin/agents/<%= agent.id %>/credit">
      <h3>Credit limit</h3>
      <div style="display:flex;gap:8px"><input type="number" min="0" step="1000" name="credit_limit" value="<%= agent.credit_limit %>" aria-label="Credit limit"><button class="btn">Update</button></div>
    </form>
    <form class="card" method="post" action="/admin/agents/<%= agent.id %>/wallet">
      <h3>Adjust wallet</h3>
      <div class="field"><label for="w-amount">Amount (₹, negative to debit)</label><input id="w-amount" type="number" step="0.01" name="amount" required></div>
      <div class="field"><label for="w-ref">Reference</label><input id="w-ref" name="ref" placeholder="UTR or note"></div>
      <div class="field"><label for="w-note">Note</label><input id="w-note" name="note" placeholder="e.g. Manual top-up"></div>
      <button class="btn btn-primary">Apply</button>
    </form>
    <form class="card" method="post" action="/admin/agents/<%= agent.id %>/status">
      <h3>KYC</h3>
      <div style="display:flex;gap:8px">
        <select name="kyc_status" aria-label="KYC status"><% ['pending', 'verified', 'rejected'].forEach(s => { %><option <%= agent.kyc_status === s ? 'selected' : '' %>><%= s %></option><% }) %></select>
        <button class="btn">Save</button>
      </div>
    </form>
  </div>
</div>
