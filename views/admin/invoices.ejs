<div class="page-head"><div><h1>Invoices</h1><p>VaayuTrip's B2B invoices to agents, VaayuTrip invoices sent to customers by agents, and agents' own branded invoices.</p></div></div>
<div class="tabs">
  <% [['', 'All'], ['b2b', 'VaayuTrip → agent'], ['customer_vaayu', 'VaayuTrip → customer'], ['customer_agent', "Agents' own"]].forEach(([k, label]) => { %>
    <a href="/admin/invoices<%= k ? '?kind=' + k : '' %>" class="<%= kind === k ? 'active' : '' %>"><%= label %></a>
  <% }) %>
</div>
<div class="card flush">
  <% if (!invoices.length) { %><div class="empty">No invoices.</div><% } else { %>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>Number</th><th>Type</th><th>Agent</th><th>Billed to</th><th class="num">Total</th></tr></thead>
    <% invoices.forEach(i => { %>
      <tr class="click" data-href="/admin/invoices/<%= i.id %>">
        <td><b><%= i.number %></b><br><small><%= fmtDate(i.created_at) %></small></td>
        <td><span class="badge"><%= { customer_agent: "Agent's own", customer_vaayu: 'VaayuTrip → customer', b2b: 'VaayuTrip → agent' }[i.kind] %></span></td>
        <td><%= i.agency_name %></td>
        <td><%= i.doc.buyer.legalName || i.doc.buyer.name %></td>
        <td class="num"><%= inr(i.total, { decimals: 2 }) %></td>
      </tr>
    <% }) %>
  </table></div>
  <% } %>
</div>
