<div class="page-head"><div><h1>Wallet top-up requests</h1><p>Verify the UTR in your bank statement, then approve to credit the agent's wallet.</p></div></div>
<div class="card flush">
  <% if (!requests.length) { %><div class="empty">No requests.</div><% } else { %>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>Agent</th><th>UTR</th><th>Requested</th><th class="num">Amount</th><th>Status</th><th></th></tr></thead>
    <% requests.forEach(r => { %>
      <tr>
        <td><a href="/admin/agents/<%= r.agency_id %>"><b><%= r.agency_name %></b></a><br><small>Wallet <%= inr(r.wallet_balance) %></small></td>
        <td><code><%= r.utr || '—' %></code></td>
        <td><%= fmtDate(r.created_at) %></td>
        <td class="num"><b><%= inr(r.amount) %></b></td>
        <td><span class="badge <%= r.status %>"><%= r.status %></span></td>
        <td class="num">
          <% if (r.status === 'pending') { %>
            <form method="post" action="/admin/topups/<%= r.id %>/approve" class="inline"><button class="btn btn-sm btn-primary">Approve</button></form>
            <form method="post" action="/admin/topups/<%= r.id %>/reject" class="inline"><button class="btn btn-sm btn-danger">Reject</button></form>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </table></div>
  <% } %>
</div>
