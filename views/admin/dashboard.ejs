<%
  const hr = Number(new Date().toLocaleString('en-GB', { hour: 'numeric', hour12: false, timeZone: 'Asia/Kolkata' }));
  const hello = hr < 12 ? 'Good morning' : hr < 17 ? 'Good afternoon' : 'Good evening';
  const todo = [
    stats.pendingAgents && { href: '/admin/agents?status=pending', n: stats.pendingAgents, label: stats.pendingAgents === 1 ? 'agent to approve' : 'agents to approve', tone: 'warn' },
    stats.cancelRequests && { href: '/admin/bookings?status=cancel_requested', n: stats.cancelRequests, label: stats.cancelRequests === 1 ? 'cancellation request' : 'cancellation requests', tone: 'warn' },
    pendingTopups && { href: '/admin/topups', n: pendingTopups, label: pendingTopups === 1 ? 'top-up to verify' : 'top-ups to verify', tone: 'warn' },
    stats.websiteRequests && { href: '/admin/agents', n: stats.websiteRequests, label: stats.websiteRequests === 1 ? 'website request' : 'website requests', tone: 'info' },
  ].filter(Boolean);
%>
<%- include('../partials/console-hero', {
  kicker: 'Admin console', title: /^vaayutrip$/i.test(user.name.split(' ')[0]) ? hello : `${hello}, ${user.name.split(' ')[0]}`,
  line: `${plural(stats.bookings, 'booking')} and ${inr(stats.revenue)} net this month, from ${plural(stats.agents, 'active agency', 'active agencies')}.`,
  chips: todo, clear: 'Nothing waiting for you',
  actions: [{ href: '/admin/log', label: 'Activity log', icon: 'activity' }, { href: '/backend', label: 'Inventory', icon: 'layers', primary: true }],
}) %>

<div class="grid grid-4 tone-cards" style="margin-bottom:20px">
  <div class="stat tone-green"><span class="stat-ico"><%- icon('chart') %></span><div class="label">Revenue this month (net)</div><div class="value"><%= inr(stats.revenue) %></div><div class="sub"><%= plural(stats.bookings, 'booking') %></div></div>
  <a class="stat tone-violet" href="/admin/agents" style="color:inherit;text-decoration:none"><span class="stat-ico"><%- icon('building') %></span><div class="label">Active agents</div><div class="value"><%= stats.agents %></div><div class="sub"><%= stats.pendingAgents %> pending</div></a>
  <a class="stat tone-teal" href="/backend" style="color:inherit;text-decoration:none"><span class="stat-ico"><%- icon('layers') %></span><div class="label">Live inventory</div><div class="value"><%= stats.products %></div><div class="sub"><%= plural(stats.drafts, 'draft') %> · <%= plural(stats.agentPackages, 'package') %> built by agents</div></a>
  <a class="stat tone-amber" href="/admin/ledger" style="color:inherit;text-decoration:none"><span class="stat-ico"><%- icon('wallet') %></span><div class="label">Agent wallets / credit out</div><div class="value"><%= inr(stats.walletFloat) %></div><div class="sub"><%= inr(stats.creditOut) %> credit used</div></a>
</div>

<%
  const short = (v) => v >= 1e7 ? `₹${(v / 1e7).toFixed(1)}Cr` : v >= 1e5 ? `₹${(v / 1e5).toFixed(1)}L` : v >= 1e3 ? `₹${Math.round(v / 1e3)}k` : inr(v);
%>
<div class="biz">
  <div class="card-head" style="padding:0 0 12px"><h2 style="margin:0;font-size:18px">Business, last 12 months</h2></div>
  <div class="grid grid-4 tone-cards" style="margin-bottom:16px">
    <div class="stat tone-blue"><span class="stat-ico"><%- icon('sparkles') %></span><div class="label">This month's revenue</div><div class="value"><%= inr(biz.cur.revenue) %></div><div class="sub"><% if (biz.change !== null) { %><span class="<%= biz.change >= 0 ? 'up' : 'down' %>"><%= biz.change >= 0 ? '▲' : '▼' %> <%= Math.abs(biz.change) %>%</span> vs <%= biz.prev.label %><% } else { %>no bookings last month<% } %></div></div>
    <div class="stat tone-green"><span class="stat-ico"><%- icon('chart') %></span><div class="label">12-month revenue</div><div class="value"><%= short(biz.yearRevenue) %></div><div class="sub">Est. margin <%= short(biz.yearMargin) %></div></div>
    <div class="stat tone-violet"><span class="stat-ico"><%- icon('receipt') %></span><div class="label">Average booking</div><div class="value"><%= inr(biz.avgBooking) %></div><div class="sub">net to VaayuTrip</div></div>
    <div class="stat tone-pink"><span class="stat-ico"><%- icon('percent') %></span><div class="label">Cancellation rate</div><div class="value"><%= biz.cancelRate %>%</div><div class="sub">of bookings in 12 months</div></div>
  </div>
  <div class="grid grid-2">
    <div class="card"><h2 class="h3">Revenue by month</h2><%- include('../partials/bar-chart', { id: 'revenue', bars: biz.months.map(m => ({ label: m.label, value: Math.round(m.revenue), note: plural(m.bookings || 0, 'booking') })), format: short }) %></div>
    <div class="card"><h2 class="h3">Estimated VaayuTrip margin</h2><%- include('../partials/bar-chart', { id: 'margin', bars: biz.months.map(m => ({ label: m.label, value: Math.round(m.margin) })), format: short }) %><p class="muted" style="font-size:12px;margin:8px 0 0">From each service's margin % in Settings.</p></div>
  </div>
  <div class="grid grid-3">
    <div class="card"><h2 class="h3">Top agencies</h2><%- include('../partials/hbars', { id: 'agencies', rows: biz.agencies, format: short }) %></div>
    <div class="card"><h2 class="h3">Top destinations</h2><%- include('../partials/hbars', { id: 'destinations', rows: biz.destinations, format: short }) %></div>
    <div class="card"><h2 class="h3">Sales by service</h2><%- include('../partials/hbars', { id: 'services', rows: biz.services, format: short }) %></div>
  </div>
</div>

<div class="card flush">
  <div class="card-head"><h2 class="h3">Latest bookings</h2><a href="/admin/bookings">All bookings</a></div>
  <% if (!bookings.length) { %><div class="empty">No bookings yet.</div><% } else { %>
  <div class="table-wrap"><table class="table" style="margin-top:10px">
    <thead><tr><th>Booking</th><th>Agent</th><th>Travel</th><th>Status</th><th class="num">Net to VaayuTrip</th></tr></thead>
    <% bookings.forEach(b => { %>
      <tr class="click" data-href="/admin/bookings/<%= b.id %>"><td><b><%= b.title %></b><br><small><%= b.code %></small></td><td><%= b.agency_name %></td><td><%= fmtDate(b.travel_date) || '—' %></td><td><span class="badge <%= b.status %>"><%= b.status.replace('_', ' ') %></span></td><td class="num"><%= inr(b.total_net) %></td></tr>
    <% }) %>
  </table></div>
  <% } %>
</div>

<div class="grid grid-3">
  <div class="card flush">
    <div class="card-head"><h2 class="h3">Top agents</h2><small class="muted">last 90 days</small></div>
    <% if (!topAgents.length) { %><div class="empty">No bookings in 90 days.</div><% } %>
    <table class="table" style="margin-top:10px">
      <% topAgents.forEach(a => { %><tr class="click" data-href="/admin/agents/<%= a.id %>"><td><b><%= a.name %></b><br><small><%= a.city || '' %> · <%= plural(a.bookings, 'booking') %></small></td><td class="num"><%= inr(a.revenue) %></td></tr><% }) %>
    </table>
  </div>
  <div class="card flush">
    <div class="card-head"><h2 class="h3">Most booked inventory</h2><a href="/backend/products">All</a></div>
    <table class="table" style="margin-top:10px">
      <% topProducts.forEach(p => { %><tr class="click" data-href="/backend/products/<%= p.id %>"><td><%= p.title %><br><small><%= kinds[p.kind].label %> · <%= p.city %></small></td><td class="num nowrap"><%= p.bookings %> booked</td></tr><% }) %>
    </table>
  </div>
  <div class="card flush">
    <div class="card-head"><h2 class="h3">Awaiting approval</h2></div>
    <% if (!pending.length) { %><div class="empty">Nothing waiting for approval.</div><% } else { %>
    <table class="table" style="margin-top:10px">
      <% pending.forEach(a => { %><tr class="click" data-href="/admin/agents/<%= a.id %>"><td><b><%= a.name %></b><br><small><%= a.city || '' %> · <%= fmtDate(a.created_at) %></small></td><td class="num"><span class="badge pending">Review</span></td></tr><% }) %>
    </table>
    <% } %>
  </div>
</div>

<% if (quietAgents.length) { %>
<div class="card flush">
  <div class="card-head"><h2 class="h3">Agents gone quiet</h2><small class="muted">no booking in 60 days · give them a call</small></div>
  <div class="table-wrap"><table class="table" style="margin-top:6px">
    <% quietAgents.forEach(a => { %><tr class="click" data-href="/admin/agents/<%= a.id %>">
      <td><b><%= a.name %></b><br><small><%= a.city || '' %></small></td>
      <td><small class="muted">Last booking</small><br><%= a.last_booking ? fmtDate(a.last_booking) : 'never' %></td>
      <td><small class="muted">Last login</small><br><%= a.last_login ? fmtDate(a.last_login) : 'never' %></td>
      <td class="num"><% if (a.phone) { %><a class="btn btn-sm" href="tel:<%= a.phone %>" onclick="event.stopPropagation()"><%- icon('phone') %>Call</a><% } %></td>
    </tr><% }) %>
  </table></div>
</div>
<% } %>

<div class="card flush">
  <div class="card-head"><h2 class="h3">Latest activity</h2><a href="/admin/log">Full activity log</a></div>
  <%- include('../partials/log-table', { entries: recentLog }) %>
</div>
