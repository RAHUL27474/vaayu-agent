<div class="page-head">
  <div><h1>VaayuTrip HQ</h1><p>Partner network, catalogue and bookings at a glance.</p></div>
  <div class="actions"><a class="btn" href="/admin/agents?status=pending">Review agents</a><a class="btn" href="/admin/log">Activity log</a><a class="btn btn-primary" href="/backend">Inventory</a></div>
</div>

<% if (stats.pendingAgents || stats.cancelRequests || pendingTopups || stats.websiteRequests) { %>
  <div class="alert warn">
    Needs attention:
    <%- [
      stats.pendingAgents && `<a href="/admin/agents?status=pending">${plural(stats.pendingAgents, 'agent')} awaiting approval</a>`,
      stats.cancelRequests && `<a href="/admin/bookings?status=cancel_requested">${plural(stats.cancelRequests, 'cancellation request')}</a>`,
      pendingTopups && `<a href="/admin/topups">${plural(pendingTopups, 'wallet top-up')} to verify</a>`,
      stats.websiteRequests && `<a href="/admin/agents">${plural(stats.websiteRequests, 'website request')} to call back</a>`,
    ].filter(Boolean).join(' · ') %>
  </div>
<% } %>

<div class="grid grid-4" style="margin-bottom:20px">
  <div class="stat"><div class="label">Revenue this month (net)</div><div class="value"><%= inr(stats.revenue) %></div><div class="sub"><%= plural(stats.bookings, 'booking') %></div></div>
  <div class="stat"><div class="label">Active agents</div><div class="value"><%= stats.agents %></div><div class="sub"><%= stats.pendingAgents %> pending</div></div>
  <a class="stat" href="/backend" style="color:inherit;text-decoration:none"><div class="label">Live inventory</div><div class="value"><%= stats.products %></div><div class="sub"><%= plural(stats.drafts, 'draft') %> · <%= plural(stats.agentPackages, 'package') %> built by agents</div></a>
  <div class="stat"><div class="label">Agent wallets / credit out</div><div class="value"><%= inr(stats.walletFloat) %></div><div class="sub"><%= inr(stats.creditOut) %> credit used</div></div>
</div>

<%
  const short = (v) => v >= 1e7 ? `₹${(v / 1e7).toFixed(1)}Cr` : v >= 1e5 ? `₹${(v / 1e5).toFixed(1)}L` : v >= 1e3 ? `₹${Math.round(v / 1e3)}k` : inr(v);
%>
<div class="biz">
  <div class="card-head" style="padding:0 0 12px"><h2 style="margin:0;font-size:18px">Business, last 12 months</h2></div>
  <div class="grid grid-4" style="margin-bottom:16px">
    <div class="stat"><div class="label">This month's revenue</div><div class="value"><%= inr(biz.cur.revenue) %></div><div class="sub"><% if (biz.change !== null) { %><span class="<%= biz.change >= 0 ? 'up' : 'down' %>"><%= biz.change >= 0 ? '▲' : '▼' %> <%= Math.abs(biz.change) %>%</span> vs <%= biz.prev.label %><% } else { %>no bookings last month<% } %></div></div>
    <div class="stat"><div class="label">12-month revenue</div><div class="value"><%= short(biz.yearRevenue) %></div><div class="sub">Est. margin <%= short(biz.yearMargin) %></div></div>
    <div class="stat"><div class="label">Average booking</div><div class="value"><%= inr(biz.avgBooking) %></div><div class="sub">net to VaayuTrip</div></div>
    <div class="stat"><div class="label">Cancellation rate</div><div class="value"><%= biz.cancelRate %>%</div><div class="sub">of bookings in 12 months</div></div>
  </div>
  <div class="grid grid-2">
    <div class="card"><h3>Revenue by month</h3><%- include('../partials/bar-chart', { bars: biz.months.map(m => ({ label: m.label, value: Math.round(m.revenue), note: `${m.bookings || 0} bookings` })), format: short }) %></div>
    <div class="card"><h3>Estimated VaayuTrip margin</h3><%- include('../partials/bar-chart', { bars: biz.months.map(m => ({ label: m.label, value: Math.round(m.margin) })), format: short }) %><p class="muted" style="font-size:12px;margin:8px 0 0">From each service's margin % in Settings.</p></div>
  </div>
  <div class="grid grid-3">
    <div class="card"><h3>Top agencies</h3><%- include('../partials/hbars', { rows: biz.agencies, format: short }) %></div>
    <div class="card"><h3>Top destinations</h3><%- include('../partials/hbars', { rows: biz.destinations, format: short }) %></div>
    <div class="card"><h3>Sales by service</h3><%- include('../partials/hbars', { rows: biz.services, format: short }) %></div>
  </div>
</div>

<div class="card flush">
  <div class="card-head"><h3>Latest bookings</h3><a href="/admin/bookings">All bookings</a></div>
  <% if (!bookings.length) { %><div class="empty">No bookings yet.</div><% } else { %>
  <div class="table-wrap"><table class="table" style="margin-top:10px">
    <thead><tr><th>Booking</th><th>Agent</th><th>Travel</th><th>Status</th><th class="num">Net to VaayuTrip</th></tr></thead>
    <% bookings.forEach(b => { %>
      <tr class="click" data-href="/admin/bookings/<%= b.id %>"><td><b><%= b.title %></b><br><small><%= b.code %></small></td><td><%= b.agency_name %></td><td><%= fmtDate(b.travel_date) || '—' %></td><td><span class="badge <%= b.status %>"><%= b.status.replace('_', ' ') %></span></td><td class="num"><%= inr(b.total_net) %></td></tr>
    <% }) %>
  </table></div>
  <% } %>
</div>

<div class="grid grid-3">
  <div class="card flush">
    <div class="card-head"><h3>Top agents</h3><small class="muted">last 90 days</small></div>
    <% if (!topAgents.length) { %><div class="empty">No bookings in 90 days.</div><% } %>
    <table class="table" style="margin-top:10px">
      <% topAgents.forEach(a => { %><tr class="click" data-href="/admin/agents/<%= a.id %>"><td><b><%= a.name %></b><br><small><%= a.city || '' %> · <%= plural(a.bookings, 'booking') %></small></td><td class="num"><%= inr(a.revenue) %></td></tr><% }) %>
    </table>
  </div>
  <div class="card flush">
    <div class="card-head"><h3>Most booked inventory</h3><a href="/backend/products">All</a></div>
    <table class="table" style="margin-top:10px">
      <% topProducts.forEach(p => { %><tr class="click" data-href="/backend/products/<%= p.id %>"><td><%= p.title %><br><small><%= kinds[p.kind].label %> · <%= p.city %></small></td><td class="num nowrap"><%= p.bookings %> booked</td></tr><% }) %>
    </table>
  </div>
  <div class="card flush">
    <div class="card-head"><h3>Awaiting approval</h3></div>
    <% if (!pending.length) { %><div class="empty">Nothing waiting for approval.</div><% } else { %>
    <table class="table" style="margin-top:10px">
      <% pending.forEach(a => { %><tr class="click" data-href="/admin/agents/<%= a.id %>"><td><b><%= a.name %></b><br><small><%= a.city || '' %> · <%= fmtDate(a.created_at) %></small></td><td class="num"><span class="badge pending">Review</span></td></tr><% }) %>
    </table>
    <% } %>
  </div>
</div>

<% if (quietAgents.length) { %>
<div class="card flush">
  <div class="card-head"><h3>Agents gone quiet</h3><small class="muted">no booking in 60 days · give them a call</small></div>
  <div class="table-wrap"><table class="table" style="margin-top:6px">
    <% quietAgents.forEach(a => { %><tr class="click" data-href="/admin/agents/<%= a.id %>">
      <td><b><%= a.name %></b><br><small><%= a.city || '' %></small></td>
      <td><small class="muted">Last booking</small><br><%= a.last_booking ? fmtDate(a.last_booking) : 'never' %></td>
      <td><small class="muted">Last login</small><br><%= a.last_login ? fmtDate(a.last_login) : 'never' %></td>
      <td class="num"><% if (a.phone) { %><a class="btn btn-sm" href="tel:<%= a.phone %>" onclick="event.stopPropagation()"><%- icon('phone') %>Call</a><% } %></td>
    </tr><% }) %>
  </table></div>
</div>
<% } %>

<div class="card flush">
  <div class="card-head"><h3>Latest activity</h3><a href="/admin/log">Full activity log</a></div>
  <%- include('../partials/log-table', { entries: recentLog }) %>
</div>
