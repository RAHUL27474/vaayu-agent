<div class="page-head">
  <div><h1>VaayuTrip HQ</h1><p>Partner network, catalogue and bookings at a glance.</p></div>
  <div class="actions"><a class="btn" href="/admin/agents?status=pending">Review agents</a><a class="btn btn-primary" href="/admin/activities/new">+ New activity</a></div>
</div>

<% if (stats.pendingAgents || stats.cancelRequests || pendingTopups) { %>
  <div class="alert warn">
    Needs attention:
    <% if (stats.pendingAgents) { %><a href="/admin/agents?status=pending"><%= stats.pendingAgents %> agent<%= stats.pendingAgents > 1 ? 's' : '' %> awaiting approval</a> · <% } %>
    <% if (stats.cancelRequests) { %><a href="/admin/bookings?status=cancel_requested"><%= stats.cancelRequests %> cancellation request<%= stats.cancelRequests > 1 ? 's' : '' %></a> · <% } %>
    <% if (pendingTopups) { %><a href="/admin/topups"><%= pendingTopups %> wallet top-up<%= pendingTopups > 1 ? 's' : '' %> to verify</a><% } %>
  </div>
<% } %>

<div class="grid grid-4" style="margin-bottom:20px">
  <div class="stat"><div class="label">Revenue this month (net)</div><div class="value"><%= inr(stats.revenue) %></div><div class="sub"><%= stats.bookings %> bookings</div></div>
  <div class="stat"><div class="label">Active agents</div><div class="value"><%= stats.agents %></div><div class="sub"><%= stats.pendingAgents %> pending</div></div>
  <div class="stat"><div class="label">Live activities</div><div class="value"><%= stats.activities %></div><div class="sub"><%= stats.agentPackages %> packages built by agents</div></div>
  <div class="stat"><div class="label">Agent wallets / credit out</div><div class="value"><%= inr(stats.walletFloat) %></div><div class="sub"><%= inr(stats.creditOut) %> credit used</div></div>
</div>

<div class="card flush">
  <div class="card-head"><h3>Latest bookings</h3><a href="/admin/bookings">All bookings</a></div>
  <% if (!bookings.length) { %><div class="empty">No bookings yet.</div><% } else { %>
  <div class="table-wrap"><table class="table" style="margin-top:10px">
    <thead><tr><th>Booking</th><th>Agent</th><th>Travel</th><th>Status</th><th class="num">Net to VaayuTrip</th></tr></thead>
    <% bookings.forEach(b => { %>
      <tr class="click" data-href="/admin/bookings/<%= b.id %>"><td><b><%= b.title %></b><br><small><%= b.code %></small></td><td><%= b.agency_name %></td><td><%= fmtDate(b.travel_date) || '—' %></td><td><span class="badge <%= b.status %>"><%= b.status.replace('_', ' ') %></span></td><td class="num"><%= inr(b.total_net) %></td></tr>
    <% }) %>
  </table></div>
  <% } %>
</div>

<div class="grid grid-3">
  <div class="card flush">
    <div class="card-head"><h3>Top agents</h3></div>
    <table class="table" style="margin-top:10px">
      <% topAgents.forEach(a => { %><tr class="click" data-href="/admin/agents/<%= a.id %>"><td><b><%= a.name %></b><br><small><%= a.city || '' %> · <%= a.bookings %> bookings</small></td><td class="num"><%= inr(a.revenue) %></td></tr><% }) %>
    </table>
  </div>
  <div class="card flush">
    <div class="card-head"><h3>Top activities</h3><a href="/admin/activities">All</a></div>
    <table class="table" style="margin-top:10px">
      <% topActivities.forEach(a => { %><tr class="click" data-href="/admin/activities/<%= a.id %>"><td><%= a.title %><br><small><%= a.city %></small></td><td class="num"><%= a.bookings %> booked</td></tr><% }) %>
    </table>
  </div>
  <div class="card flush">
    <div class="card-head"><h3>Awaiting approval</h3></div>
    <% if (!pending.length) { %><div class="empty">None 🎉</div><% } else { %>
    <table class="table" style="margin-top:10px">
      <% pending.forEach(a => { %><tr class="click" data-href="/admin/agents/<%= a.id %>"><td><b><%= a.name %></b><br><small><%= a.city || '' %> · <%= fmtDate(a.created_at) %></small></td><td class="num"><span class="badge pending">Review</span></td></tr><% }) %>
    </table>
    <% } %>
  </div>
</div>
