<%
  const qs = (over) => '?' + new URLSearchParams(Object.entries({ ...f, logins: f.logins ? '1' : '', ...over }).filter(([, v]) => v !== '' && v !== false && v != null)).toString();
  // Same icon and colour per area as the rows below.
  const AREA = {
    booking: ['clipboard', 'green'], quote: ['file', 'blue'], product: ['layers', 'teal'], package: ['briefcase', 'teal'], agency: ['building', 'violet'],
    topup: ['topup', 'amber'], wallet: ['wallet', 'amber'], user: ['user', 'slate'], offer: ['tag', 'pink'], settings: ['settings', 'slate'], ticket: ['message', 'blue'], enquiry: ['inbox', 'violet'],
  };
  const ar = (k) => AREA[k] || ['activity', 'slate'];
  // 12 weeks of changes, Monday to Sunday, ending this week.
  const perDay = Object.fromEntries(daily.map((r) => [r.d, Number(r.n)]));
  const today = new Date(new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' }) + 'T00:00:00Z');
  const start = new Date(today); start.setUTCDate(start.getUTCDate() - ((today.getUTCDay() + 6) % 7) - 7 * 11);
  const weeks = [...Array(12)].map((_, w) => [...Array(7)].map((_, d) => {
    const day = new Date(start); day.setUTCDate(start.getUTCDate() + w * 7 + d);
    const k = day.toISOString().slice(0, 10);
    return { k, n: perDay[k] || 0, future: day > today, label: day.toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' }) };
  }));
  const peak = Math.max(1, ...daily.map((r) => Number(r.n)));
  const level = (n) => (!n ? 0 : Math.min(4, Math.ceil(n / peak * 4)));
  const total84 = daily.reduce((s, r) => s + Number(r.n), 0);
  const activeDays = daily.filter((r) => Number(r.n)).length;
  const monthOf = (w) => { const first = new Date(w[0].k + 'T00:00:00Z'); return first.getUTCDate() <= 7 ? first.toLocaleDateString('en-IN', { month: 'short', timeZone: 'UTC' }) : ''; };
%>
<div class="page-head">
  <div><h1>Activity log</h1><p>Everything that changes on VaayuTrip: inventory entered by the backend team, agents' packages, quotes and bookings, and admin decisions.</p></div><%- include('../partials/export-btn', { wrap: true }) %>
</div>
<div class="grid grid-4 tone-cards log-figs" style="margin-bottom:16px">
  <div class="stat tone-blue <%= Number(pulse.today) ? '' : 'is-zero' %>"><span class="stat-ico"><%- icon('clock') %></span><div class="label">Changes today</div><div class="value"><%= pulse.today %></div><div class="sub"><%= Number(pulse.today) ? 'Since midnight IST' : 'Nothing yet today' %></div></div>
  <div class="stat tone-violet <%= Number(pulse.week) ? '' : 'is-zero' %>"><span class="stat-ico"><%- icon('activity') %></span><div class="label">Last 7 days</div><div class="value"><%= pulse.week %></div><div class="sub"><%= plural(pulse.people, 'person', 'people') %> made changes</div></div>
  <div class="stat tone-green <%= Number(pulse.bookings) ? '' : 'is-zero' %>"><span class="stat-ico"><%- icon('clipboard') %></span><div class="label">Booking changes</div><div class="value"><%= pulse.bookings %></div><div class="sub">this week</div></div>
  <div class="stat tone-amber"><span class="stat-ico"><%- icon('chart') %></span><div class="label">Last 12 weeks</div><div class="value"><%= total84 %></div><div class="sub">on <%= plural(activeDays, 'day') %></div></div>
</div>
<% if (!Number(pulse.week)) { %>
<p class="log-quiet"><%- icon('moon') %><span><b>Quiet week.</b> Nothing has changed in the last 7 days<% if (entries.length && !f.area && !f.role && !f.user && !f.agency && !f.from && !f.to) { %>; the latest change is below, from <%= new Date(String(entries[0].created_at).replace(' ', 'T') + 'Z').toLocaleDateString('en-IN', { day: 'numeric', month: 'long', timeZone: 'Asia/Kolkata' }) %><% } %>.</span></p>
<% } %>

<div class="log-bar">
<% if (busy.length) { %>
<nav class="chips filter-chips log-areas" aria-label="Areas">
  <a class="<%= !f.area ? 'on' : '' %>" href="<%= qs({ area: '', page: '' }) %>"><%- icon('activity') %>All areas</a>
  <% busy.forEach(b => { if (!areas[b.area]) return; %><a class="feed-<%= ar(b.area)[1] %> <%= f.area === b.area ? 'on' : '' %>" href="<%= qs({ area: b.area, page: '' }) %>"><%- icon(ar(b.area)[0]) %><%= areas[b.area] %> <small><%= b.n %></small></a><% }) %>
</nav>
<% } %>
<details class="log-more" <%= f.role || f.user || f.agency || f.from || f.to || f.logins ? 'open' : '' %>>
  <summary class="btn btn-sm"><%- icon('search') %>More filters</summary>
<form class="card log-filter" method="get" style="display:flex;gap:10px;flex-wrap:wrap;align-items:end;padding:14px 16px">
  <div><label for="l-role">Who</label><select id="l-role" name="role"><option value="">Everyone</option><% roles.forEach(r => { %><option value="<%= r %>" <%= r === f.role ? 'selected' : '' %>><%= { backend: 'Backend team', agent: 'Agents', admin: 'Admins' }[r] %></option><% }) %></select></div>
  <div><label for="l-area">Area</label><select id="l-area" name="area"><option value="">All areas</option><% Object.entries(areas).forEach(([k, v]) => { %><option value="<%= k %>" <%= k === f.area ? 'selected' : '' %>><%= v %></option><% }) %></select></div>
  <div><label for="l-user">Staff member</label><select id="l-user" name="user"><option value="">Anyone</option><% users.forEach(u => { %><option value="<%= u.id %>" <%= u.id === f.user ? 'selected' : '' %>><%= u.name %> (<%= u.role === 'admin' ? 'admin' : 'backend' %>)</option><% }) %></select></div>
  <div><label for="l-agency">Agency</label><select id="l-agency" name="agency"><option value="">Any</option><% agencies.forEach(a => { %><option value="<%= a.id %>" <%= a.id === f.agency ? 'selected' : '' %>><%= a.name %></option><% }) %></select></div>
  <div><label for="l-from">From</label><input id="l-from" type="date" name="from" value="<%= f.from %>"></div>
  <div><label for="l-to">To</label><input id="l-to" type="date" name="to" value="<%= f.to %>"></div>
  <label class="check" style="margin-bottom:10px"><input type="checkbox" name="logins" value="1" <%= f.logins ? 'checked' : '' %>> Include logins</label>
  <button class="btn btn-primary">Filter</button>
  <a class="btn btn-ghost" href="/admin/log">Clear</a>
</form>
</details>
</div>
<div class="log-layout">
<div class="card log-card">
  <%- include('../partials/log-feed', { entries }) %>
  <% if (page > 1 || more) { %>
    <div style="display:flex;justify-content:space-between;padding:12px 16px">
      <% if (page > 1) { %><a class="btn btn-sm" href="<%= qs({ page: page - 1 }) %>"><%- icon('arrowLeft') %>Newer</a><% } else { %><span></span><% } %>
      <% if (more) { %><a class="btn btn-sm" href="<%= qs({ page: page + 1 }) %>">Older →</a><% } %>
    </div>
  <% } %>
</div>
<aside class="log-side">
  <div class="card lh-card">
    <h2 class="h3">Last 12 weeks</h2>
    <div class="lh-map">
      <div class="lh-grid" role="img" aria-label="<%= total84 %> changes over the last 12 weeks">
        <div class="lh-days" aria-hidden="true"><span>Mon</span><span></span><span>Wed</span><span></span><span>Fri</span><span></span><span></span></div>
        <% weeks.forEach(w => { %>
          <div class="lh-week"><small aria-hidden="true"><%= monthOf(w) %></small>
            <% w.forEach(c => { %><i class="lh-c lv-<%= c.future ? 'x' : level(c.n) %> <%= c.k === today.toISOString().slice(0, 10) ? 'is-today' : '' %>" title="<%= c.label %>: <%= c.n %> <%= c.n === 1 ? 'change' : 'changes' %>"></i><% }) %>
          </div>
        <% }) %>
      </div>
      <div class="lh-key" aria-hidden="true"><span>Less</span><i class="lh-c lv-0"></i><i class="lh-c lv-1"></i><i class="lh-c lv-2"></i><i class="lh-c lv-3"></i><i class="lh-c lv-4"></i><span>More</span></div>
    </div>
  </div>
  <div class="card">
    <h2 class="h3">Most active, 30 days</h2>
    <% if (!people.length) { %><p class="muted" style="font-size:13px;margin:0">No activity yet.</p><% } %>
    <ol class="log-people">
      <% const top = Math.max(1, ...people.map(p => p.n)); people.forEach(p => { let h = 0; for (const ch of p.name) h = (h * 31 + ch.charCodeAt(0)) % 360; %>
        <li><a href="<%= p.role === 'agent' ? qs({ agency: '', user: '', page: '' }) : qs({ user: p.id, page: '' }) %>">
          <span class="feed-av" style="--h:<%= h %>"><%= p.name.replace(/[(].*[)]/, '').trim().split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase() %></span>
          <span class="lp-name"><b><%= p.name %></b><small><%= { admin: 'Admin', backend: 'Backend team', agent: p.agency || 'Agent' }[p.role] || p.role %></small></span>
          <span class="lp-n"><%= p.n %></span>
        </a><i class="lp-bar" style="width:<%= Math.round(p.n / top * 100) %>%"></i></li>
      <% }) %>
    </ol>
  </div>
  <% if (busy.length) { const topA = Math.max(1, ...busy.map(b => b.n)); %>
  <div class="card">
    <h2 class="h3">By area, 30 days</h2>
    <ul class="log-areas-bars">
      <% busy.forEach(b => { if (!areas[b.area]) return; %><li class="feed-<%= ar(b.area)[1] %>"><a href="<%= qs({ area: b.area, page: '' }) %>"><span class="la-name"><span class="la-ico"><%- icon(ar(b.area)[0]) %></span><%= areas[b.area] %></span><b><%= b.n %></b></a><i style="width:<%= Math.round(b.n / topA * 100) %>%"></i></li><% }) %>
    </ul>
  </div>
  <% } %>
</aside>
</div>
