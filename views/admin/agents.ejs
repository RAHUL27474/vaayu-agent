<div class="page-head"><div><h1>Agents</h1><p>Approve partners, manage KYC, credit and wallets.</p></div></div>
<div class="tabs">
  <% [['', 'All'], ['pending', 'Pending'], ['active', 'Active'], ['suspended', 'Suspended']].forEach(([s, label]) => { %>
    <a href="/admin/agents<%= s ? '?status=' + s : '' %>" class="<%= status === s ? 'active' : '' %>"><%= label %></a>
  <% }) %>
</div>
<div class="card flush">
  <% if (!agents.length) { %><div class="empty"><span class="big"><%- icon('building') %></span><b>No agents here</b><p>Agencies appear here when they sign up.</p></div><% } else { %>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>Agency</th><th>Contact</th><th>Status</th><th>KYC</th><th class="num">Wallet</th><th class="num">Credit</th><th class="num">Bookings</th></tr></thead>
    <% agents.forEach(a => { %>
      <tr class="click" data-href="/admin/agents/<%= a.id %>">
        <td><b><%= a.name %></b><br><small><%= a.city || '' %> · joined <%= fmtDate(a.created_at) %></small></td>
        <td><%= a.contact || '' %><br><small><%= a.email || '' %></small></td>
        <td><span class="badge <%= a.status %>"><%= a.status %></span></td>
        <td><span class="badge <%= a.kyc_status %>"><%= a.kyc_status %></span><br><small><%= a.missing.length ? `Missing ${a.missing.length} item${a.missing.length === 1 ? "" : "s"}` : "Documents complete" %></small></td>
        <td class="num"><%= inr(a.wallet_balance) %></td>
        <td class="num"><%= inr(a.credit_used) %> / <%= inr(a.credit_limit) %></td>
        <td class="num"><%= a.bookings %></td>
      </tr>
    <% }) %>
  </table></div>
  <% } %>
</div>
<%- include('../partials/pager', { pager }) %>
