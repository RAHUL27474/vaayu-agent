<div class="page-head">
  <div><h1>Activities</h1><p>Tours, tickets and experiences at agent net rates. Agents add them to quotes and build their own packages around them.</p></div>
  <a class="btn btn-primary" href="/admin/activities/new">+ New activity</a>
</div>
<form class="card filters" method="get" style="display:flex;gap:10px;flex-wrap:wrap;align-items:end;padding:14px 16px">
  <div><label for="f-city">City</label><select id="f-city" name="city"><option value="">All cities</option><% cities.forEach(c => { %><option <%= c === f.city ? 'selected' : '' %>><%= c %></option><% }) %></select></div>
  <div><label for="f-cat">Category</label><select id="f-cat" name="category"><option value="">All categories</option><% categories.forEach(c => { %><option <%= c === f.category ? 'selected' : '' %>><%= c %></option><% }) %></select></div>
  <div><label for="f-status">Status</label><select id="f-status" name="status"><option value="">Any</option><option value="published" <%= f.status === 'published' ? 'selected' : '' %>>Published</option><option value="draft" <%= f.status === 'draft' ? 'selected' : '' %>>Draft</option></select></div>
  <button class="btn btn-primary">Filter</button>
  <% if (f.city || f.category || f.status) { %><a class="btn btn-ghost" href="/admin/activities">Clear</a><% } %>
</form>
<div class="card flush">
  <% if (!activities.length) { %><div class="empty"><span class="big">🎟</span><b>No activities<%= f.city || f.category || f.status ? ' match these filters' : ' yet' %>.</b><br>Add tours, attraction tickets and experiences with their net price, then publish them for agents.</div><% } else { %>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>Activity</th><th>Category</th><th>Price basis</th><th>Status</th><th class="num">Net pp*</th><th class="num">In packages</th><th class="num">Bookings</th></tr></thead>
    <% activities.forEach(a => { %>
      <tr class="click" data-href="/admin/activities/<%= a.id %>">
        <td style="display:flex;gap:12px;align-items:center"><img src="<%= cover({ image_url: a.image_url, destination: a.city }) %>" alt="" style="width:56px;height:40px;object-fit:cover;border-radius:6px"><div><b><%= a.title %></b><br><small><%= a.city %><%= a.country !== 'India' ? `, ${a.country}` : '' %> · <%= a.duration || '—' %></small></div></td>
        <td><%= a.category %></td>
        <td><%= a.price_basis === 'per_group' ? `Per group of ${a.group_size}` : 'Per person' %></td>
        <td><span class="badge <%= a.status %>"><%= a.status %></span></td>
        <td class="num"><%= inr(a.perPerson) %></td>
        <td class="num"><%= a.packages %></td>
        <td class="num"><%= a.bookings %></td>
      </tr>
    <% }) %>
  </table></div>
  <p class="muted" style="font-size:12.5px;padding:0 16px 12px">* Net per person for two adults. Group prices are split across two guests.</p>
  <% } %>
</div>
