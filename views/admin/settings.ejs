<%
  const labels = {
    company_name: ['Brand name', 'Shown on VaayuTrip\'s B2B invoices to agents'],
    legal_name: ['Legal name', ''],
    gstin: ['GSTIN', ''],
    address: ['Registered address', ''],
    phone: ['Support phone', ''],
    whatsapp: ['WhatsApp number', 'The green WhatsApp button and "Chat on WhatsApp" links open a chat with this number. Empty = 96676 72467.'],
    email: ['Support email', ''],
    booking_approval: ['Bookings need operations approval', 'When on, agents send each quote as a booking request; your backend team confirms availability (Backend → Booking requests) and only then can the agent pay.'],
    gst_enabled: ['Charge GST', 'When off, no GST is added to quotes, bookings or invoices. Invoices already issued keep theirs.'],
    tax_rate: ['GST rate (%)', 'Used when GST is switched on. Tour operator services: 5%.'],
    tcs_rate: ['TCS on overseas tour packages (%)', 'Collected on customer invoices for international packages. Confirm the current rate with your CA.'],
    tier_silver_pct: ['Silver: lower VaayuTrip\'s margin by (%)', "E.g. 1: a 3% hotel margin becomes 2% and a 5% activity margin 4% for Silver agents. A ₹10,000 hotel then costs them ₹10,200 instead of ₹10,300."],
    tier_gold_pct: ['Gold: lower VaayuTrip\'s margin by (%)', "E.g. 2: a 3% hotel margin becomes 1% and a 5% activity margin 3% for Gold agents. A ₹10,000 hotel then costs them ₹10,100 instead of ₹10,300."],
    tier_all: ['Offer for every agent', 'Give all agents Silver or Gold prices for a period (e.g. Christmas). Agents you made Gold keep Gold.'],
    tier_all_label: ['Offer name', 'Shown to agents, e.g. Christmas offer'],
    tier_all_from: ['Offer from', 'First day (empty = from today)'],
    tier_all_to: ['Offer until', 'Last day (empty = until you switch it off)'],
    sac_code: ['SAC code on invoices', 'Services Accounting Code printed on every invoice line. 998552 = tour operator services.'],
    bank_details: ['Bank details for wallet top-ups', 'Shown to agents who top up by bank transfer: bank, account number, IFSC, UPI ID (one per line).'],
  };
%>
<%
  // Settings grouped into sections laid out across the page.
  const SECTIONS = [
    { id: 'bookings', title: 'Bookings & payments', keys: ['booking_approval'], phonepe: true },
    { id: 'tax', title: 'Tax', keys: ['gst_enabled', 'tax_rate', 'tcs_rate', 'sac_code'] },
    { id: 'company', title: 'Company on VaayuTrip invoices', keys: ['company_name', 'legal_name', 'gstin', 'address', 'phone', 'whatsapp', 'email'], wide: true },
    { id: 'topups', title: 'Wallet top-ups by bank transfer', keys: ['bank_details'] },
    { id: 'tiers', title: 'Silver / Gold prices & offers', keys: ['tier_silver_pct', 'tier_gold_pct', 'tier_all', 'tier_all_label', 'tier_all_from', 'tier_all_to'],
      intro: 'Set how much cheaper Silver and Gold are, and optionally give every agent Silver or Gold for a period. To put particular agents on Silver or Gold, use <a href="/admin/tiers">Silver / Gold</a>.' },
  ];
  const field = (k) => {
    const L = labels[k]; if (!L) return '';
    const esc = (v) => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
    const hint = L[1] ? `<div class="hint">${esc(L[1])}</div>` : '';
    const v = esc(values[k] || '');
    if (k === 'booking_approval' || k === 'gst_enabled') {
      const on = k === 'booking_approval' ? values.booking_approval !== '0' : values.gst_enabled === '1';
      return `<div class="field set-wide"><input type="hidden" name="${k}" value="0"><label class="check"><input type="checkbox" name="${k}" value="1" ${on ? 'checked' : ''}> <b>${k === 'booking_approval' ? 'Bookings need operations approval before payment' : 'Charge GST'}</b></label>${hint}</div>`;
    }
    let input;
    if (k === 'tier_all') input = `<select id="tier_all" name="tier_all">${[['none', 'No offer'], ['silver', 'Silver prices for everyone'], ['gold', 'Gold prices for everyone']].map(([o, l]) => `<option value="${o}" ${(values.tier_all || 'none') === o ? 'selected' : ''}>${l}</option>`).join('')}</select>`;
    else if (k === 'tier_all_from' || k === 'tier_all_to') input = `<input id="${k}" type="date" name="${k}" value="${v}">`;
    else if (k === 'bank_details') input = `<textarea id="${k}" name="${k}" rows="5">${v}</textarea>`;
    else input = `<input id="${k}" name="${k}" value="${v}" ${k === 'whatsapp' ? 'placeholder="96676 72467"' : ''} ${['tax_rate', 'tcs_rate', 'tier_silver_pct', 'tier_gold_pct'].includes(k) ? 'type="number" step="0.01" min="0"' : ''}>`;
    const wide = ['address', 'bank_details', 'tier_all_label'].includes(k);
    return `<div class="field${wide ? ' set-wide' : ''}"><label for="${k}">${esc(L[0])}</label>${input}${hint}</div>`;
  };
%>
<div class="page-head"><div><h1>Settings</h1><p>Company details on VaayuTrip's invoices to agents, tax rates, partner tiers and VaayuTrip's margin on inventory.</p></div></div>

<form class="set-form" method="post" action="/admin/settings">
  <nav class="set-nav" aria-label="Settings sections">
    <% SECTIONS.forEach(sec => { %><a href="#set-<%= sec.id %>"><%= sec.title %></a><% }) %><a href="#set-margin">VaayuTrip margin</a>
  </nav>
  <div class="set-grid">
    <% SECTIONS.forEach(sec => { %>
      <section class="card set-card<%= sec.wide ? ' set-span' : '' %>" id="set-<%= sec.id %>" aria-labelledby="set-<%= sec.id %>-h">
        <h2 class="h3" id="set-<%= sec.id %>-h"><%= sec.title %></h2>
        <% if (sec.intro) { %><p class="muted set-intro"><%- sec.intro %></p><% } %>
        <div class="set-fields">
          <% sec.keys.forEach(k => { %><%- field(k) %><% }) %>
        </div>
        <% if (sec.phonepe) { %>
          <div class="set-sub">
            <div class="set-sub-head"><b>Online payments (PhonePe)</b><span class="badge as-is <%= phonepe === 'not set up' ? 'pending' : 'approved' %>"><%= phonepe.charAt(0).toUpperCase() + phonepe.slice(1) %></span></div>
            <p class="muted">Keys are kept in the hosting environment, not here. Webhook URL for the PhonePe dashboard:</p>
            <code class="code-line"><%= origin %>/payments/phonepe/webhook</code>
          </div>
        <% } %>
      </section>
    <% }) %>
    <section class="card set-card set-span" id="set-margin" aria-labelledby="set-margin-h">
      <h2 class="h3" id="set-margin-h">VaayuTrip margin</h2>
      <p class="muted set-intro">Added to what VaayuTrip pays (entered by the backend team) to give the price agents see and pay. Example: a cost of ₹100 with 5% shows agents ₹105. Changing a margin updates agents' prices right away; quotes already made keep theirs.</p>
      <div class="margin-grid">
        <% Object.entries(kinds).forEach(([k, c]) => { %>
          <div class="field">
            <label for="margin_<%= k %>"><%= c.plural %> (%)</label>
            <input id="margin_<%= k %>" name="margin_<%= k %>" type="number" step="0.1" min="0" max="100" value="<%= margins[k] %>">
          </div>
        <% }) %>
      </div>
    </section>
  </div>
  <div class="set-bar"><span class="muted">Changes apply when you save.</span><button class="btn btn-primary btn-lg">Save settings</button></div>
</form>
