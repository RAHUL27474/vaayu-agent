<%
  const labels = {
    company_name: ['Brand name', 'Shown on VaayuTrip\'s B2B invoices to agents'],
    legal_name: ['Legal name', ''],
    gstin: ['GSTIN', ''],
    address: ['Registered address', ''],
    phone: ['Support phone', ''],
    email: ['Support email', ''],
    gst_enabled: ['Charge GST', 'When off, no GST is added to quotes, bookings or invoices. Invoices already issued keep theirs.'],
    tax_rate: ['GST rate (%)', 'Used when GST is switched on. Tour operator services: 5%.'],
    tcs_rate: ['TCS on overseas tour packages (%)', 'Collected on customer invoices for international packages. Confirm the current rate with your CA.'],
    tier_silver_pct: ['Silver partner discount (points)', "Percentage points off VaayuTrip's margin for Silver agencies, e.g. 1 turns a 5% margin into 4%."],
    tier_gold_pct: ['Gold partner discount (points)', "Percentage points off VaayuTrip's margin for Gold agencies, e.g. 2 turns a 5% margin into 3%."],
    sac_code: ['SAC code on invoices', 'Services Accounting Code printed on every invoice line. 998552 = tour operator services.'],
    bank_details: ['Bank details for wallet top-ups', 'Shown to agents who top up by bank transfer: bank, account number, IFSC, UPI ID (one per line).'],
  };
%>
<div class="page-head"><div><h1>Settings</h1><p>Company details on VaayuTrip's invoices to agents, tax rates, partner tiers and VaayuTrip's margin on inventory.</p></div></div>
<div class="card" style="max-width:720px">
  <h3>Online payments (PhonePe)</h3>
  <p style="margin:6px 0"><span class="badge <%= phonepe === 'not set up' ? 'pending' : 'approved' %>"><%= phonepe %></span></p>
  <p class="muted" style="font-size:13px;margin:0">Keys are kept in the hosting environment, not here. Webhook URL for the PhonePe dashboard: <code><%= origin %>/payments/phonepe/webhook</code></p>
</div>
<form class="card" method="post" action="/admin/settings" style="max-width:720px">
  <% keys.filter(k => labels[k]).forEach(k => { %>
    <div class="field">
      <% if (k === 'gst_enabled') { %>
      <input type="hidden" name="gst_enabled" value="0">
      <label class="check"><input type="checkbox" name="gst_enabled" value="1" <%= values.gst_enabled === '1' ? 'checked' : '' %>> <b>Charge GST</b></label>
      <% } else { %><label for="<%= k %>"><%= labels[k][0] %></label><% } %>
      <% if (k === 'gst_enabled') { %>
      <% } else if (k === 'bank_details') { %><textarea id="<%= k %>" name="<%= k %>" rows="4"><%= values[k] || '' %></textarea><% } else { %>
      <input id="<%= k %>" name="<%= k %>" value="<%= values[k] || '' %>" <%= ['tax_rate', 'tcs_rate', 'emi_rate', 'pg_fee_pct', 'tier_silver_pct', 'tier_gold_pct'].includes(k) ? 'type=number step=0.01 min=0' : '' %>><% } %>
      <% if (labels[k][1]) { %><div class="hint"><%= labels[k][1] %></div><% } %>
    </div>
  <% }) %>
  <h3 style="margin-top:24px">VaayuTrip margin</h3>
  <p class="muted" style="font-size:13px;margin-top:-4px">Added to what VaayuTrip pays (entered by the backend team) to give the price agents see and pay. Example: a cost of ₹100 with 5% shows agents ₹105. Changing a margin updates agents' prices right away; quotes already made keep theirs.</p>
  <div class="margin-grid">
    <% Object.entries(kinds).forEach(([k, c]) => { %>
      <div class="field">
        <label for="margin_<%= k %>"><%= c.plural %> (%)</label>
        <input id="margin_<%= k %>" name="margin_<%= k %>" type="number" step="0.1" min="0" max="100" value="<%= margins[k] %>">
      </div>
    <% }) %>
  </div>
  <button class="btn btn-primary">Save settings</button>
</form>
