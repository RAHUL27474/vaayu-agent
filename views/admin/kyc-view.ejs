<%
  const kb = bytes < 1024 * 1024 ? `${Math.max(1, Math.round(bytes / 1024))} KB` : `${(bytes / 1024 / 1024).toFixed(1)} MB`;
%>
<div class="page-head">
  <div>
    <h1><%= label %></h1>
    <p><a href="/admin/agents/<%= agent.id %>#kyc"><%= agent.name %></a> · KYC <%= agent.kyc_status %><% if (exists) { %> · <%= kind === 'pdf' ? 'PDF' : 'Image' %>, <%= kb %><% if (size) { %>, <%= size.width.toLocaleString('en-IN') %> × <%= size.height.toLocaleString('en-IN') %> px<% } %><% } %></p>
  </div>
  <div class="kyc-view-actions">
    <a class="btn" href="/admin/agents/<%= agent.id %>#kyc"><%- icon('arrowLeft') %>Back to agency</a>
    <% if (exists) { %>
      <a class="btn" href="<%= src %>" target="_blank" rel="noopener"><%- icon('external') %>Open original</a>
      <a class="btn btn-primary" href="<%= src %>?download=1"><%- icon('download') %>Download</a>
    <% } %>
  </div>
</div>

<nav class="svc-nav kyc-tabs" aria-label="Documents">
  <% tabs.forEach((t) => { %>
    <a href="/admin/agents/<%= agent.id %>/kyc/<%= t.field %>/view" class="<%= t.field === field ? 'on' : '' %>"<%- t.field === field ? ' aria-current="page"' : '' %>><%- icon(t.field === 'photo' ? 'user' : 'file') %><%= t.label %><% if (!t.have) { %> <span class="badge rejected">missing</span><% } %></a>
  <% }) %>
</nav>

<div class="card kyc-viewer">
  <% if (!exists) { %>
    <div class="empty"><%- icon('inbox') %><p>The agency hasn't uploaded this document yet.</p></div>
  <% } else if (tooLarge) { %>
    <div class="alert warn" style="margin:0"><%- icon('xCircle') %><span>This image is <%= size.width.toLocaleString('en-IN') %> × <%= size.height.toLocaleString('en-IN') %> pixels, too large for a browser to display (it opens as a blank page). Download it to check it, or send the documents back and ask for a normal scan or phone photo.</span></div>
  <% } else if (kind === 'pdf') { %>
    <iframe class="kyc-pdf" src="<%= src %>" title="<%= label %>"></iframe>
  <% } else { %>
    <a href="<%= src %>" target="_blank" rel="noopener" class="kyc-image"><img src="<%= src %>" alt="<%= label %> uploaded by <%= agent.name %>"></a>
  <% } %>
</div>
