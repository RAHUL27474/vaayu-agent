<%# Monthly chart with a view switch (columns / line / table). Locals: bars = [{ label, value, note }], format(value) -> string, id (optional, remembers the viewer's choice) %>
<%
  const max = Math.max(1, ...bars.map(b => b.value));
  const total = bars.reduce((s, b) => s + (b.value || 0), 0);
  const last = bars[bars.length - 1] || { value: 0 }, prev = bars[bars.length - 2] || { value: 0 };
  const change = prev.value > 0 ? Math.round((last.value - prev.value) / prev.value * 100) : null;
  const cid = typeof id !== 'undefined' && id ? id : 'm-' + bars.map(b => b.label).join('').length + '-' + Math.round(total % 997);
  // Line view, drawn on the server so it works without JavaScript too.
  const W = 760, H = 220, pad = 16, n = bars.length;
  const x = (i) => n > 1 ? pad + i * (W - 2 * pad) / (n - 1) : W / 2;
  const y = (v) => H - pad - (v / max) * (H - 2 * pad - 16);
  const pts = bars.map((b, i) => `${x(i).toFixed(1)},${y(b.value).toFixed(1)}`).join(' ');
%>
<div class="chart" data-chart="<%= cid %>" data-view="columns">
  <div class="chart-top">
    <div class="chart-sum"><b><%= format(total) %></b><span>in <%= n %> months<% if (change !== null) { %> · <em class="<%= change >= 0 ? 'up' : 'down' %>"><%= change >= 0 ? '▲' : '▼' %> <%= Math.abs(change) %>%</em> vs last month<% } %></span></div>
    <div class="chart-tools" role="group" aria-label="Chart type">
      <button type="button" data-view-btn="columns" aria-pressed="true" title="Columns"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 14V8M6 14V4M10 14V7M14 14V2"/></svg></button>
      <button type="button" data-view-btn="line" aria-pressed="false" title="Line"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1 12l4-5 4 3 6-7"/></svg></button>
      <button type="button" data-view-btn="table" aria-pressed="false" title="Table"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3h12M2 8h12M2 13h12"/></svg></button>
    </div>
  </div>
  <div class="chart-view" data-view-of="columns">
    <div class="bars" role="img" aria-label="<%= bars.map(b => `${b.label}: ${format(b.value)}`).join(', ') %>">
      <% bars.forEach(b => { %>
        <div class="bar-col" title="<%= b.label %>: <%= format(b.value) %><%= b.note ? ` · ${b.note}` : '' %>">
          <div class="bar-val"><%= b.value ? format(b.value) : '' %></div>
          <div class="bar-track"><div class="bar-fill" style="height:<%= Math.round(b.value / max * 100) %>%"></div></div>
          <div class="bar-label"><%= b.label %></div>
        </div>
      <% }) %>
    </div>
  </div>
  <div class="chart-view" data-view-of="line" hidden>
    <svg class="line-chart" viewBox="0 0 <%= W %> <%= H + 22 %>" role="img" aria-label="<%= bars.map(b => `${b.label}: ${format(b.value)}`).join(', ') %>">
      <% [0.25, 0.5, 0.75, 1].forEach(f => { %><line class="lc-grid" x1="<%= pad %>" x2="<%= W - pad %>" y1="<%= y(max * f) %>" y2="<%= y(max * f) %>"/><% }) %>
      <polygon class="lc-area" points="<%= x(0) %>,<%= H - pad %> <%= pts %> <%= x(n - 1) %>,<%= H - pad %>"/>
      <polyline class="lc-line" points="<%= pts %>"/>
      <% bars.forEach((b, i) => { %>
        <g><title><%= b.label %>: <%= format(b.value) %><%= b.note ? ` · ${b.note}` : '' %></title><circle class="lc-dot" cx="<%= x(i) %>" cy="<%= y(b.value) %>" r="4"/></g>
        <% if (b.value) { %><text class="lc-val" x="<%= x(i) %>" y="<%= y(b.value) - 9 %>"><%= format(b.value) %></text><% } %>
        <text class="lc-lab" x="<%= x(i) %>" y="<%= H + 14 %>"><%= b.label %></text>
      <% }) %>
    </svg>
  </div>
  <div class="chart-view" data-view-of="table" hidden>
    <table class="table chart-table no-stack">
      <thead><tr><th>Month</th><th class="num">Amount</th><th class="num">Share</th></tr></thead>
      <% bars.slice().reverse().forEach(b => { %><tr><td><%= b.label %><% if (b.note) { %> <small class="muted">· <%= b.note %></small><% } %></td><td class="num"><%= format(b.value) %></td><td class="num muted"><%= total ? Math.round(b.value / total * 100) + '%' : '—' %></td></tr><% }) %>
    </table>
  </div>
</div>
