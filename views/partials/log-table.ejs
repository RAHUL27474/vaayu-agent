<%# Activity log rows. Expects: entries (audit_log rows with user_name, agency_name). %>
<%
  const roleBadge = { admin: 'info', backend: 'ok', agent: '', system: '' };
  const roleName = { admin: 'Admin', backend: 'Backend team', agent: 'Agent', system: 'System' };
  const verb = (a) => a.split('.').pop().replace(/_/g, ' ');
  const area = (a) => a.split('.')[0];
%>
<% if (!entries.length) { %><div class="empty">Nothing recorded yet.</div><% } else { %>
<div class="table-wrap"><table class="table" style="margin-top:6px">
  <thead><tr><th>When</th><th>Who</th><th>What</th><th>Details</th></tr></thead>
  <% entries.forEach(l => { %>
    <tr <% if (l.link) { %>class="click" data-href="<%= l.link %>"<% } %>>
      <td style="white-space:nowrap"><small><%= fmtDate(l.created_at) %><br><span class="muted"><%= fmtTime(l.created_at) %></span></small></td>
      <td><b><%= l.user_name || 'System' %></b><br><span class="badge <%= roleBadge[l.role] || '' %>"><%= roleName[l.role] || l.role %></span><% if (l.role === 'agent' && l.agency_name) { %> <small class="muted"><%= l.agency_name %></small><% } %></td>
      <td><span class="muted" style="text-transform:capitalize"><%= area(l.action) %></span> <b><%= verb(l.action) %></b></td>
      <td><%= l.summary || '' %></td>
    </tr>
  <% }) %>
</table></div>
<% } %>
