<footer class="site-footer">
  <div class="inner">
    <div>
      <b style="color:#fff"><%= site.legal_name || site.name %></b>
      <% if (site.address || site.city) { %><div><%= [site.address, site.city].filter(Boolean).join(', ') %></div><% } %>
      <% if (site.gstin) { %><div>GSTIN <%= site.gstin %></div><% } %>
    </div>
    <div>
      <% if (site.phone) { %><div><%= site.phone %></div><% } %>
      <% if (site.email) { %><div><a href="mailto:<%= site.email %>"><%= site.email %></a></div><% } %>
      <div style="margin-top:8px;font-size:12px">© <%= new Date().getFullYear() %> <%= site.name %></div>
    </div>
  </div>
</footer>
