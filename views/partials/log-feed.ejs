<%# Activity log as a day-by-day timeline. Expects: entries (audit_log rows with user_name, agency_name). %>
<%
  const AREA = {
    booking: ['clipboard', 'green', 'Booking'], quote: ['file', 'blue', 'Quote'], product: ['layers', 'teal', 'Inventory'],
    package: ['briefcase', 'teal', 'Package'], agency: ['building', 'violet', 'Agency'], topup: ['topup', 'amber', 'Top-up'],
    wallet: ['wallet', 'amber', 'Wallet'], user: ['user', 'slate', 'User'], offer: ['tag', 'pink', 'Offer'],
    settings: ['settings', 'slate', 'Settings'], ticket: ['message', 'blue', 'Support'], enquiry: ['inbox', 'violet', 'Enquiry'],
  };
  const roleName = { admin: 'Admin', backend: 'Backend team', agent: 'Agent', system: 'System' };
  // "request approved" reads better as "approved request".
  const verb = (a) => { const w = a.split('.').slice(1).join(' ').replace(/_/g, ' ').split(' '); return w.length === 2 && /ed$/.test(w[1]) && !/ed$/.test(w[0]) ? `${w[1]} ${w[0]}` : w.join(' '); };
  const initials = (n) => (n || 'System').replace(/\(.*\)/, '').trim().split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
  const hue = (n) => { let h = 0; for (const ch of String(n || '')) h = (h * 31 + ch.charCodeAt(0)) % 360; return h; };
  const ist = (t) => new Date(String(t).replace(' ', 'T') + 'Z');
  const dayKey = (t) => ist(t).toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });
  const todayKey = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });
  const yKey = new Date(Date.now() - 864e5).toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });
  const dayLabel = (k) => (k === todayKey ? 'Today' : k === yKey ? 'Yesterday' : new Date(k + 'T00:00:00Z').toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }));
  const time = (t) => ist(t).toLocaleTimeString('en-IN', { hour: 'numeric', minute: '2-digit', timeZone: 'Asia/Kolkata' });
  const days = [];
  for (const l of entries) { const k = dayKey(l.created_at); if (!days.length || days[days.length - 1].k !== k) days.push({ k, items: [] }); days[days.length - 1].items.push(l); }
%>
<% if (!entries.length) { %><div class="empty"><span class="big"><%- icon('activity') %></span><strong>Nothing here yet</strong><p>Try a wider date range or clear the filters.</p></div><% } else { %>
<table class="logt">
  <thead><tr><th scope="col">Time</th><th scope="col">Who</th><th scope="col">What happened</th><th scope="col">Details</th></tr></thead>
  <% days.forEach(d => { %>
    <tbody>
      <tr class="logt-day"><th colspan="4" scope="colgroup"><span><%= dayLabel(d.k) %></span><small><%= d.items.length %> <%= d.items.length === 1 ? 'change' : 'changes' %></small></th></tr>
      <% d.items.forEach(l => { const a = AREA[l.action.split('.')[0]] || ['activity', 'slate', l.action.split('.')[0]]; %>
        <tr class="logt-row feed-<%= a[1] %>"<% if (l.link) { %> data-href="<%= l.link %>"<% } %>>
          <td class="logt-time"><time datetime="<%= ist(l.created_at).toISOString() %>"><%= time(l.created_at) %></time></td>
          <td class="logt-who">
            <span class="feed-av" style="--h:<%= hue(l.user_name) %>" aria-hidden="true"><%= initials(l.user_name) %></span>
            <span><b><%= l.user_name || 'System' %></b><small><%= roleName[l.role] || l.role %><%= l.role === 'agent' && l.agency_name ? ` · ${l.agency_name}` : '' %></small></span>
          </td>
          <td class="logt-what"><span class="logt-pill"><%- icon(a[0]) %><%= a[2] %> <%= l.action.split('.').slice(1).join(' ').replace(/_/g, ' ') %></span></td>
          <td class="logt-sum"><% if (l.link) { %><a href="<%= l.link %>"><%= l.summary || 'Open' %></a><% } else { %><%= l.summary || '' %><% } %></td>
        </tr>
      <% }) %>
    </tbody>
  <% }) %>
</table>
<% } %>
