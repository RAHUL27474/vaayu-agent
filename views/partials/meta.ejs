<%#
  Page description and link previews (WhatsApp, Facebook, LinkedIn, X) for public pages.
  Optional locals: meta = { description, image, type }, site (an agency's own website: no VaayuTrip
  branding), noindex (private pages such as shared quotes and payment links).
%>
<%
  const ownSite = typeof site !== 'undefined' && site;
  const m = typeof meta !== 'undefined' && meta ? meta : {};
  const brand = ownSite ? site.name : 'VaayuTrip for Travel Agents';
  const pageTitle = typeof title !== 'undefined' && title ? (ownSite || title.includes(brand) ? title : `${title} · ${brand}`) : brand;
  const description = m.description || (ownSite
    ? (site.website_tagline || `Holidays by ${site.name}`)
    : 'VaayuTrip is the B2B travel platform for Indian travel agents: airfares, hotels, activities, transfers and visas at net rates for Dubai, Bali, Vietnam, Cambodia, the UK and Europe, to build your own packages, with branded invoices and your own website.');
  // Previews need an absolute URL to a PNG/JPG image (SVG isn't shown by WhatsApp).
  const raster = (u) => u && /\.(png|jpe?g|webp)(\?|$)/i.test(u) ? u : null;
  const imageRel = raster(m.image) || (ownSite ? raster(site.logo_path) : null) || (ownSite ? null : '/img/vaayutrip-logo.png');
  const abs = (u) => (/^https?:\/\//i.test(u) ? u : `${origin}${u}`);
%>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= description %>">
  <% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
  <meta property="og:type" content="<%= m.type || 'website' %>">
  <meta property="og:site_name" content="<%= brand %>">
  <meta property="og:title" content="<%= typeof title !== 'undefined' && title ? title : brand %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:url" content="<%= origin %><%= path %>">
  <%
    const agencyLd = (a) => ({ '@type': 'TravelAgency', name: a.name, url: `${origin}/site/${a.slug}`, telephone: a.phone || undefined, email: a.email || undefined, logo: raster(a.logo_path) ? abs(a.logo_path) : undefined, address: a.city ? { '@type': 'PostalAddress', addressLocality: a.city, addressCountry: a.country || 'India' } : undefined });
    let ld = null;
    if (m.ld && m.ld.pkg) {
      const p = m.ld.pkg;
      ld = { '@context': 'https://schema.org', '@type': 'TouristTrip', name: p.title, description, url: `${origin}${path}`,
        image: raster(p.image_url) ? abs(p.image_url) : undefined, touristType: p.theme || undefined,
        itinerary: { '@type': 'Place', name: p.destination },
        provider: agencyLd(site),
        offers: m.ld.price ? { '@type': 'Offer', price: Math.round(m.ld.price), priceCurrency: 'INR', availability: 'https://schema.org/InStock', url: `${origin}${path}`, seller: { '@type': 'TravelAgency', name: site.name } } : undefined };
    } else if (ownSite) {
      ld = { '@context': 'https://schema.org', ...agencyLd(site), description };
    } else if (path === '/') {
      ld = { '@context': 'https://schema.org', '@type': 'Organization', name: settings.company_name || 'VaayuTrip', legalName: settings.legal_name || undefined, url: origin, logo: abs('/img/vaayutrip-logo.png'), email: settings.email || undefined, telephone: settings.phone || undefined, description };
    }
  %>
  <% if (ld) { %><script type="application/ld+json"><%- JSON.stringify(ld).replace(/</g, '\\u003c') %></script><% } %>
  <% if (imageRel) { %><meta property="og:image" content="<%= abs(imageRel) %>">
  <meta name="twitter:card" content="<%= m.image ? 'summary_large_image' : 'summary' %>"><% } %>
