<%# Ranking with a view switch (bars / donut / table). Locals: rows = [{ label, value, sub, href }], format(value) -> string, id (optional) %>
<% const top = Math.max(1, ...rows.map(r => r.value)); %>
<% if (!rows.length) { %><div class="empty">No bookings in this period yet.</div><% } else {
  const total = rows.reduce((s, r) => s + (r.value || 0), 0);
  const pct = (v) => total ? Math.round(v / total * 100) : 0;
  // The design system: navy, teal, sand, then quieter tones.
  const COLORS = ['#14283B', '#3E827D', '#B8A98C', '#5B7189', '#8FC1BB', '#3D5A78', '#8A9A5B', '#9AA3AD'];
  const cid = typeof id !== 'undefined' && id ? id : 'r-' + rows.map(r => r.label).join('').length + '-' + rows.length;
  const R = 54, C = 2 * Math.PI * R;
  let acc = 0;
%>
<div class="chart" data-chart="<%= cid %>" data-view="bars">
  <div class="chart-top">
    <div class="chart-sum"><b><%= format(total) %></b><span><%= rows.length %> <%= rows.length === 1 ? 'item' : 'items' %></span></div>
    <div class="chart-tools" role="group" aria-label="Chart type">
      <button type="button" data-view-btn="bars" aria-pressed="true" title="Bars" aria-label="Show as bars"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3h12M2 8h8M2 13h5"/></svg></button>
      <button type="button" data-view-btn="donut" aria-pressed="false" title="Donut" aria-label="Show as donut"><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5.5"/><path d="M8 2.5V8l4 3.5"/></svg></button>
      <button type="button" data-view-btn="tiles" aria-pressed="false" title="Share boxes" aria-label="Show as share boxes"><svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="2" width="12" height="12" rx="1.5"/><path d="M9 2v12M9 8h5M2 10h7"/></svg></button>
    </div>
  </div>
  <div class="chart-view" data-view-of="bars">
    <ul class="hbars">
      <% rows.forEach(r => { %>
        <li>
          <div class="hb-head"><% if (r.href) { %><a href="<%= r.href %>"><%= r.label %></a><% } else { %><span><%= r.label %></span><% } %><b><%= format(r.value) %> <small class="muted"><%= pct(r.value) %>%</small></b></div>
          <div class="hb-track"><div class="hb-fill" style="width:<%= Math.max(2, Math.round(r.value / top * 100)) %>%"></div></div>
          <% if (r.sub) { %><small class="muted"><%= r.sub %></small><% } %>
        </li>
      <% }) %>
    </ul>
  </div>
  <div class="chart-view" data-view-of="donut" hidden>
    <div class="donut-wrap">
      <svg class="donut" viewBox="0 0 140 140" role="img" aria-label="<%= rows.map(r => `${r.label}: ${pct(r.value)}%`).join(', ') %>">
        <circle cx="70" cy="70" r="<%= R %>" fill="none" stroke="var(--line-2)" stroke-width="18"/>
        <% rows.forEach((r, i) => { const len = total ? r.value / total * C : 0; %>
          <circle cx="70" cy="70" r="<%= R %>" fill="none" stroke="<%= COLORS[i % COLORS.length] %>" stroke-width="18" stroke-dasharray="<%= len.toFixed(2) %> <%= (C - len).toFixed(2) %>" stroke-dashoffset="<%= (-acc).toFixed(2) %>" transform="rotate(-90 70 70)"><title><%= r.label %>: <%= format(r.value) %> (<%= pct(r.value) %>%)</title></circle>
        <% acc += len; }) %>
        <text x="70" y="66" class="donut-total"><%= format(total) %></text>
        <text x="70" y="84" class="donut-cap">total</text>
      </svg>
      <ul class="donut-legend">
        <% rows.forEach((r, i) => { %><li><i style="background:<%= COLORS[i % COLORS.length] %>"></i><span><%= r.label %></span><b><%= pct(r.value) %>%</b></li><% }) %>
      </ul>
    </div>
  </div>
  <%
    // Treemap: split the (largest-first) list into two halves of equal value, along the longer side, recursively.
    const tiles = [];
    const items = rows.map((r, i) => ({ r, i, v: Math.max(r.value || 0, total * 0.004 || 1) }));
    const split = (list, x0, y0, w, h) => {
      if (!list.length) return;
      if (list.length === 1) { tiles.push({ ...list[0], x: x0, y: y0, w, h }); return; }
      const sum = list.reduce((s, t) => s + t.v, 0);
      let k = 0, acc2 = 0;
      while (k < list.length - 1 && acc2 + list[k].v / 2 < sum / 2) acc2 += list[k++].v;
      if (k === 0) { acc2 = list[0].v; k = 1; }
      const f = acc2 / sum;
      if (w * 1.5 >= h) { split(list.slice(0, k), x0, y0, w * f, h); split(list.slice(k), x0 + w * f, y0, w * (1 - f), h); }
      else { split(list.slice(0, k), x0, y0, w, h * f); split(list.slice(k), x0, y0 + h * f, w, h * (1 - f)); }
    };
    split(items, 0, 0, 100, 100);
  %>
  <div class="chart-view" data-view-of="tiles" hidden>
    <div class="treemap" role="img" aria-label="<%= rows.map(r => `${r.label}: ${pct(r.value)}%`).join(', ') %>">
      <% tiles.forEach(t => { const big = t.w >= 30 && t.h >= 26, mid = t.w >= 18 && t.h >= 16; %>
        <<%= t.r.href ? 'a' : 'div' %> class="tm-tile<%= big ? ' big' : mid ? '' : ' tiny' %>"<% if (t.r.href) { %> href="<%= t.r.href %>"<% } %> style="left:<%= t.x.toFixed(2) %>%;top:<%= t.y.toFixed(2) %>%;width:<%= t.w.toFixed(2) %>%;height:<%= t.h.toFixed(2) %>%;--c:<%= COLORS[t.i % COLORS.length] %>" title="<%= t.r.label %>: <%= format(t.r.value) %> (<%= pct(t.r.value) %>%)<%= t.r.sub ? ` · ${t.r.sub}` : '' %>">
          <% if (mid) { %><span class="tm-name"><%= t.r.label %></span><b><%= pct(t.r.value) %>%</b><% if (big) { %><small><%= format(t.r.value) %></small><% } %><% } %>
        </<%= t.r.href ? 'a' : 'div' %>>
      <% }) %>
    </div>
  </div>
</div>
<% } %>
